#!/usr/bin/env -S just -f
# nx-lock: Lock file update commands

export JUST_JUSTFILE := justfile()

commit := "true"
cooldown := "7"

# List all commands
default:
    @just --list

# Update every lock: flake, uv, mise, skills (stops at the first failure)
all: flake uv mise skills

# Update flake.lock with a cooldown: pin each github input to the newest commit
# at least `cooldown` days old (cooldown=0 disables). Auto-commits if changed.
flake:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = ["httpx[socks]>=0.28"]
    # ///
    import base64
    import json
    import os
    import re
    import subprocess
    import sys
    from datetime import UTC, datetime, timedelta
    from pathlib import Path

    import httpx

    flake = Path(os.environ["NH_FLAKE"])
    should_commit = "{{commit}}" == "true"
    cooldown_days = int("{{cooldown}}")

    token = subprocess.run(
        ["gh", "auth", "token"], capture_output=True, text=True
    ).stdout.strip()

    cutoff = (datetime.now(UTC) - timedelta(days=cooldown_days)).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )
    nodes = json.loads((flake / "flake.lock").read_text())["nodes"]
    headers = {"Accept": "application/vnd.github+json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    overrides = []
    if cooldown_days > 0:
        print(f"cooldown: pinning github inputs to newest commit <= {cutoff}")
        with httpx.Client(headers=headers, timeout=30, follow_redirects=True) as client:
            for name, node in nodes["root"]["inputs"].items():
                node_id = node[0] if isinstance(node, list) else node
                original = nodes[node_id].get("original", {})
                if original.get("type") != "github":
                    continue
                if pinned := original.get("rev"):
                    print(f"  {name} -> pinned @ {pinned[:12]}, skipped")
                    continue
                # A version-shaped ref is a release tag, which pins as firmly as
                # a rev; only a branch ref needs resolving to a commit.
                if (tag := original.get("ref")) and re.fullmatch(r"v?\d[\d.]*", tag):
                    print(f"  {name} -> pinned @ {tag}, skipped")
                    continue
                owner, repo = original["owner"], original["repo"]
                params = {"until": cutoff, "per_page": 1}
                if branch := original.get("ref"):
                    params["sha"] = branch
                url = f"https://api.github.com/repos/{owner}/{repo}/commits"
                resp = client.get(url, params=params)
                resp.raise_for_status()
                commits = resp.json()
                if not commits:
                    print(
                        f"  warn: no commit <= cutoff for {name}; leaving at branch HEAD",
                        file=sys.stderr,
                    )
                    continue
                sha = commits[0]["sha"]
                print(f"  {name} -> {owner}/{repo} @ {sha[:12]} ({branch or 'default'})")
                overrides += ["--override-input", name, f"github:{owner}/{repo}/{sha}"]

    # mise ships prebuilt binaries, so packages/mise/default.nix pins a release
    # tag plus a hash per platform rather than a flake input. Forward only: a
    # pin fresher than the cooldown must not be dragged back to an older tag.
    mise_nix = flake / "packages/mise/default.nix"
    mise_text = mise_nix.read_text()
    current = "v" + re.search(r'version = "([^"]+)"', mise_text).group(1)
    resp = httpx.get(
        "https://api.github.com/repos/jdx/mise/releases",
        headers=headers,
        params={"per_page": 100},
        timeout=30,
        follow_redirects=True,
    )
    resp.raise_for_status()
    releases = [r for r in resp.json() if not (r["draft"] or r["prerelease"])]
    tags = [r["tag_name"] for r in releases]
    eligible = [r["tag_name"] for r in releases if r["published_at"] <= cutoff]
    newest = eligible[0] if eligible else None
    if not newest or current not in tags or tags.index(newest) >= tags.index(current):
        print(f"  mise -> {current}, kept")
    else:
        sums = httpx.get(
            f"https://github.com/jdx/mise/releases/download/{newest}/SHASUMS256.txt",
            timeout=30,
            follow_redirects=True,
        )
        sums.raise_for_status()
        digests = {
            name.removeprefix("./"): digest
            for digest, name in (
                line.split() for line in sums.text.splitlines() if line.strip()
            )
        }
        for asset, old in re.findall(
            r'name = "([^"]+)";\s*\n\s*hash = "([^"]+)";', mise_text
        ):
            digest = bytes.fromhex(digests[f"mise-{newest}-{asset}.tar.gz"])
            mise_text = mise_text.replace(
                old, "sha256-" + base64.b64encode(digest).decode()
            )
        mise_text = mise_text.replace(
            f'version = "{current.removeprefix("v")}"',
            f'version = "{newest.removeprefix("v")}"',
        )
        mise_nix.write_text(mise_text)
        print(f"  mise -> jdx/mise @ {newest} (was {current})")

    env = dict(os.environ)
    if token:
        env["NIX_CONFIG"] = f"access-tokens = github.com={token}"
    subprocess.run(
        ["nix", "flake", "update", *overrides, "--flake", str(flake)],
        env=env,
        check=True,
    )

    if should_commit:
        paths = ["flake.lock", "packages/mise/default.nix"]
        clean = subprocess.run(
            ["git", "-C", str(flake), "diff", "--quiet", "--", *paths]
        ).returncode == 0
        if clean:
            print("flake: no changes")
        else:
            date = datetime.now().strftime("%Y-%m-%d")
            subprocess.run(
                ["nx", "git", "commit", f"feat(lock): update @ {date}", *paths],
                check=True,
            )

# Update misepkgs.lock.toml (auto-commits if changed)
mise:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = []
    # ///
    import os
    import re
    import subprocess
    import sys
    import tempfile
    import tomllib
    from datetime import datetime
    from pathlib import Path

    flake = Path(os.environ["NH_FLAKE"])
    should_commit = "{{commit}}" == "true"
    rel = "modules/home/packages/desktop/misepkgs.lock.toml"

    user = os.environ["USER"]
    host = subprocess.run(
        ["hostname"], capture_output=True, text=True, check=True
    ).stdout.strip()
    config_attr = (
        f'homeConfigurations."{user}@{host}"'
        '.config.xdg.configFile."mise/config.toml".source'
    )
    token = subprocess.run(
        ["gh", "auth", "token"], capture_output=True, text=True
    ).stdout.strip()

    # Versions already locked, used to pin any tool that can no longer resolve
    # `@latest` under minimum_release_age (some backends expose no release date,
    # so every version gets hidden by the age filter). Pinning the exact locked
    # version sidesteps the filter; it re-bumps once the backend dates resolve.
    lock_path = flake / rel
    locked = {}
    if lock_path.exists():
        tools = tomllib.loads(lock_path.read_text()).get("tools", {})
        for name, entries in tools.items():
            if isinstance(entries, list) and entries and "version" in entries[0]:
                locked[name] = entries[0]["version"]

    def pin(text, pins):
        for tool, version in pins.items():
            pattern = re.compile(rf'^(\s*"?{re.escape(tool)}"?\s*=\s*)"[^"]*"', re.M)
            text = pattern.sub(lambda m: f'{m.group(1)}"{version}"', text)
        return text

    with tempfile.TemporaryDirectory() as scratch:
        scratch = Path(scratch)
        out = subprocess.run(
            ["nix", "build", "--no-link", "--print-out-paths", f"{flake}#{config_attr}"],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        config_text = Path(out).read_text()
        config = scratch / "config.toml"
        mise_lock = scratch / "mise.lock"

        env = dict(os.environ)
        env["MISE_CONFIG_DIR"] = str(scratch)
        # Generating the lock is the one time enforcement must be off: backend
        # tools (npm, pipx, ...) bootstrap their runtime from the lock being
        # written, so locked=true would reject the not-yet-locked runtime.
        env["MISE_LOCKED"] = "0"
        if token:
            env["MISE_GITHUB_TOKEN"] = token

        pins = {}
        # One pin per tool, so the existing lock size bounds the retries.
        for _ in range(len(locked) + 1):
            config.write_text(pin(config_text, pins))
            config.chmod(0o644)
            mise_lock.unlink(missing_ok=True)
            proc = subprocess.Popen(
                ["mise", "lock", "--global"], env=env, stderr=subprocess.PIPE, text=True
            )
            err = ""
            for line in proc.stderr:
                sys.stderr.write(line)
                err += line
            if proc.wait() == 0:
                break
            match = re.search(r"failed to resolve (\S+)@\S+ for lockfile", err)
            tool = match.group(1) if match else None
            if not tool or tool in pins or tool not in locked:
                raise SystemExit(
                    "mise lock failed" + (f": cannot pin {tool}" if tool else "")
                )
            pins[tool] = locked[tool]
            print(f"pinning unresolvable {tool} -> {locked[tool]} (kept from existing lock)")
        else:
            raise SystemExit("mise lock failed: exhausted pin retries")

        # A tool whose version list fails to resolve is warned about and skipped,
        # not fatal, so the lock can come back complete-looking yet short an entry
        # that `locked = true` then rejects on every later mise call. Re-running
        # merges into the lock just written, so a transient gap closes without
        # redoing the tools that succeeded.
        def gaps():
            want = {
                # mise drops pipx extras: `headroom-ai[all]` locks as `headroom-ai`.
                re.sub(r"\[.*?\]", "", name)
                for name in tomllib.loads(config.read_text()).get("tools", {})
            }
            have = tomllib.loads(mise_lock.read_text()).get("tools", {})
            return sorted(want - set(have))

        for _ in range(2):
            missing = gaps()
            if not missing:
                break
            print(f"lock missing {', '.join(missing)}, re-running mise lock")
            subprocess.run(["mise", "lock", "--global"], env=env, check=True)
        else:
            # Leaves the committed lock untouched, so the missing entry keeps
            # whatever version it already had.
            raise SystemExit(f"mise lock incomplete: {', '.join(gaps())}")

        # Pinning names an exact version in the config, and mise records that
        # as the tool's specifier, which the real config's `latest` no longer
        # matches. Put the original specifier back.
        if pins:
            lock_text = mise_lock.read_text()
            for tool in pins:
                want = re.search(
                    rf'^\s*"?{re.escape(tool)}"?\s*=\s*"([^"]*)"', config_text, re.M
                ).group(1)
                lock_text = re.sub(
                    rf'(\[\[tools\."?{re.escape(tool)}"?\]\]\n(?:(?!\[\[).*\n)*?specifiers = )\[[^\]]*\]',
                    rf'\1["{want}"]',
                    lock_text,
                )
            mise_lock.write_text(lock_text)

        (flake / rel).write_bytes(mise_lock.read_bytes())

    if should_commit:
        clean = subprocess.run(
            ["git", "-C", str(flake), "diff", "--quiet", rel]
        ).returncode == 0
        if clean:
            print(f"{rel}: no changes")
        else:
            date = datetime.now().strftime("%Y-%m-%d")
            subprocess.run(
                ["nx", "git", "commit", f"feat(mise): update misepkgs @ {date}", rel],
                check=True,
            )

# Refresh vendored upstream agent skills (auto-commits if changed)
skills:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = ["httpx>=0.28"]
    # ///
    import os
    import subprocess
    from datetime import datetime
    from pathlib import Path

    import httpx

    flake = Path(os.environ["NH_FLAKE"])
    should_commit = "{{commit}}" == "true"
    plugin = "modules/home/programs/claude/code/plugins/nx/skills"

    # Skills authored upstream and vendored verbatim; local edits are overwritten.
    # Tracking a branch, not a release tag: herdr self-updates past the mise pin.
    skills = {
        "herdr": {
            "url": "https://raw.githubusercontent.com/herdrdev/herdr/master/skills/herdr/SKILL.md",
            "dest": f"{plugin}/herdr/SKILL.md",
        },
    }

    updated = []
    with httpx.Client(timeout=30, follow_redirects=True) as client:
        for name, skill in skills.items():
            dest = flake / skill["dest"]
            dest.parent.mkdir(parents=True, exist_ok=True)
            before = dest.read_text() if dest.exists() else None

            resp = client.get(skill["url"])
            resp.raise_for_status()
            dest.write_text(resp.text)
            # Format now so the vendored copy is already treefmt-stable next refresh.
            subprocess.run(["treefmt", "--quiet", skill["dest"]], cwd=flake, check=True)

            # Dirty against HEAD, not just against this run: an earlier refresh
            # left uncommitted, so it still belongs in the commit below.
            dirty = subprocess.run(
                ["git", "-C", str(flake), "status", "--porcelain", "--", skill["dest"]],
                capture_output=True,
                text=True,
                check=True,
            ).stdout.strip()
            if dest.read_text() != before:
                print(f"  {name}: updated")
            else:
                print(f"  {name}: no changes" + (" (uncommitted)" if dirty else ""))
            if dirty:
                updated.append(name)

    if not updated:
        print("skills: no changes")
    elif should_commit:
        date = datetime.now().strftime("%Y-%m-%d")
        subject = f"{updated[0]} skill" if len(updated) == 1 else "agent skills"
        subprocess.run(
            [
                "nx",
                "git",
                "commit",
                f"feat(claude): update {subject} @ {date}",
                *(skills[n]["dest"] for n in updated),
            ],
            check=True,
        )

# Update uv.lock (auto-commits if changed)
uv:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = []
    # ///
    import os
    import subprocess
    from datetime import datetime
    from pathlib import Path

    flake = Path(os.environ["NH_FLAKE"])
    should_commit = "{{commit}}" == "true"

    subprocess.run(["uv", "lock", "--upgrade"], cwd=flake, check=True)

    if should_commit:
        clean = subprocess.run(
            ["git", "-C", str(flake), "diff", "--quiet", "uv.lock"]
        ).returncode == 0
        if clean:
            print("uv.lock: no changes")
        else:
            date = datetime.now().strftime("%Y-%m-%d")
            subprocess.run(
                ["nx", "git", "commit", f"feat(python): update uv.lock @ {date}", "uv.lock"],
                check=True,
            )
