#!/usr/bin/env -S just -f
# nx-lock: Lock file update commands

export JUST_JUSTFILE := justfile()

commit := "true"
cooldown := "7"

# List all commands
default:
    @just --list

# Update every lock: flake, uv, mise, skills (stops at the first failure)
all: flake uv mise skills

# Update flake.lock with a cooldown: pin each github input to the newest commit
# at least `cooldown` days old (cooldown=0 disables). Auto-commits if changed.
flake:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = ["httpx[socks]>=0.28"]
    # ///
    import base64
    import json
    import os
    import re
    import subprocess
    import sys
    from datetime import UTC, datetime, timedelta
    from pathlib import Path

    import httpx

    flake = Path(os.environ["NH_FLAKE"])
    should_commit = "{{commit}}" == "true"
    cooldown_days = int("{{cooldown}}")

    token = subprocess.run(
        ["gh", "auth", "token"], capture_output=True, text=True
    ).stdout.strip()

    cutoff = (datetime.now(UTC) - timedelta(days=cooldown_days)).strftime(
        "%Y-%m-%dT%H:%M:%SZ"
    )
    nodes = json.loads((flake / "flake.lock").read_text())["nodes"]
    headers = {"Accept": "application/vnd.github+json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    overrides = []
    if cooldown_days > 0:
        print(f"cooldown: pinning github inputs to newest commit <= {cutoff}")
        with httpx.Client(headers=headers, timeout=30, follow_redirects=True) as client:
            for name, node in nodes["root"]["inputs"].items():
                node_id = node[0] if isinstance(node, list) else node
                original = nodes[node_id].get("original", {})
                if original.get("type") != "github":
                    continue
                if pinned := original.get("rev"):
                    print(f"  {name} -> pinned @ {pinned[:12]}, skipped")
                    continue
                # A version-shaped ref is a release tag, which pins as firmly as
                # a rev; only a branch ref needs resolving to a commit.
                if (tag := original.get("ref")) and re.fullmatch(r"v?\d[\d.]*", tag):
                    print(f"  {name} -> pinned @ {tag}, skipped")
                    continue
                owner, repo = original["owner"], original["repo"]
                params = {"until": cutoff, "per_page": 1}
                if branch := original.get("ref"):
                    params["sha"] = branch
                url = f"https://api.github.com/repos/{owner}/{repo}/commits"
                resp = client.get(url, params=params)
                resp.raise_for_status()
                commits = resp.json()
                if not commits:
                    print(
                        f"  warn: no commit <= cutoff for {name}; leaving at branch HEAD",
                        file=sys.stderr,
                    )
                    continue
                sha = commits[0]["sha"]
                print(f"  {name} -> {owner}/{repo} @ {sha[:12]} ({branch or 'default'})")
                overrides += ["--override-input", name, f"github:{owner}/{repo}/{sha}"]

    mise_nix = flake / "packages/mise/default.nix"
    mise_text = mise_nix.read_text()
    current = "v" + re.search(r'version = "([^"]+)"', mise_text).group(1)
    resp = httpx.get(
        "https://api.github.com/repos/jdx/mise/releases",
        headers=headers,
        params={"per_page": 100},
        timeout=30,
        follow_redirects=True,
    )
    resp.raise_for_status()
    releases = [r for r in resp.json() if not (r["draft"] or r["prerelease"])]
    tags = [r["tag_name"] for r in releases]
    newest = tags[0] if tags else None
    if not newest or current not in tags or tags.index(newest) >= tags.index(current):
        print(f"  mise -> {current}, kept")
    else:
        sums = httpx.get(
            f"https://github.com/jdx/mise/releases/download/{newest}/SHASUMS256.txt",
            timeout=30,
            follow_redirects=True,
        )
        sums.raise_for_status()
        digests = {
            name.removeprefix("./"): digest
            for digest, name in (
                line.split() for line in sums.text.splitlines() if line.strip()
            )
        }
        for asset, old in re.findall(
            r'name = "([^"]+)";\s*\n\s*hash = "([^"]+)";', mise_text
        ):
            digest = bytes.fromhex(digests[f"mise-{newest}-{asset}.tar.gz"])
            mise_text = mise_text.replace(
                old, "sha256-" + base64.b64encode(digest).decode()
            )
        mise_text = mise_text.replace(
            f'version = "{current.removeprefix("v")}"',
            f'version = "{newest.removeprefix("v")}"',
        )
        mise_nix.write_text(mise_text)
        print(f"  mise -> jdx/mise @ {newest} (was {current})")

    env = dict(os.environ)
    if token:
        env["NIX_CONFIG"] = f"access-tokens = github.com={token}"
    subprocess.run(
        ["nix", "flake", "update", *overrides, "--flake", str(flake)],
        env=env,
        check=True,
    )

    if should_commit:
        paths = ["flake.lock", "packages/mise/default.nix"]
        clean = subprocess.run(
            ["git", "-C", str(flake), "diff", "--quiet", "--", *paths]
        ).returncode == 0
        if clean:
            print("flake: no changes")
        else:
            date = datetime.now().strftime("%Y-%m-%d")
            subprocess.run(
                ["nx", "git", "commit", f"feat(lock): update @ {date}", *paths],
                check=True,
            )

# Update mise lockfiles across the flake, or only the named tools (auto-commits if changed)
mise *tools:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = [
    #   "pydantic>=2",
    #   "tomlkit>=0.13",
    # ]
    # ///
    import os
    import re
    import shutil
    import subprocess
    import sys
    import tempfile
    import tomllib
    from datetime import datetime
    from pathlib import Path

    import tomlkit
    from pydantic import BaseModel, Field, TypeAdapter


    class NixConfig(BaseModel):
        root: Path
        configurations: dict[str, list[Path]]


    class ConfigFile(BaseModel):
        path: Path
        text: str
        tools: list[str] = Field(default_factory=list)


    class MiseConfig(BaseModel):
        path: Path
        tools: list[str]


    def read_bytes(path):
        return path.read_bytes() if path.exists() else None


    def tool_name(key):
        return re.sub(r"\[.*?\]", "", key)


    def short_name(tool):
        return tool.split(":", 1)[-1].rsplit("/", 1)[-1]


    def select(requests, declared):
        selected = set()
        for request in requests:
            matches = {tool for tool in declared if request in (tool, short_name(tool))}
            if not matches:
                raise SystemExit(f"no mise tool matches {request}")
            if len(matches) > 1:
                raise SystemExit(f"{request} is ambiguous: {', '.join(sorted(matches))}")
            selected |= matches
        return selected


    def collect(flake, config):
        sources = {}
        contexts = {}
        jobs = {}
        for profile, paths in config.configurations.items():
            files = {}
            for source in paths:
                if not source.is_relative_to(config.root) or source.suffix != ".toml":
                    raise SystemExit(f"config must be a TOML file in this flake: {source}")
                path = (flake / source.relative_to(config.root)).resolve(strict=True)
                if not path.is_relative_to(flake):
                    raise SystemExit(f"config escapes the flake: {source}")
                if path not in sources:
                    text = path.read_bytes().decode()
                    sources[path] = ConfigFile(
                        path=path,
                        text=text,
                        tools=list(tomllib.loads(text).get("tools", {})),
                    )
                if source.name in files and files[source.name].path != path:
                    raise SystemExit(f"duplicate config name in {profile}: {source.name}")
                files[source.name] = sources[path]
            settings = {name: source for name, source in files.items() if not source.tools}
            for name, source in files.items():
                if not source.tools:
                    continue
                target = source.path.with_suffix(".lock").resolve()
                if not target.is_relative_to(flake):
                    raise SystemExit(f"invalid lock target: {target}")
                job = dict(sorted({**settings, name: source}.items()))
                context = tuple((name, file.path) for name, file in job.items())
                if target in contexts and contexts[target] != context:
                    raise SystemExit(f"conflicting settings for {target} in {profile}")
                contexts[target] = context
                jobs[target] = job
        return sources, dict(sorted(jobs.items()))


    def write_atomic(path, data):
        with tempfile.NamedTemporaryFile(
            dir=path.parent, prefix=".nx-mise-", delete=False
        ) as tmp:
            temporary = Path(tmp.name)
            try:
                tmp.write(data)
                tmp.flush()
                temporary.chmod(path.stat().st_mode & 0o777 if path.exists() else 0o644)
                os.replace(temporary, path)
            finally:
                temporary.unlink(missing_ok=True)


    SIDECAR_ROOT = ".mise/locks"


    def sidecar_dir(target):
        return target.with_suffix(".lock.d")


    def read_tree(root):
        if not root.is_dir():
            return {}
        return {
            path.relative_to(root).as_posix(): path.read_bytes()
            for path in sorted(root.rglob("*"))
            if path.is_file()
        }


    def write_tree(root, tree):
        staging = Path(tempfile.mkdtemp(dir=root.parent, prefix=".nx-mise-"))
        try:
            for name, data in tree.items():
                path = staging / name
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(data)
            if root.exists():
                retired = Path(tempfile.mkdtemp(dir=root.parent, prefix=".nx-mise-"))
                os.replace(root, retired / root.name)
                shutil.rmtree(retired)
            if tree:
                os.replace(staging, root)
        finally:
            shutil.rmtree(staging, ignore_errors=True)


    def referenced_sidecars(document):
        for entries in document.get("tools", {}).values():
            for entry in entries:
                for value in entry.values():
                    if isinstance(value, dict) and "path" in value:
                        path = str(value["path"])
                        if not path.startswith(SIDECAR_ROOT + "/"):
                            raise SystemExit(f"unexpected sidecar path: {path}")
                        yield path.removeprefix(SIDECAR_ROOT + "/")


    def generate(target, files, before, before_tree, scratch, selected):
        fragments = scratch / "conf.d"
        fragments.mkdir()
        for name, data in before_tree.items():
            path = scratch / SIDECAR_ROOT / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
        for name, source in files.items():
            (fragments / name).write_text(source.text)
        (scratch / "miserc.toml").write_text("env_conf_d = true\n")
        env = {
            key: value for key, value in os.environ.items() if not key.startswith("MISE_")
        }
        env.update(
            MISE_CONFIG_DIR=str(scratch),
            MISE_SYSTEM_CONFIG_DIR=str(scratch / "system"),
            MISE_STATE_DIR=str(scratch / "state"),
            MISE_LOCKED="0",
        )
        token = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True)
        if token.returncode == 0:
            env["MISE_GITHUB_TOKEN"] = token.stdout.strip()

        listing = subprocess.run(
            ["mise", "config", "ls", "--json"],
            cwd=scratch,
            env=env,
            stdout=subprocess.PIPE,
            text=True,
            check=True,
        ).stdout
        owners = {}
        for entry in TypeAdapter(list[MiseConfig]).validate_json(listing):
            if entry.path.parent != fragments or entry.path.name not in files:
                raise SystemExit(f"unexpected mise configuration: {entry.path}")
            for tool in entry.tools:
                if tool in owners:
                    raise SystemExit(f"tool declared in multiple config files: {tool}")
                owners[tool] = entry.path.name
        if not owners:
            return None, {}

        baseline = {}
        if before is not None:
            baseline = tomllib.loads(before.decode())
            baseline["tools"] = {
                tool: entries
                for tool, entries in baseline.get("tools", {}).items()
                if tool in owners
            }

        mise_lock = scratch / "mise.lock"
        pins = {}
        locked = baseline.get("tools", {})
        for _ in range(len(locked) + 1):
            if baseline:
                mise_lock.write_text(tomlkit.dumps(baseline))
            else:
                mise_lock.unlink(missing_ok=True)
            proc = subprocess.Popen(
                ["mise", "lock", "--global", "--bump", *sorted(selected)]
                if selected
                else ["mise", "lock", "--global", "--bump", "--upgrade"],
                cwd=scratch,
                env=env,
                stderr=subprocess.PIPE,
                text=True,
            )
            err = ""
            for line in proc.stderr:
                sys.stderr.write(line)
                err += line
            if proc.wait() == 0:
                generated = tomllib.loads(mise_lock.read_text())
                tool = next(
                    (
                        name
                        for name, entries in generated.get("tools", {}).items()
                        if any(entry.get("version") == "latest" for entry in entries)
                    ),
                    None,
                )
                if tool is None:
                    break
            else:
                match = re.search(
                    r"failed to resolve (\S+)@\S+ for "
                    r"(?:lockfile\b|\S+; refusing to replace locked version\(s\))",
                    err,
                )
                tool = match.group(1) if match else None
            if not tool or tool in pins or tool not in locked or tool not in owners:
                raise SystemExit(
                    "mise lock failed" + (f": cannot pin {tool}" if tool else "")
                )
            config = fragments / owners[tool]
            document = tomlkit.parse(config.read_text())
            requests = document.get("tools", {})
            keys = [key for key in requests if re.sub(r"\[.*?\]", "", key) == tool]
            versions = {entry["version"] for entry in locked[tool]}
            if (
                len(keys) != 1
                or len(versions) != 1
                or "latest" in versions
                or not isinstance(requests[keys[0]], str)
            ):
                raise SystemExit(f"mise lock failed: cannot safely pin {tool}")
            pins[tool] = str(requests[keys[0]])
            version = versions.pop()
            requests[keys[0]] = version
            config.write_text(tomlkit.dumps(document))
            print(f"pinning unresolvable {tool} -> {version} (kept from existing lock)")
        else:
            raise SystemExit("mise lock failed: exhausted pin retries")

        for attempt in range(3):
            document = tomlkit.parse(mise_lock.read_text())
            missing = sorted(
                tool
                for tool in selected or owners
                if not document.get("tools", {}).get(tool)
            )
            if not missing:
                break
            if attempt == 2:
                raise SystemExit(f"mise lock incomplete: {', '.join(missing)}")
            print(f"lock missing {', '.join(missing)}, re-running mise lock")
            subprocess.run(
                ["mise", "lock", "--global", *missing], cwd=scratch, env=env, check=True
            )

        if selected is not None:
            original = tomlkit.parse(before.decode()) if before is not None else {}
            previous = original.get("tools", {})
            tools = document.setdefault("tools", tomlkit.table())
            for tool in [tool for tool in tools if tool not in selected]:
                if tool in previous:
                    tools[tool] = previous[tool]
                else:
                    del tools[tool]
            for tool in previous:
                if tool not in selected and tool in owners and tool not in tools:
                    tools[tool] = previous[tool]

        if before is not None and document.get("lockfile_version", 0) < baseline.get(
            "lockfile_version", 0
        ):
            raise SystemExit(f"mise lock downgraded the lockfile format: {target}")
        extra = set(document.get("tools", {})) - owners.keys()
        if extra:
            raise SystemExit(
                f"lock contains tools without config declarations: {', '.join(sorted(extra))}"
            )
        for tool, request in pins.items():
            for entry in document["tools"][tool]:
                if "specifiers" in entry:
                    entry["specifiers"] = [request]

        kept = set()
        for tool, entries in document.get("tools", {}).items():
            previous = baseline.get("tools", {}).get(tool, [])
            for entry in entries:
                for key, value in list(entry.items()):
                    if not isinstance(value, dict) or "path" not in value:
                        continue
                    prefix = str(value["path"]).removeprefix(SIDECAR_ROOT + "/")
                    old = next(
                        (
                            item[key]
                            for item in previous
                            if item.get("version") == entry.get("version")
                            and isinstance(item.get(key), dict)
                            and item[key].get("path") == value["path"]
                        ),
                        None,
                    )
                    if old and any(name.startswith(prefix + "/") for name in before_tree):
                        if dict(value) != old:
                            for name in [name for name in value if name not in old]:
                                del value[name]
                            value.update(old)
                        kept.add(prefix)

        data = tomlkit.dumps(document).encode()
        parsed = tomllib.loads(data.decode())
        for tool, entries in parsed["tools"].items():
            if (
                not isinstance(entries, list)
                or not entries
                or any(
                    not entry.get("version") or entry["version"] == "latest"
                    for entry in entries
                )
            ):
                raise SystemExit(f"invalid lock entries for {tool}")

        generated_tree = read_tree(scratch / SIDECAR_ROOT)
        tree = {}
        for prefix in referenced_sidecars(parsed):
            found = {
                name: blob
                for name, blob in (before_tree if prefix in kept else generated_tree).items()
                if name.startswith(prefix + "/")
            }
            if not found:
                raise SystemExit(f"mise lock did not write sidecar {prefix} for {target}")
            tree.update(found)
        if before is None or tomllib.loads(before.decode()) != parsed:
            return data, tree
        return None, tree


    flake = Path(os.environ["NH_FLAKE"]).expanduser().resolve(strict=True)
    nix_env = dict(
        os.environ,
        NX_LOCK_FLAKE=f"git+file://{flake}",
    )
    expression = """
        let
          flake = builtins.getFlake (builtins.getEnv "NX_LOCK_FLAKE");
          collect = kind:
            let configurations = flake.${kind} or {};
            in builtins.listToAttrs (builtins.concatMap
              (name:
                let cfg = configurations.${name}.config.programs.mise or {};
                in if cfg.enable or false then [{
                  name = "${kind}.${name}";
                  value = cfg.configFiles;
                }] else [])
              (builtins.attrNames configurations));
        in {
          root = flake.outPath;
          configurations = collect "homeConfigurations"
            // collect "nixosConfigurations"
            // collect "darwinConfigurations";
        }
    """
    result = subprocess.run(
        ["nix", "eval", "--impure", "--json", "--expr", expression],
        env=nix_env,
        stdout=subprocess.PIPE,
        text=True,
        check=True,
    )
    config = NixConfig.model_validate_json(result.stdout)
    sources, jobs = collect(flake, config)
    if not jobs:
        print("mise: no tool configuration files")
        raise SystemExit(0)
    requests = "{{tools}}".split()
    selections = {target: None for target in jobs}
    if requests:
        declared = {
            target: {tool_name(tool) for source in files.values() for tool in source.tools}
            for target, files in jobs.items()
        }
        selected = select(requests, set().union(*declared.values()))
        selections = {
            target: tools & selected
            for target, tools in declared.items()
            if tools & selected
        }
        jobs = {target: jobs[target] for target in selections}
    originals = {target: read_bytes(target) for target in jobs}
    original_trees = {target: read_tree(sidecar_dir(target)) for target in jobs}
    updates = {}
    tree_updates = {}
    with tempfile.TemporaryDirectory() as scratch:
        for index, (target, files) in enumerate(jobs.items()):
            print(f"locking {target.relative_to(flake)}", flush=True)
            directory = Path(scratch) / str(index)
            directory.mkdir()
            data, tree = generate(
                target,
                files,
                originals[target],
                original_trees[target],
                directory,
                selections[target],
            )
            if data is not None:
                updates[target] = data
            if tree != original_trees[target]:
                tree_updates[target] = tree
    for source in sources.values():
        if source.path.read_bytes() != source.text.encode():
            raise SystemExit(f"configuration changed during lock generation: {source.path}")
    for target, before in originals.items():
        if read_bytes(target) != before:
            raise SystemExit(f"lock changed during generation: {target}")
        if read_tree(sidecar_dir(target)) != original_trees[target]:
            raise SystemExit(f"sidecars changed during generation: {sidecar_dir(target)}")
    if not updates and not tree_updates:
        print("mise: no changes")
    for target, tree in tree_updates.items():
        write_tree(sidecar_dir(target), tree)
        print(f"updated {sidecar_dir(target).relative_to(flake)}")
    for path, data in updates.items():
        write_atomic(path, data)
        print(f"updated {path.relative_to(flake)}")
    if "{{commit}}" == "true":
        paths = [
            str(path.relative_to(flake))
            for target in jobs
            for path in (target, sidecar_dir(target))
        ]
        if paths:
            changed = set()
            for args in (
                ["diff", "--name-only", "-z", "HEAD"],
                ["ls-files", "--others", "--exclude-standard", "-z"],
            ):
                output = subprocess.run(
                    ["git", *args, "--", *paths],
                    cwd=flake,
                    stdout=subprocess.PIPE,
                    text=True,
                    check=True,
                ).stdout
                changed.update(filter(None, output.split("\0")))
            if changed:
                date = datetime.now().strftime("%Y-%m-%d")
                subject = (
                    ", ".join(sorted({short_name(tool) for tool in selected}))
                    if requests
                    else "misepkgs"
                )
                subprocess.run(
                    [
                        "nx",
                        "git",
                        "commit",
                        f"feat(mise): update {subject} @ {date}",
                        *sorted(changed),
                    ],
                    cwd=flake,
                    check=True,
                )

# Refresh vendored upstream agent skills (auto-commits if changed)
skills:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = ["httpx>=0.28"]
    # ///
    import os
    import subprocess
    from datetime import datetime
    from pathlib import Path

    import httpx

    flake = Path(os.environ["NH_FLAKE"])
    should_commit = "{{commit}}" == "true"
    plugin = "modules/home/programs/claude/code/plugins/nx/skills"

    # Skills authored upstream and vendored verbatim; local edits are overwritten.
    skills = {
        "tsk-cli": {
            "url": "https://raw.githubusercontent.com/smarzban/tsk/main/skills/tsk-cli/SKILL.md",
            "dest": f"{plugin}/tsk-cli/SKILL.md",
        },
    }

    updated = []
    with httpx.Client(timeout=30, follow_redirects=True) as client:
        for name, skill in skills.items():
            dest = flake / skill["dest"]
            dest.parent.mkdir(parents=True, exist_ok=True)
            before = dest.read_text() if dest.exists() else None

            resp = client.get(skill["url"])
            resp.raise_for_status()
            dest.write_text(resp.text)
            # Format now so the vendored copy is already treefmt-stable next refresh.
            subprocess.run(["treefmt", "--quiet", skill["dest"]], cwd=flake, check=True)

            # Dirty against HEAD, not just against this run: an earlier refresh
            # left uncommitted, so it still belongs in the commit below.
            dirty = subprocess.run(
                ["git", "-C", str(flake), "status", "--porcelain", "--", skill["dest"]],
                capture_output=True,
                text=True,
                check=True,
            ).stdout.strip()
            if dest.read_text() != before:
                print(f"  {name}: updated")
            else:
                print(f"  {name}: no changes" + (" (uncommitted)" if dirty else ""))
            if dirty:
                updated.append(name)

    if not updated:
        print("skills: no changes")
    elif should_commit:
        date = datetime.now().strftime("%Y-%m-%d")
        subject = f"{updated[0]} skill" if len(updated) == 1 else "agent skills"
        subprocess.run(
            [
                "nx",
                "git",
                "commit",
                f"feat(claude): update {subject} @ {date}",
                *(skills[n]["dest"] for n in updated),
            ],
            check=True,
        )

# Update uv.lock (auto-commits if changed)
uv:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.14"
    # dependencies = []
    # ///
    import os
    import subprocess
    from datetime import datetime
    from pathlib import Path

    flake = Path(os.environ["NH_FLAKE"])
    should_commit = "{{commit}}" == "true"

    subprocess.run(["uv", "lock", "--upgrade"], cwd=flake, check=True)

    if should_commit:
        clean = subprocess.run(
            ["git", "-C", str(flake), "diff", "--quiet", "uv.lock"]
        ).returncode == 0
        if clean:
            print("uv.lock: no changes")
        else:
            date = datetime.now().strftime("%Y-%m-%d")
            subprocess.run(
                ["nx", "git", "commit", f"feat(python): update uv.lock @ {date}", "uv.lock"],
                check=True,
            )
