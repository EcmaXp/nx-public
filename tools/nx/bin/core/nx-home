#!/usr/bin/env -S just -f
# nx-home: Home Manager management

export JUST_JUSTFILE := justfile()

# List all commands
default:
    @just --list

# Build home configuration
build *args:
    nh home build --no-nom -c "$USER@${NX_HOST:-$(cat ~/.nx/host 2>/dev/null || hostname)}" {{args}}

# Switch to new home configuration
switch *args:
    nh home switch --no-nom -c "$USER@${NX_HOST:-$(cat ~/.nx/host 2>/dev/null || hostname)}" {{args}}
