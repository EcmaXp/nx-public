#!/usr/bin/env -S just -f
# nx-os: NixOS/Darwin/system-manager system management

export JUST_JUSTFILE := justfile()

# List all commands
default:
    @just --list

# Build system configuration
build *args:
    #!/usr/bin/env fish
    if test -e /etc/NIXOS
        nh os build --no-nom {{args}}
    else if test (uname) = "Linux"
        just _system-manager build {{args}}
    else
        nh darwin build --no-nom {{args}}
    end

# Switch to new system configuration
switch *args:
    #!/usr/bin/env fish
    if test -e /etc/NIXOS
        nh os switch --no-nom {{args}}
    else if test (uname) = "Linux"
        just _system-manager switch --sudo {{args}}
    else
        nh darwin switch --no-nom {{args}}
    end

# Test system configuration
test *args:
    #!/usr/bin/env fish
    if test -e /etc/NIXOS
        nh os test --no-nom {{args}}
    else if test (uname) = "Linux"
        set out (just _system-manager build {{args}} | tail -n1)
        test -x "$out/bin/activate"; or exit 1
        sudo "$out/bin/activate" --ephemeral
    else
        nh darwin test --no-nom {{args}}
    end

[private]
_system-manager verb *args:
    nix run "$NH_FLAKE#system-manager" -- {{verb}} --flake "$NH_FLAKE#${NX_HOST:-$(cat ~/.nx/host 2>/dev/null || hostname)}" {{args}}
