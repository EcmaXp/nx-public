--- a/crates/system-manager-engine/src/lib.rs
+++ b/crates/system-manager-engine/src/lib.rs
@@ -4,7 +4,7 @@ pub mod register;
 mod systemd;
 pub mod unit_info;
 
-use anyhow::Result;
+use anyhow::{Context, Result};
 use serde::{Deserialize, Serialize};
 use std::borrow::Cow;
 use std::os::unix;
@@ -155,3 +155,39 @@ pub fn etc_dir(ephemeral: bool) -> PathBuf {
         PathBuf::from("/etc")
     }
 }
+
+// Never replaced: systemctl needs /run/systemd/system to be a directory.
+const EPHEMERAL_RUNTIME_DIRS: [&str; 8] = [
+    "systemd/system",
+    "systemd/user",
+    "systemd/network",
+    "tmpfiles.d",
+    "sysctl.d",
+    "modules-load.d",
+    "binfmt.d",
+    "udev/rules.d",
+];
+
+pub fn etc_target(etc_dir: &Path, rel: &Path) -> PathBuf {
+    if etc_dir == self::etc_dir(true)
+        && EPHEMERAL_RUNTIME_DIRS
+            .iter()
+            .any(|dir| rel.starts_with(dir))
+    {
+        Path::new("/run").join(rel)
+    } else {
+        etc_dir.join(rel)
+    }
+}
+
+pub fn ensure_ephemeral_runtime_dirs() -> Result<()> {
+    for dir in EPHEMERAL_RUNTIME_DIRS {
+        let dir = Path::new("/run").join(dir);
+        if dir.is_symlink() {
+            remove_link(&dir).with_context(|| format!("Error while removing {}", dir.display()))?;
+        }
+        fs::create_dir_all(&dir)
+            .with_context(|| format!("Error while creating {}", dir.display()))?;
+    }
+    Ok(())
+}
diff --git a/testFlake/container-tests/check-ephemeral-flag.nix b/testFlake/container-tests/check-ephemeral-flag.nix
new file mode 100644
index 0000000..9bcf63e
--- /dev/null
+++ b/testFlake/container-tests/check-ephemeral-flag.nix
@@ -0,0 +1,62 @@
+{
+  forEachDistro,
+  ...
+}:
+
+forEachDistro "check-ephemeral-flag" {
+  modules = [
+    {
+      environment.etc = {
+        "a/bar" = {
+          text = "bar";
+          mode = "0700";
+          user = "root";
+          group = "root";
+        };
+      };
+      systemd.tmpfiles.rules = [ "d /run/ephemeral-test 0755 root root -" ];
+      systemd.services.ephemeral-test = {
+        wantedBy = [ "system-manager.target" ];
+        serviceConfig = {
+          Type = "oneshot";
+          RemainAfterExit = true;
+        };
+        script = "true";
+      };
+    }
+  ];
+  testScriptFunction =
+    { toplevel, ... }:
+    ''
+      start_all()
+      machine.wait_for_unit("multi-user.target")
+
+      def activate_ephemeral():
+          logs = machine.succeed("${toplevel}/bin/activate --ephemeral 2>&1")
+          for line in logs.split("\n"):
+              assert "ERROR" not in line, line
+          machine.wait_for_unit("system-manager.target")
+
+      machine.succeed("printf '[Service]\\nExecStart=/bin/true\\n' > /run/systemd/system/sentinel.service")
+
+      with subtest("ephemeral activation stays under /run"):
+          activate_ephemeral()
+          assert machine.file("/run/etc/a/bar").contains("bar")
+          machine.fail("test -e /etc/a/bar")
+          machine.succeed("test -L /run/systemd/system/ephemeral-test.service")
+          machine.fail("test -e /etc/systemd/system/ephemeral-test.service")
+          machine.succeed("systemctl is-active ephemeral-test.service")
+          machine.succeed("test -d /run/ephemeral-test")
+
+      with subtest("existing runtime units are kept"):
+          machine.succeed("test -d /run/systemd/system -a ! -L /run/systemd/system")
+          machine.succeed("test -f /run/systemd/system/sentinel.service")
+          machine.succeed("systemctl list-units --no-pager")
+
+      with subtest("a runtime unit dir symlink left by older versions is healed"):
+          machine.succeed("mkdir -p /run/etc/systemd && rm -rf /run/etc/systemd/system && mv /run/systemd/system /run/etc/systemd/system && ln -s /run/etc/systemd/system /run/systemd/system")
+          activate_ephemeral()
+          machine.succeed("test -d /run/systemd/system -a ! -L /run/systemd/system")
+          machine.succeed("systemctl list-units --no-pager")
+    '';
+}
diff --git a/testFlake/container-tests/dropped-backed-up-files.nix b/testFlake/container-tests/dropped-backed-up-files.nix
new file mode 100644
index 0000000..d5e69a7
--- /dev/null
+++ b/testFlake/container-tests/dropped-backed-up-files.nix
@@ -0,0 +1,66 @@
+{
+  forEachDistro,
+  system-manager,
+  system,
+  ...
+}:
+
+let
+  configV2 = system-manager.lib.makeSystemConfig {
+    modules = [
+      {
+        nixpkgs.hostPlatform = system;
+        system-manager.allowAnyDistro = true;
+      }
+    ];
+  };
+in
+
+forEachDistro "dropped-backed-up-files" {
+  modules = [
+    {
+      environment.etc = {
+        "replaced-test" = {
+          text = "managed\n";
+          replaceExisting = true;
+        };
+        "replaced-copy-test" = {
+          text = "managed\n";
+          mode = "0644";
+          replaceExisting = true;
+        };
+      };
+    }
+  ];
+  extraPathsToRegister = [ configV2 ];
+  testScriptFunction =
+    { toplevel, ... }:
+    ''
+      start_all()
+      machine.wait_for_unit("multi-user.target")
+
+      machine.succeed("echo -n original > /etc/replaced-test")
+      machine.succeed("echo -n original > /etc/replaced-copy-test")
+
+      with subtest("the entry replaces the original and backs it up"):
+          machine.activate()
+          machine.succeed("test -L /etc/replaced-test")
+          assert machine.succeed("cat /etc/replaced-test.system-manager-backup") == "original"
+          assert machine.succeed("cat /etc/replaced-copy-test") == "managed\n"
+          assert machine.succeed("cat /etc/replaced-copy-test.system-manager-backup") == "original"
+
+      with subtest("dropping the entry restores the original"):
+          machine.activate("${configV2}")
+          machine.succeed("test -f /etc/replaced-test -a ! -L /etc/replaced-test")
+          assert machine.succeed("cat /etc/replaced-test") == "original"
+          machine.fail("test -e /etc/replaced-test.system-manager-backup")
+          assert machine.succeed("cat /etc/replaced-copy-test") == "original"
+          machine.fail("test -e /etc/replaced-copy-test.system-manager-backup")
+
+      with subtest("adding it back backs up the original again"):
+          machine.activate()
+          machine.succeed("test -L /etc/replaced-test")
+          assert machine.succeed("cat /etc/replaced-test.system-manager-backup") == "original"
+          assert machine.succeed("cat /etc/replaced-copy-test.system-manager-backup") == "original"
+    '';
+}
