+const KEYBOARD_PILL_PX = 59;
+
+export function installViewportVars(): void {
+  const vv = window.visualViewport;
+  if (!vv) return;
+  const root = document.documentElement;
+  const drawsKeyboardPill = CSS.supports("-webkit-touch-callout", "none");
+  let baseline = vv.height;
+  let baselineWidth = vv.width;
+  let frame = 0;
+  const shrink = (keyboard: number) => {
+    root.style.setProperty("--app-kb", `${keyboard}px`);
+    root.style.setProperty("--app-sab", "0px");
+  };
+  const write = () => {
+    frame = 0;
+    if (vv.width !== baselineWidth) {
+      baselineWidth = vv.width;
+      baseline = vv.height;
+    }
+    baseline = Math.max(baseline, vv.height);
+    const pill =
+      drawsKeyboardPill && document.hasFocus() && document.activeElement?.matches(":read-write")
+        ? KEYBOARD_PILL_PX
+        : 0;
+    if (keyboardLikelyOpen(baseline, vv.height)) {
+      shrink(Math.max(pill, root.clientHeight - vv.offsetTop - vv.height));
+    } else if (pill) {
+      shrink(pill);
+    } else {
+      root.style.removeProperty("--app-kb");
+      root.style.removeProperty("--app-sab");
+    }
+  };
+  const schedule = () => {
+    if (!frame) frame = requestAnimationFrame(write);
+  };
+  write();
+  vv.addEventListener("resize", schedule);
+  vv.addEventListener("scroll", schedule);
+  document.addEventListener("focusin", schedule);
+  document.addEventListener("focusout", schedule);
+  window.addEventListener("focus", schedule);
+  window.addEventListener("blur", schedule);
+}
