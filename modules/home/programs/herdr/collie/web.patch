@@ -65,6 +65,39 @@ export function nextKeyboardOpen(
     : keyboardLikelyOpen(baselineHeight, currentHeight, KEYBOARD_MIN_PX);
 }
 
+export function installViewportVars(): void {
+  const vv = window.visualViewport;
+  if (!vv) return;
+  const root = document.documentElement;
+  let baseline = vv.height;
+  let baselineWidth = vv.width;
+  let frame = 0;
+  const shrink = (keyboard: number) => {
+    root.style.setProperty("--app-kb", `${keyboard}px`);
+    root.style.setProperty("--app-sab", "0px");
+  };
+  const write = () => {
+    frame = 0;
+    if (vv.width !== baselineWidth) {
+      baselineWidth = vv.width;
+      baseline = vv.height;
+    }
+    baseline = Math.max(baseline, vv.height);
+    if (keyboardLikelyOpen(baseline, vv.height)) {
+      shrink(Math.max(0, root.clientHeight - vv.offsetTop - vv.height));
+    } else {
+      root.style.removeProperty("--app-kb");
+      root.style.removeProperty("--app-sab");
+    }
+  };
+  const schedule = () => {
+    if (!frame) frame = requestAnimationFrame(write);
+  };
+  write();
+  vv.addEventListener("resize", schedule);
+  vv.addEventListener("scroll", schedule);
+}
