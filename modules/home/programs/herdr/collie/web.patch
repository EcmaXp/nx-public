+type Viewport = { height: number; width: number; offsetTop: number };
+
+function withViewport(
+  test: (resize: (next: Partial<Viewport>) => void, clientHeight: (px: number) => void) => void,
+  { drawsKeyboardPill = false } = {},
+) {
+  const vv = Object.assign(new EventTarget(), { height: 800, width: 390, offsetTop: 0 });
+  const root = document.documentElement;
+  const height = vi.spyOn(root, "clientHeight", "get").mockReturnValue(800);
+  const hasFocus = vi.spyOn(document, "hasFocus").mockReturnValue(true);
+  vi.stubGlobal("visualViewport", vv);
+  vi.stubGlobal("CSS", { supports: () => drawsKeyboardPill });
+  vi.useFakeTimers();
+  try {
+    installViewportVars();
+    test(
+      (next) => {
+        Object.assign(vv, next);
+        vv.dispatchEvent(new Event("resize"));
+        vi.advanceTimersToNextFrame();
+      },
+      (px) => height.mockReturnValue(px),
+    );
+  } finally {
+    height.mockRestore();
+    hasFocus.mockRestore();
+    vi.unstubAllGlobals();
+    vi.useRealTimers();
+    root.style.removeProperty("--app-kb");
+    root.style.removeProperty("--app-sab");
+  }
+}
+
+const kb = () => document.documentElement.style.getPropertyValue("--app-kb");
+const sab = () => document.documentElement.style.getPropertyValue("--app-sab");
+
+it("shrinks the shell for the keyboard and restores it after close or rotation", () => {
+  withViewport((resize, clientHeight) => {
+    resize({ height: 480 });
+    expect(kb()).toBe("320px");
+    expect(sab()).toBe("0px");
+    resize({ height: 800 });
+    expect(kb()).toBe("");
+    expect(sab()).toBe("");
+    clientHeight(390);
+    resize({ width: 800, height: 390 });
+    expect(kb()).toBe("");
+  });
+});
+
+function withFocusedField(test: (field: HTMLTextAreaElement) => void) {
+  const field = document.createElement("textarea");
+  document.body.append(field);
+  try {
+    field.focus();
+    vi.advanceTimersToNextFrame();
+    test(field);
+  } finally {
+    field.remove();
+  }
+}
+
+it("sets aside the hardware keyboard's pill while a field has focus, since iOS never resizes for it", () => {
+  withViewport(
+    () => {
+      withFocusedField((field) => {
+        expect(kb()).toBe("59px");
+        expect(sab()).toBe("0px");
+        field.blur();
+        vi.advanceTimersToNextFrame();
+        expect(kb()).toBe("");
+        expect(sab()).toBe("");
+      });
+    },
+    { drawsKeyboardPill: true },
+  );
+});
+
+it("drops the pill when iOS takes text input from a field that keeps DOM focus", () => {
+  withViewport(
+    () => {
+      withFocusedField(() => {
+        vi.mocked(document.hasFocus).mockReturnValue(false);
+        window.dispatchEvent(new Event("blur"));
+        vi.advanceTimersToNextFrame();
+        expect(kb()).toBe("");
+        vi.mocked(document.hasFocus).mockReturnValue(true);
+        window.dispatchEvent(new Event("focus"));
+        vi.advanceTimersToNextFrame();
+        expect(kb()).toBe("59px");
+      });
+    },
+    { drawsKeyboardPill: true },
+  );
+});
+
+it("lets an on-screen keyboard taller than the pill win", () => {
+  withViewport(
+    (resize) => {
+      withFocusedField(() => {
+        resize({ height: 480 });
+        expect(kb()).toBe("320px");
+      });
+    },
+    { drawsKeyboardPill: true },
+  );
+});
+
+it("sets nothing aside for focus where no pill is drawn", () => {
+  withViewport(() => {
+    withFocusedField(() => {
+      expect(kb()).toBe("");
+    });
+  });
+});
