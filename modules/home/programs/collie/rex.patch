new file mode 100644
index 00000000..d261e599
--- /dev/null
+++ b/bridge/journal/claude-pid.ts
@@ -0,0 +1,104 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+
+import { asJsonNumber, asJsonObject, asJsonString, parseJson } from "../../web/src/lib/json.ts";
+import { claudeConfigDir } from "../claude-commands.ts";
+import { isSessionId } from "./claude.ts";
+import type { AgentSessionRef } from "./types.ts";
+
+const CLAUDE_PID_RECORDS_SUBDIR = "sessions";
+
+const VERDICT_MEMO_LIMIT = 256;
+const PS_TIMEOUT_MS = 2000;
+
+export interface ClaudePidRecord {
+  readonly sessionId: string;
+  readonly procStart: string;
+}
+
+export type ProcessStartOf = (pid: number) => Promise<string | null>;
+
+export type ReadText = (path: string) => Promise<string | null>;
+
+export function claudePidRecordDirs(projectRoots: readonly string[], home: string): string[] {
+  const roots = projectRoots.map((root) => root.trim()).filter((root) => root !== "");
+  return [...new Set(roots.map((root) => join(claudeConfigDir([root], home), CLAUDE_PID_RECORDS_SUBDIR)))];
+}
+
+function isProcessId(pid: number): boolean {
+  return Number.isSafeInteger(pid) && pid > 0;
+}
+
+export function normalizeProcessStart(text: string): string {
+  return text.trim().split(/\s+/u).join(" ");
+}
+
+export function parseClaudePidRecord(text: string, pid: number): ClaudePidRecord | null {
+  const record = asJsonObject(parseJson(text));
+  if (record === undefined || asJsonNumber(record.pid) !== pid) return null;
+  const sessionId = asJsonString(record.sessionId);
+  const procStart = normalizeProcessStart(asJsonString(record.procStart) ?? "");
+  if (sessionId === undefined || !isSessionId(sessionId) || procStart === "") return null;
+  return { sessionId, procStart };
+}
+
+export async function processStartUtc(pid: number): Promise<string | null> {
+  if (!isProcessId(pid)) return null;
+  try {
+    const child = Bun.spawn(["ps", "-o", "lstart=", "-p", String(pid)], {
+      stdin: "ignore",
+      stdout: "pipe",
+      stderr: "ignore",
+      env: { ...process.env, TZ: "UTC", LC_ALL: "C" },
+    });
+    const timer = setTimeout(() => child.kill("SIGKILL"), PS_TIMEOUT_MS);
+    try {
+      const [text, code] = await Promise.all([new Response(child.stdout).text(), child.exited]);
+      const start = normalizeProcessStart(text);
+      return code === 0 && start !== "" ? start : null;
+    } finally {
+      clearTimeout(timer);
+    }
+  } catch {
+    return null;
+  }
+}
+
+async function readTextOrNull(path: string): Promise<string | null> {
+  try {
+    return await readFile(path, "utf8");
+  } catch {
+    return null;
+  }
+}
+
+export class ClaudePidSessions {
+  private readonly verdicts = new Map<string, boolean>();
+
+  constructor(
+    private readonly dirs: readonly string[],
+    private readonly startOf: ProcessStartOf = processStartUtc,
+    private readonly read: ReadText = readTextOrNull,
+  ) {}
+
+  async sessionFor(pid: number): Promise<AgentSessionRef | null> {
+    if (!isProcessId(pid)) return null;
+    for (const dir of this.dirs) {
+      const text = await this.read(join(dir, `${String(pid)}.json`));
+      const record = text === null ? null : parseClaudePidRecord(text, pid);
+      if (record !== null && (await this.startedAt(pid, record.procStart))) return { kind: "id", value: record.sessionId };
+    }
+    return null;
+  }
+
+  private async startedAt(pid: number, procStart: string): Promise<boolean> {
+    const key = `${String(pid)} ${procStart}`;
+    const known = this.verdicts.get(key);
+    if (known !== undefined) return known;
+    const actual = await this.startOf(pid);
+    if (actual === null) return false;
+    if (this.verdicts.size >= VERDICT_MEMO_LIMIT) this.verdicts.clear();
+    this.verdicts.set(key, actual === procStart);
+    return actual === procStart;
+  }
+}
