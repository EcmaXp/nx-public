new file mode 100644
index 00000000..c1b2affb
--- /dev/null
+++ b/bridge/mux/rex/keys.ts
@@ -0,0 +1,96 @@
+import { MUX_NAMED_KEYS, parseMuxKey, type MuxNamedKey } from "../keys.ts";
+
+const REX_NAMED_KEYS = {
+  Up: "up",
+  Down: "down",
+  Left: "left",
+  Right: "right",
+  Tab: "tab",
+  Enter: "enter",
+  Escape: "escape",
+  Space: "space",
+  Backspace: "backspace",
+  Delete: "delete",
+  Insert: "insert",
+  Home: "home",
+  End: "end",
+  PageUp: "pageup",
+  PageDown: "pagedown",
+  F1: "f1",
+  F2: "f2",
+  F3: "f3",
+  F4: "f4",
+  F5: "f5",
+  F6: "f6",
+  F7: "f7",
+  F8: "f8",
+  F9: "f9",
+  F10: "f10",
+  F11: "f11",
+  F12: "f12",
+} satisfies Record<MuxNamedKey, string>;
+
+const SHIFTED_US = new Map<string, string>([
+  ["~", "`"],
+  ["!", "1"],
+  ["@", "2"],
+  ["#", "3"],
+  ["$", "4"],
+  ["%", "5"],
+  ["^", "6"],
+  ["&", "7"],
+  ["*", "8"],
+  ["(", "9"],
+  [")", "0"],
+  ["_", "-"],
+  ["+", "="],
+  ["{", "["],
+  ["}", "]"],
+  ["|", "\\"],
+  [":", ";"],
+  ['"', "'"],
+  ["<", ","],
+  [">", "."],
+  ["?", "/"],
+]);
+
+const UNSHIFTED = /^[a-z0-9`\-=[\]\\;',./]$/u;
+
+export type RexKeyRejection = "unparsed" | "meta" | "character";
+
+export type RexKeyResult =
+  | { readonly ok: true; readonly key: string }
+  | { readonly ok: false; readonly reason: RexKeyRejection };
+
+export const REX_UNSENDABLE_KEYS: readonly MuxNamedKey[] = [];
+
+const _EVERY_UNSENDABLE_IS_A_NAMED_KEY: readonly (typeof MUX_NAMED_KEYS)[number][] = REX_UNSENDABLE_KEYS;
+void _EVERY_UNSENDABLE_IS_A_NAMED_KEY;
+
+const NAMED_BY_CONTRACT_SPELLING = new Map<string, string>(Object.entries(REX_NAMED_KEYS));
+
+function baseKey(key: string): { readonly key: string; readonly shift: boolean } | null {
+  const named = NAMED_BY_CONTRACT_SPELLING.get(key);
+  if (named !== undefined) return { key: named, shift: false };
+  if (key === " ") return { key: "space", shift: false };
+  if (UNSHIFTED.test(key)) return { key, shift: false };
+  if (/^[A-Z]$/u.test(key)) return { key: key.toLowerCase(), shift: true };
+  const shifted = SHIFTED_US.get(key);
+  if (shifted !== undefined) return { key: shifted, shift: true };
+  return null;
+}
+
+export function toRexKey(spelling: string): RexKeyResult {
+  const parsed = parseMuxKey(spelling);
+  if (parsed === null) return { ok: false, reason: "unparsed" };
+  if (parsed.modifiers.includes("meta")) return { ok: false, reason: "meta" };
+  const base = baseKey(parsed.key);
+  if (base === null) return { ok: false, reason: "character" };
+
+  const parts: string[] = [];
+  if (parsed.modifiers.includes("ctrl")) parts.push("ctrl");
+  if (parsed.modifiers.includes("alt")) parts.push("alt");
+  if (parsed.modifiers.includes("shift") || base.shift) parts.push("shift");
+  parts.push(base.key);
+  return { ok: true, key: parts.join("+") };
+}
diff --git a/bridge/mux/rex/layout.ts b/bridge/mux/rex/layout.ts
new file mode 100644
index 00000000..cd35f08d
--- /dev/null
+++ b/bridge/mux/rex/layout.ts
@@ -0,0 +1,179 @@
+import { meaningfulTerminalTitle } from "../../activity.ts";
+import type { AgentSessionRef } from "../../journal/types.ts";
+import type { AgentStatus } from "../../types.ts";
+import { MUX_SHELL_AGENT } from "../agents.ts";
+import { agentForApp, agentStatus } from "../herdr-core/layout.ts";
+import type { MuxPane, MuxSnapshot, MuxSpace, MuxTab } from "../types.ts";
+import { TERMINAL_CREATOR, type RexBlock, type RexBlockInfo, type RexRawSnapshot, type RexStatusRecord, type RexWindow } from "./protocol.ts";
+
+type MutableMuxPane = { -readonly [K in keyof MuxPane]: MuxPane[K] };
+
+export interface PaneAgent {
+  readonly agent: string;
+  readonly status: AgentStatus;
+}
+
+export function reportedRecord(records: readonly RexStatusRecord[]): RexStatusRecord | null {
+  const root = records.find((record) => record.id === "");
+  if (root !== undefined) return root;
+  return records.toSorted((a, b) => b.updatedAt.localeCompare(a.updatedAt))[0] ?? null;
+}
+
+export function paneAgent(info: RexBlockInfo | undefined): PaneAgent {
+  const record = reportedRecord(info?.records ?? []);
+  if (record !== null && record.app.trim() !== "") {
+    const reported = agentForApp(record.app);
+    if (reported === null) return { agent: MUX_SHELL_AGENT, status: "unknown" };
+    return { agent: reported, status: agentStatus(record.state) };
+  }
+  const running = agentForApp(info?.process?.foreground?.name ?? "");
+  if (running !== null) return { agent: running, status: "unknown" };
+  return { agent: MUX_SHELL_AGENT, status: "unknown" };
+}
+
+const PID_SESSION_AGENT = "claude";
+
+export function sessionPid(info: RexBlockInfo | undefined): number | null {
+  if (paneAgent(info).agent !== PID_SESSION_AGENT) return null;
+  const owner = reportedRecord(info?.records ?? [])?.ownerPid ?? 0;
+  const pid = owner > 0 ? owner : (info?.process?.foreground?.pid ?? 0);
+  return pid > 0 ? pid : null;
+}
+
+function idTail(id: string): string {
+  return id.slice(-8);
+}
+
+export function isDefaultWindowLabel(windowId: string, label: string): boolean {
+  return label === "" || label === `Window ${idTail(windowId)}`;
+}
+
+export function isDefaultBlockLabel(blockId: string, label: string): boolean {
+  return label === "" || label === "shell" || label === `Block ${idTail(blockId)}`;
+}
+
+function focusedSessions(raw: RexRawSnapshot): Set<string> {
+  const focused = new Set<string>();
+  for (const client of raw.clients) {
+    if (client.kind !== "app") continue;
+    if (client.state !== "" && client.state !== "connected") continue;
+    const only = client.sessionIds.length === 1 ? client.sessionIds[0] : undefined;
+    if (only !== undefined) focused.add(only);
+  }
+  return focused;
+}
+
+function publishedBlocks(window: RexWindow, hostId: string): RexBlock[] {
+  return window.blocks.filter((block) => block.creator === TERMINAL_CREATOR && (block.hostId === "" || block.hostId === hostId));
+}
+
+export function sessionPids(raw: RexRawSnapshot): Map<string, number> {
+  const pids = new Map<string, number>();
+  for (const session of raw.sessions) {
+    for (const window of session.windows) {
+      for (const block of publishedBlocks(window, raw.hostId)) {
+        const pid = sessionPid(session.blocks.get(block.blockId));
+        if (pid !== null) pids.set(block.blockId, pid);
+      }
+    }
+  }
+  return pids;
+}
+
+export function toSnapshot(raw: RexRawSnapshot, sessionRefs: ReadonlyMap<string, AgentSessionRef> = new Map()): MuxSnapshot {
+  const focused = focusedSessions(raw);
+  const spaces: MuxSpace[] = [];
+  const tabs: MuxTab[] = [];
+  const panes: MuxPane[] = [];
+
+  for (const session of raw.sessions) {
+    const spaceNumber = spaces.length + 1;
+    const spaceFocused = focused.has(session.sessionId);
+    const spaceTabs: MuxTab[] = [];
+    const spacePanes: MuxPane[] = [];
+
+    for (const window of session.windows) {
+      const blocks = publishedBlocks(window, raw.hostId);
+      if (blocks.length === 0) continue;
+      const number = spaceTabs.length + 1;
+      const named = !isDefaultWindowLabel(window.windowId, window.label);
+      const active = window.windowId === session.activeWindowId;
+      spaceTabs.push({
+        tabId: window.windowId,
+        spaceId: session.sessionId,
+        number,
+        label: named ? window.label : String(number),
+        focused: spaceFocused && active,
+        paneCount: blocks.length,
+      });
+      for (const block of blocks) {
+        const info = session.blocks.get(block.blockId);
+        const foreground = info?.process?.foreground ?? null;
+        const { agent, status } = paneAgent(info);
+        const pane: MutableMuxPane = {
+          paneId: block.blockId,
+          spaceId: session.sessionId,
+          spaceLabel: session.label,
+          spaceNumber,
+          tabId: window.windowId,
+          cwd: foreground?.cwd ?? "",
+          focused: spaceFocused && active && window.focusedBlockId === block.blockId,
+          alive: info?.process?.exited !== true,
+          agent,
+          status,
+        };
+        if (named) {
+          pane.tabLabel = window.label;
+          pane.tabNamed = true;
+        }
+        if (!isDefaultBlockLabel(block.blockId, block.label)) pane.paneLabel = block.label;
+        const title = meaningfulTerminalTitle(info?.title, undefined, agent, session.label);
+        if (title !== undefined) pane.terminalTitle = title;
+        if (foreground !== null && foreground.name !== "") pane.foregroundCommand = foreground.name;
+        const sessionRef = sessionRefs.get(block.blockId);
+        if (sessionRef !== undefined) pane.agentSession = sessionRef;
+        spacePanes.push(pane);
+      }
+    }
+
+    if (spacePanes.length === 0) continue;
+    const activeTab = spaceTabs.find((tab) => tab.tabId === session.activeWindowId) ?? spaceTabs[0];
+    spaces.push({
+      spaceId: session.sessionId,
+      number: spaceNumber,
+      label: session.label,
+      focused: spaceFocused,
+      activeTabId: activeTab?.tabId ?? "",
+      tabCount: spaceTabs.length,
+      paneCount: spacePanes.length,
+    });
+    tabs.push(...spaceTabs);
+    panes.push(...spacePanes);
+  }
+
+  return { panes, spaces, tabs };
+}
+
+// eslint-disable-next-line no-control-regex
+const ESCAPE = /\u001b(?:\[([0-9;:?<=>]*)([ -/]*)([@-~])|\][^\u0007\u001b]*(?:\u0007|\u001b\\)|[PX^_][^\u001b]*\u001b\\|[@-Z\\-_])/gu;
+
+function keepOrExpand(whole: string, params: string | undefined, intermediates: string | undefined, final: string | undefined): string {
+  if (final === "m" && !intermediates && params !== undefined && !/[?<=>]/u.test(params)) return whole;
+  if (final === "C" && !intermediates && params !== undefined && /^\d*$/u.test(params)) return " ".repeat(Math.max(1, Number(params || "1")));
+  return "";
+}
+
+export function normalizeGrid(content: string): string {
+  return content.replace(/\r\n/gu, "\n").replace(/\r/gu, "").replace(ESCAPE, keepOrExpand);
+}
+
+export interface GridRows {
+  readonly rows: readonly string[];
+  readonly cutAbove: boolean;
+}
+
+export function gridRows(content: string, start: number): GridRows {
+  const rows = normalizeGrid(content).replace(/\n$/u, "").split("\n");
+  if (start > 0 && rows.length > 0) return { rows: rows.slice(1), cutAbove: true };
+  return { rows, cutAbove: false };
+}
