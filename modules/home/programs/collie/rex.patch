+} from "./protocol.ts";
+import { refusalForAnswer, refusalForRun } from "./refusal.ts";
+import { RexWatch } from "./watch.ts";
+
+export const REX_MUX = "rex";
+
+export const REX_BINARY_OPTION = "rexBin";
+
+export const REX_CLAUDE_ROOTS_OPTION = "claudeRoots";
+
+export interface RexSessionLookup {
+  sessionFor(pid: number): Promise<AgentSessionRef | null>;
+}
+
+export const DEFAULT_REX_TIMEOUT_MS = 5000;
+
+const VIEWPORT_BYTES = 64 * 1024;
+const MIN_RECENT_BYTES = 64 * 1024;
+const MAX_RECENT_BYTES = 1024 * 1024;
+const BYTES_PER_LINE = 512;
+const DEFAULT_ROWS = 24;
+
+function labelRefusal(kind: "block" | "window", label: string): MuxRefusalOutcome | null {
+  return [...label].length > MAX_LABEL_CHARS ? muxRefused(`Rex takes a ${kind} label of at most ${String(MAX_LABEL_CHARS)} characters`) : null;
+}
+
+interface RevisionEntry {
+  revision: number;
+  lastScreen: string;
+}
+
+export class RexMux implements MuxAdapter {
+  readonly mux = REX_MUX;
+  readonly logo = REX_LOGO_SVG;
+
+  readonly capabilities = declareCapabilities({
+    supports: [
+      "paneGrid",
+      "gridScrollback",
+      "agentDetection",
+      "agentSessionRef",
+      "typeText",
+      "sendKeys",
+      "renamePane",
+      "closePane",
+      "createTab",
+      "renameTab",
+      "closeTab",
+      "pushTopologyEvents",
+      "pushPaneEvents",
+    ],
+    spaces: "many",
+    topologyLatency: { kind: "push" },
+    unsupportedKeys: [...REX_UNSENDABLE_KEYS],
+  });
+
+  private readonly revisions = new Map<string, RevisionEntry>();
+
+  constructor(
+    private readonly exec: RexExec,
+    private readonly sessions?: RexSessionLookup,
+  ) {}
+
+  async reachable(): Promise<boolean> {
+    try {
+      return (await this.attempt({ op: "census" })).ok;
+    } catch {
+      return false;
+    }
+  }
+
+  async snapshot(): Promise<MuxSnapshot> {
+    const read = await this.attempt({ op: "snapshot" });
+    if (!read.ok) throw new Error(read.reason === "unreachable" ? read.detail : `failed to read the Rex snapshot: ${read.detail}`);
+    const raw = decodeSnapshot(read.value);
+    const snapshot = toSnapshot(raw, await this.sessionRefs(raw));
+    this.forgetGonePanes(snapshot);
+    return snapshot;
+  }
+
+  private async sessionRefs(raw: RexRawSnapshot): Promise<Map<string, AgentSessionRef>> {
+    const refs = new Map<string, AgentSessionRef>();
+    const sessions = this.sessions;
+    if (sessions === undefined) return refs;
+    await Promise.all(
+      [...sessionPids(raw)].map(async ([blockId, pid]) => {
+        const ref = await sessions.sessionFor(pid).catch(() => null);
+        if (ref !== null) refs.set(blockId, ref);
+      }),
+    );
+    return refs;
+  }
+
+  async refresh(): Promise<void> {
+    return Promise.resolve();
+  }
+
+  async readGrid(paneId: string, request: MuxGridRequest): Promise<MuxOutcome<MuxGrid>> {
+    const lines = Math.max(1, request.lines);
+    const bytes = request.scope === "viewport" ? VIEWPORT_BYTES : Math.min(MAX_RECENT_BYTES, Math.max(MIN_RECENT_BYTES, lines * BYTES_PER_LINE));
+    const read = await this.attempt({ op: "tail", block: paneId, format: "vt", bytes });
+    if (!read.ok) return read;
+    const tail = decodeTail(read.value);
+    const { rows, cutAbove } = gridRows(tail.content, tail.start);
+    const screenRows = rows.slice(-Math.max(1, tail.rows || DEFAULT_ROWS));
