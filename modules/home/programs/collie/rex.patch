+      paneId,
+      text: request.styling === "preserve" ? kept.join("\n") : stripSgr(kept.join("\n")),
+      truncated: cutAbove || source.length > kept.length,
+      revision: this.revisionFor(paneId, stripSgr(screenRows.join("\n"))),
+    });
+  }
+
+  async foregroundProcesses(paneId: string): Promise<MuxOutcome<readonly ForegroundProcess[]>> {
+    const read = await this.attempt({ op: "process", block: paneId });
+    if (!read.ok) return read;
+    const process = decodeProcess(read.value);
+    const entries: RexProcessEntry[] = [];
+    if (process?.foreground) entries.push(process.foreground);
+    entries.push(...(process?.ancestors ?? []));
+    return muxOk(entries.map((entry) => ({ argv: [entry.script || entry.argv0 || entry.name], pid: entry.pid })));
+  }
+
+  async typeText(paneId: string, text: string): Promise<MuxAck> {
+    if (text.length === 0) return muxAck();
+    const encoded = Buffer.byteLength(JSON.stringify(text), "utf8");
+    if (encoded > MAX_WRITE_JSON_BYTES) {
+      return muxRefused(
+        `Rex takes at most ${String(MAX_WRITE_JSON_BYTES)} bytes of encoded text in one request, and this message is ${String(encoded)}`,
+      );
+    }
+    const sent = await this.attempt({ op: "write", block: paneId, text, paste: /[\r\n]/u.test(text) }, { write: true });
+    return sent.ok ? muxAck() : sent;
+  }
+
+  async writeKeys(paneId: string, keys: readonly string[]): Promise<MuxAck> {
+    if (keys.length === 0) return muxAck();
+    const translated: string[] = [];
+    for (const key of keys) {
+      const res = toRexKey(key);
+      if (!res.ok) {
+        if (res.reason === "meta") return muxRefused("Rex cannot send meta chords: a terminal does not receive Super or Command");
+        if (res.reason === "character") return muxRefused(`Rex sends keys on a US layout and has no key for ${key}; type it as text instead`);
+        return muxRefused(`Rex cannot send key: ${key}`);
+      }
+      translated.push(res.key);
+    }
+    const res = await this.runCli(["send-key", "-b", paneId, "--", ...translated], { write: true });
+    return res.ok ? muxAck() : res;
+  }
+
+  async renamePane(paneId: string, label: string | null): Promise<MuxAck> {
+    const next = label?.trim() ?? "";
+    const refused = labelRefusal("block", next);
+    if (refused !== null) return refused;
+    const res = await this.attempt({ op: "label_block", block: paneId, label: next });
+    return res.ok ? muxAck() : res;
+  }
+
+  async closePane(paneId: string): Promise<MuxAck> {
+    const res = await this.attempt({ op: "close_block", block: paneId });
+    return res.ok ? muxAck() : res;
+  }
+
+  async setFocus(_paneId: string): Promise<MuxAck> {
+    return muxUnsupported(
+      "setFocus",
+      "Rex reports which sessions an app attaches, not which one it shows, so Collie cannot confirm the pane it would focus is the one on the screen",
+    );
+  }
+
+  async createTab(request: MuxTabRequest): Promise<MuxOutcome<MuxCreatedPane>> {
+    const label = request.label?.trim() ?? "";
+    const refused = labelRefusal("window", label);
+    if (refused !== null) return refused;
+    const args = ["window", "new", "-s", request.spaceId, "--focus=false", "--json"];
+    const cwd = requestedCwd(request.cwd);
+    if (cwd) args.push("-c", cwd);
+    const created = await this.runCli(args);
+    if (!created.ok) return created;
+    const window = decodeCreatedWindow(created.value);
+    const paneId = window?.blockIds[0];
+    if (window === null || paneId === undefined) return muxRefused("Rex made a window and did not name it and its block");
+    if (label) await this.attempt({ op: "label_window", window: window.windowId, label });
+    const looked = await this.attempt({ op: "snapshot" });
+    const pane = looked.ok ? toSnapshot(decodeSnapshot(looked.value)).panes.find((p) => p.paneId === paneId) : undefined;
+    return muxOk({
+      paneId,
+      spaceId: request.spaceId,
+      spaceLabel: pane?.spaceLabel ?? "",
+      tabId: window.windowId,
+      cwd: pane?.cwd || cwd || "",
+    });
+  }
+
+  async renameTab(tabId: string, label: string): Promise<MuxAck> {
+    const next = label.trim();
+    const refused = labelRefusal("window", next);
+    if (refused !== null) return refused;
+    const res = await this.attempt({ op: "label_window", window: tabId, label: next });
+    return res.ok ? muxAck() : res;
+  }
+
+  async closeTab(tabId: string): Promise<MuxAck> {
+    const res = await this.attempt({ op: "close_window", window: tabId });
+    return res.ok ? muxAck() : res;
+  }
+
+  async createSpace(_request: MuxSpaceRequest): Promise<MuxOutcome<MuxCreatedPane>> {
+    return muxUnsupported("createSpace", "a new Rex session joins the app's sidebar, which Collie does not move");
+  }
+
+  async listSessions(): Promise<MuxOutcome<readonly MuxSession[]>> {
+    return muxUnsupported("listSessions", "every Rex session is already a space of this server");
+  }
+
+  watch(options: MuxWatchOptions): MuxSubscription {
+    return new RexWatch(this.exec, options);
+  }
+
+  private async attempt(op: RexOp, opts: { readonly write?: boolean } = {}): Promise<MuxOutcome<JsonValue>> {
+    const ran = await this.runCli(["do", "-"], opts, rexScript(op));
+    if (!ran.ok) return ran;
+    const answer = parseAnswer(ran.value);
+    if (answer === null) return muxRefused(`Rex answered with something that is not the program's output: ${ran.value.slice(0, 200)}`);
+    return answer.ok ? muxOk(answer.value) : refusalForAnswer(answer.error, opts);
+  }
+
+  private async runCli(args: readonly string[], opts: { readonly write?: boolean } = {}, stdin?: string): Promise<MuxOutcome<string>> {
+    let result;
+    try {
+      result = await this.exec.run(args, stdin);
+    } catch (err) {
+      return refusalForRun(NO_BINARY_CODE, err instanceof Error ? err.message : String(err));
+    }
+    return result.code === 0 ? muxOk(result.stdout) : refusalForRun(result.code, result.stderr, opts);
+  }
+
+  private revisionFor(paneId: string, screen: string): number {
+    const entry = this.revisions.get(paneId);
+    if (entry === undefined) {
+      this.revisions.set(paneId, { revision: 1, lastScreen: screen });
+      return 1;
+    }
+    if (entry.lastScreen === screen) return entry.revision;
+    entry.revision += 1;
+    entry.lastScreen = screen;
+    return entry.revision;
+  }
+
+  private forgetGonePanes(snapshot: MuxSnapshot): void {
+    if (this.revisions.size === 0) return;
+    const live = new Set(snapshot.panes.map((pane) => pane.paneId));
+    for (const paneId of this.revisions.keys()) if (!live.has(paneId)) this.revisions.delete(paneId);
+  }
+}
+
+export const rexMuxFactory: MuxAdapterFactory = {
+  mux: REX_MUX,
+  create(target: MuxTarget) {
+    const binary = resolveRexBinary(target.options[REX_BINARY_OPTION] ?? "");
+    const dirs = claudePidRecordDirs((target.options[REX_CLAUDE_ROOTS_OPTION] ?? "").split("\n"), homedir());
+    const sessions = dirs.length > 0 ? new ClaudePidSessions(dirs) : undefined;
+    return new RexMux(new SpawnRexExec(binary, target.endpoint, target.timeoutMs || DEFAULT_REX_TIMEOUT_MS), sessions);
+  },
+  describeTarget(endpoint: string) {
+    return endpoint.trim() ? `socket ${endpoint.trim()}` : "its default socket";
+  },
+};
diff --git a/bridge/mux/rex/exec.ts b/bridge/mux/rex/exec.ts
new file mode 100644
index 00000000..ccebde6c
--- /dev/null
+++ b/bridge/mux/rex/exec.ts
@@ -0,0 +1,165 @@
+import { existsSync } from "node:fs";
+import { isAbsolute } from "node:path";
+
+export interface RexRunResult {
+  readonly code: number;
+  readonly stdout: string;
+  readonly stderr: string;
+}
+
+export interface RexStreamHandlers {
+  onLine(line: string): void;
+  onExit(reason: string): void;
+}
+
+export interface RexStreamClient {
+  kill(): void;
+}
+
+export interface RexExec {
+  run(args: readonly string[], stdin?: string): Promise<RexRunResult>;
+  events(handlers: RexStreamHandlers): RexStreamClient;
+}
+
+export function rexBinaryCandidates(home: string = process.env.HOME ?? ""): readonly string[] {
+  const local = home.length > 0
+    ? [
+        `${home}/.local/bin/rex`,
+        `${home}/Applications/Rex.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex`,
+        `${home}/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex`,
+      ]
+    : [];
+  return [
+    ...local,
+    "/Applications/Rex.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex",
+    "/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex",
+    "/opt/homebrew/bin/rex",
+    "/usr/local/bin/rex",
+    "/usr/bin/rex",
+  ];
+}
+
+export function resolveRexBinary(
+  configured: string,
+  exists: (path: string) => boolean = existsSync,
+  candidates: readonly string[] = rexBinaryCandidates(),
+): string | null {
+  const named = configured.trim();
+  if (named.length > 0) return isAbsolute(named) && exists(named) ? named : null;
+  return candidates.find((candidate) => exists(candidate)) ?? null;
+}
+
+export function defaultRexSocket(home: string): string {
+  return `${home}/Library/Application Support/rex/server.sock`;
+}
+
+export function rexServerArgs(endpoint: string): readonly string[] {
+  const socket = endpoint.trim();
+  return socket.length > 0 ? ["-S", `unix://${socket}`] : [];
+}
+
+export function isLocalEndpoint(endpoint: string): boolean {
+  const socket = endpoint.trim();
+  return socket.length === 0 || isAbsolute(socket);
+}
+
+export const NO_REX_BINARY = "no rex binary found — set COLLIE_REX_BIN to its absolute path";
+export const NOT_LOCAL_ENDPOINT = "the Rex endpoint must be the absolute path of a local socket";
+export const TIMED_OUT_CODE = 143;
+export const NO_BINARY_CODE = 127;
+export const KILL_GRACE_MS = 1000;
+
+export function timedOutMessage(args: readonly string[], timeoutMs: number): string {
+  const verb = args.filter((arg) => !arg.startsWith("-")).slice(0, 2).join(" ") || "the call";
+  return `rex did not answer \`${verb}\` within ${String(timeoutMs)}ms and was killed`;
+}
+
+export class SpawnRexExec implements RexExec {
+  private readonly unavailable: string | null;
+  private readonly command: readonly string[];
+
+  constructor(
+    binary: string | null,
+    endpoint: string,
+    private readonly timeoutMs: number,
+  ) {
+    this.unavailable = !isLocalEndpoint(endpoint) ? NOT_LOCAL_ENDPOINT : binary === null ? NO_REX_BINARY : null;
+    this.command = [binary ?? "", "--autostart=false", "--color", "never", ...rexServerArgs(endpoint)];
+  }
+
+  async run(args: readonly string[], stdin?: string): Promise<RexRunResult> {
+    if (this.unavailable !== null) return { code: NO_BINARY_CODE, stdout: "", stderr: this.unavailable };
+    const seconds = Math.max(1, Math.floor(this.timeoutMs / 1000) - 1);
+
+    const child = Bun.spawn([...this.command, "--timeout", `${String(seconds)}s`, ...args], {
+      stdin: stdin === undefined ? "ignore" : new TextEncoder().encode(stdin),
+      stdout: "pipe",
+      stderr: "pipe",
+    });
+
+    let killed = false;
+    let hardKill: ReturnType<typeof setTimeout> | null = null;
+    const timer = setTimeout(() => {
+      killed = true;
+      child.kill();
+      hardKill = setTimeout(() => child.kill("SIGKILL"), KILL_GRACE_MS);
+    }, this.timeoutMs);
+
+    try {
+      const [stdout, stderr] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text()]);
+      const code = await child.exited;
+      if (killed) return { code: TIMED_OUT_CODE, stdout: "", stderr: timedOutMessage(args, this.timeoutMs) };
+      return { code, stdout, stderr };
+    } finally {
+      clearTimeout(timer);
+      if (hardKill !== null) clearTimeout(hardKill);
+    }
+  }
+
+  events(handlers: RexStreamHandlers): RexStreamClient {
+    const unavailable = this.unavailable;
+    if (unavailable !== null) {
+      queueMicrotask(() => handlers.onExit(unavailable));
+      return { kill: () => undefined };
+    }
+    const child = Bun.spawn([...this.command, "events", "--all", "--json"], { stdin: "ignore", stdout: "pipe", stderr: "ignore" });
+
+    let ended = false;
+    const end = (reason: string): void => {
+      if (ended) return;
+      ended = true;
+      handlers.onExit(reason);
+    };
+
+    void (async () => {
+      try {
+        await pumpLines(child.stdout, handlers.onLine);
+        end("the rex event stream ended");
+      } catch (err) {
+        end(err instanceof Error ? err.message : String(err));
+      }
+    })();
+
+    return {
+      kill: () => {
+        child.kill();
+        end("closed");
+      },
+    };
+  }
+}
+
+async function pumpLines(stream: ReadableStream<Uint8Array>, onLine: (line: string) => void): Promise<void> {
+  const decoder = new TextDecoder();
+  let buffered = "";
+  for await (const chunk of stream) {
+    buffered += decoder.decode(chunk, { stream: true });
+    let cut = buffered.indexOf("\n");
+    while (cut >= 0) {
+      onLine(buffered.slice(0, cut).replace(/\r$/u, ""));
+      buffered = buffered.slice(cut + 1);
+      cut = buffered.indexOf("\n");
+    }
+  }
+  if (buffered.length > 0) onLine(buffered);
+}
