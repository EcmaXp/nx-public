diff --git a/bridge/mux/rex/protocol.ts b/bridge/mux/rex/protocol.ts
new file mode 100644
index 00000000..a3c344bc
--- /dev/null
+++ b/bridge/mux/rex/protocol.ts
@@ -0,0 +1,455 @@
+import { asJsonNumber, asJsonObject, asJsonString, parseJson } from "../../../web/src/lib/json.ts";
+import type { JsonObject, JsonValue } from "../../json.ts";
+
+export const TERMINAL_CREATOR = "com.superlogical.terminal";
+
+export const MAX_WRITE_JSON_BYTES = 64 * 1024 - 1024;
+
+export const MAX_LABEL_CHARS = 128;
+
+export const REX_PROGRAM = String.raw`
+local A = rex.json.decode(ARGS)
+local function list(t) return t or {} end
+local function try(method, args)
+  local result, err = rex.call(method, args)
+  if result == nil then return nil, tostring(err) end
+  return result
+end
+local function attach()
+  return try("session.attach_all", { event_scope = "session" })
+end
+local function locate(target)
+  local all, err = attach()
+  if not all then return nil, err end
+  for _, s in ipairs(list(all.sessions)) do
+    if s.session_id == target then return s.session_id end
+    local view = try("session.view", { session_id = s.session_id })
+    for _, w in ipairs(view and list(view.windows) or {}) do
+      if w.window_id == target then return s.session_id end
+      for _, l in ipairs(list(w.layers)) do
+        for _, b in ipairs(list(l.blocks)) do
+          if b.block_id == target then return s.session_id end
+        end
+      end
+    end
+  end
+  return nil, target .. " not found (status=404 code=not_found)"
+end
+local function method(session, block, name, args)
+  return try("block.method", { session_id = session, block_id = block, method = name, args = args or {} })
+end
+local function leading_replacements(data)
+  local count, at = 0, 1
+  while string.sub(data, at, at + 2) == "\239\191\189" do
+    count = count + 1
+    at = at + 3
+  end
+  return count
+end
+local ops = {}
+function ops.snapshot()
+  local status, err = try("server.status", {})
+  if not status then return nil, err end
+  local clients, clients_err = try("client.list", { kinds = { "app" } })
+  local all, all_err = attach()
+  if not all then return nil, all_err end
+  local out = { host_id = status.host_id, clients = clients and clients.clients or {}, clients_error = clients_err, sessions = {} }
+  for _, s in ipairs(list(all.sessions)) do
+    local view, view_err = try("session.view", { session_id = s.session_id })
+    local entry = { session_id = s.session_id, label = s.label, view = view, error = view_err, blocks = {} }
+    for _, w in ipairs(view and list(view.windows) or {}) do
+      for _, l in ipairs(list(w.layers)) do
+        for _, b in ipairs(list(l.blocks)) do
+          if b.creator_name == A.terminal then
+            local probe = {}
+            for _, name in ipairs({ "process", "title", "program_status" }) do
+              local r, e = method(s.session_id, b.block_id, name)
+              probe[name] = r
+              if e then probe[name .. "_error"] = e end
+            end
+            entry.blocks[b.block_id] = probe
+          end
+        end
+      end
+    end
+    table.insert(out.sessions, entry)
+  end
+  return out
+end
+function ops.census()
+  local clients = try("client.list", { kinds = { "app" } })
+  local all, err = attach()
+  if not all then return nil, err end
+  local out = { clients = clients and clients.clients or {}, sessions = {} }
+  for _, s in ipairs(list(all.sessions)) do
+    local view = try("session.view", { session_id = s.session_id })
+    table.insert(out.sessions, { session_id = s.session_id, label = s.label, revision = view and view.revision, active = view and view.active_window_id })
+  end
+  return out
+end
+function ops.tail()
+  local session, err = locate(A.block)
+  if not session then return nil, err end
+  local size = method(session, A.block, "size")
+  local head, head_err = method(session, A.block, "format", { format = A.format, max_bytes = 1 })
+  if not head then return nil, head_err end
+  local content, total, start = head.content, head.total or #head.content, 0
+  if head.id then
+    start = math.max(0, total - A.bytes)
+    local parts, offset, first = {}, start, true
+    while true do
+      local r, read_err = method(session, A.block, "blob_read", { id = head.id, offset = offset, max_bytes = 983040 })
+      if not r then return nil, read_err end
+      table.insert(parts, r.data)
+      local consumed = #r.data
+      if first then consumed = consumed - 2 * leading_replacements(r.data) end
+      first = false
+      offset = offset + consumed
+      if r.eof or consumed <= 0 then break end
+    end
+    content = table.concat(parts)
+  end
+  return { content = content, total = total, start = start, rows = size and size.rows or 0 }
+end
+function ops.process()
+  local session, err = locate(A.block)
+  if not session then return nil, err end
+  return method(session, A.block, "process")
+end
+function ops.write()
+  local session, err = locate(A.block)
+  if not session then return nil, err end
+  if A.paste then
+    return try("block.event", { session_id = session, block_id = A.block, event = { type = "paste", payload = { text = A.text } } })
+  end
+  return method(session, A.block, "write", { data = A.text })
+end
+function ops.label_block()
+  local session, err = locate(A.block)
+  if not session then return nil, err end
+  return try("session.set_block_label", { session_id = session, block_id = A.block, label = A.label })
+end
+function ops.label_window()
+  local session, err = locate(A.window)
+  if not session then return nil, err end
+  return try("session.set_window_label", { session_id = session, window_id = A.window, label = A.label })
+end
+function ops.close_block()
+  local session, err = locate(A.block)
+  if not session then return nil, err end
+  return try("block.close", { session_id = session, block_id = A.block })
+end
+function ops.close_window()
+  local session, err = locate(A.window)
+  if not session then return nil, err end
+  return try("session.close_window", { session_id = session, window_id = A.window })
+end
+local op = ops[A.op]
+local value, err
+if op then value, err = op() else err = "unknown op " .. tostring(A.op) end
+print(rex.json.encode({ ok = value ~= nil, value = value, error = err }))
+`;
+
+export type RexOp =
+  | { readonly op: "snapshot" }
+  | { readonly op: "census" }
+  | { readonly op: "tail"; readonly block: string; readonly format: "vt" | "text"; readonly bytes: number }
+  | { readonly op: "process"; readonly block: string }
+  | { readonly op: "write"; readonly block: string; readonly text: string; readonly paste: boolean }
+  | { readonly op: "label_block"; readonly block: string; readonly label: string }
+  | { readonly op: "label_window"; readonly window: string; readonly label: string }
+  | { readonly op: "close_block"; readonly block: string }
+  | { readonly op: "close_window"; readonly window: string };
+
+function asObject(value: JsonValue | undefined): JsonObject {
+  return asJsonObject(value) ?? {};
+}
+
+function asArray(value: JsonValue | undefined): JsonValue[] {
+  return Array.isArray(value) ? value : [];
+}
+
+function strings(value: JsonValue | undefined): string[] {
+  return asArray(value).flatMap((item) => asJsonString(item) ?? []);
+}
+
+function str(record: JsonObject, key: string): string {
+  return asJsonString(record[key]) ?? "";
+}
+
+function maybeNum(record: JsonObject, key: string): number | null {
+  const value = asJsonNumber(record[key]);
+  return value !== undefined && Number.isFinite(value) ? value : null;
+}
+
+function num(record: JsonObject, key: string): number {
+  return maybeNum(record, key) ?? 0;
+}
+
+function bracketLevel(payload: string): string {
+  let level = "";
+  while (payload.includes(`]${level}]`)) level += "=";
+  return level;
+}
+
+export function rexScript(op: RexOp): string {
+  const payload = JSON.stringify({ ...op, terminal: TERMINAL_CREATOR });
+  const level = bracketLevel(payload);
+  return `local ARGS = [${level}[${payload}]${level}]\n${REX_PROGRAM}`;
+}
+
+export type RexAnswer = { readonly ok: true; readonly value: JsonValue } | { readonly ok: false; readonly error: string };
+
+export function parseAnswer(stdout: string): RexAnswer | null {
+  const line = stdout.trim().split("\n").at(-1) ?? "";
+  const parsed = parseJson(line);
+  if (parsed === undefined) return null;
+  const answer = asObject(parsed);
+  if (answer.ok === true) return { ok: true, value: answer.value ?? null };
+  return { ok: false, error: str(answer, "error") || "Rex answered without a value" };
+}
+
+export function errorCode(message: string): string | null {
+  return /\(status=\d+ code=([a-z_]+)\)/u.exec(message)?.[1] ?? null;
+}
+
+export interface RexProcessEntry {
+  readonly pid: number;
+  readonly name: string;
+  readonly argv0: string;
+  readonly script: string;
+  readonly cwd: string;
+}
+
+export interface RexProcess {
+  readonly foreground: RexProcessEntry | null;
+  readonly ancestors: readonly RexProcessEntry[];
+  readonly exited: boolean;
+}
+
+export interface RexStatusRecord {
+  readonly id: string;
+  readonly state: string;
+  readonly app: string;
+  readonly updatedAt: string;
+  readonly ownerPid: number;
+}
+
+export interface RexBlockInfo {
+  readonly process: RexProcess | null;
+  readonly title: string;
+  readonly records: readonly RexStatusRecord[];
+}
+
+export interface RexBlock {
+  readonly blockId: string;
+  readonly creator: string;
+  readonly hostId: string;
+  readonly label: string;
+}
+
+export interface RexWindow {
+  readonly windowId: string;
+  readonly label: string;
+  readonly focusedBlockId: string;
+  readonly blocks: readonly RexBlock[];
+}
+
+export interface RexSessionView {
+  readonly sessionId: string;
+  readonly label: string;
+  readonly activeWindowId: string;
+  readonly windows: readonly RexWindow[];
+  readonly blocks: ReadonlyMap<string, RexBlockInfo>;
+}
+
+export interface RexClient {
+  readonly clientId: string;
+  readonly kind: string;
+  readonly sessionIds: readonly string[];
+  readonly state: string;
+}
+
+export interface RexRawSnapshot {
+  readonly hostId: string;
+  readonly clients: readonly RexClient[];
+  readonly sessions: readonly RexSessionView[];
+}
+
+export interface RexCensusSession {
+  readonly sessionId: string;
+  readonly label: string;
+  readonly revision: number | null;
+  readonly active: string;
+}
+
+export interface RexCensus {
+  readonly clients: readonly RexClient[];
+  readonly sessions: readonly RexCensusSession[];
+}
+
+export interface RexTail {
+  readonly content: string;
+  readonly total: number;
+  readonly start: number;
+  readonly rows: number;
+}
+
+export interface RexCreatedWindow {
+  readonly windowId: string;
+  readonly blockIds: readonly string[];
+}
+
+function decodeEntry(value: JsonValue | undefined): RexProcessEntry | null {
+  if (value === null || value === undefined) return null;
+  const entry = asObject(value);
+  return { pid: num(entry, "pid"), name: str(entry, "name"), argv0: str(entry, "argv0"), script: str(entry, "script"), cwd: str(entry, "cwd") };
+}
+
+export function decodeProcess(value: JsonValue | undefined): RexProcess | null {
+  if (value === null || value === undefined) return null;
+  const process = asObject(value);
+  const ancestors: RexProcessEntry[] = [];
+  for (const raw of asArray(process.ancestors)) {
+    const entry = decodeEntry(raw);
+    if (entry !== null) ancestors.push(entry);
+  }
+  const lastExit = process.last_exit;
+  return { foreground: decodeEntry(process.foreground), ancestors, exited: lastExit !== undefined && lastExit !== null };
+}
+
+function decodeRecord(value: JsonValue): RexStatusRecord {
+  const record = asObject(value);
+  return {
+    id: str(record, "id"),
+    state: str(record, "state"),
+    app: str(record, "effective_app") || str(record, "app"),
+    updatedAt: str(record, "updated_at"),
+    ownerPid: num(asObject(record.owner), "pid"),
+  };
+}
+
+function decodeBlockInfo(value: JsonValue | undefined): RexBlockInfo {
+  const info = asObject(value);
+  return {
+    process: decodeProcess(info.process),
+    title: str(asObject(info.title), "title").trim(),
+    records: asArray(asObject(info.program_status).records).map(decodeRecord),
+  };
+}
+
+function decodeWindow(value: JsonValue): RexWindow {
+  const window = asObject(value);
+  const blocks: RexBlock[] = [];
+  for (const layer of asArray(window.layers)) {
+    for (const raw of asArray(asObject(layer).blocks)) {
+      const block = asObject(raw);
+      blocks.push({ blockId: str(block, "block_id"), creator: str(block, "creator_name"), hostId: str(block, "host_id"), label: str(block, "label") });
+    }
+  }
+  return { windowId: str(window, "window_id"), label: str(window, "label"), focusedBlockId: str(window, "focused_block_id"), blocks };
+}
+
+function decodeClient(value: JsonValue): RexClient {
+  const client = asObject(value);
+  return {
+    clientId: str(client, "client_id"),
+    kind: str(asObject(client.info), "kind"),
+    sessionIds: strings(client.session_ids),
+    state: str(client, "connection_state"),
+  };
+}
+
+export function decodeSnapshot(value: JsonValue): RexRawSnapshot {
+  const raw = asObject(value);
+  const sessions: RexSessionView[] = [];
+  for (const entry of asArray(raw.sessions)) {
+    const session = asObject(entry);
+    if (session.view === undefined || session.view === null) continue;
+    const view = asObject(session.view);
+    const blocks = new Map<string, RexBlockInfo>();
+    for (const [blockId, info] of Object.entries(asObject(session.blocks))) blocks.set(blockId, decodeBlockInfo(info));
+    sessions.push({
+      sessionId: str(session, "session_id"),
+      label: str(session, "label"),
+      activeWindowId: str(view, "active_window_id"),
+      windows: asArray(view.windows).map(decodeWindow),
+      blocks,
+    });
+  }
+  return { hostId: str(raw, "host_id"), clients: asArray(raw.clients).map(decodeClient), sessions };
+}
+
+export function decodeCensus(value: JsonValue): RexCensus {
+  const raw = asObject(value);
+  return {
+    clients: asArray(raw.clients).map(decodeClient),
+    sessions: asArray(raw.sessions).map((entry) => {
+      const session = asObject(entry);
+      return { sessionId: str(session, "session_id"), label: str(session, "label"), revision: maybeNum(session, "revision"), active: str(session, "active") };
+    }),
+  };
+}
+
+export function decodeTail(value: JsonValue): RexTail {
+  const raw = asObject(value);
+  return { content: str(raw, "content"), total: num(raw, "total"), start: num(raw, "start"), rows: num(raw, "rows") };
+}
+
+export function decodeCreatedWindow(stdout: string): RexCreatedWindow | null {
+  const raw = asObject(parseJson(stdout.trim()));
+  const windowId = str(raw, "window_id");
+  const blockIds = strings(raw.block_ids);
+  return windowId === "" || blockIds.length === 0 ? null : { windowId, blockIds };
+}
+
+export function censusSignature(census: RexCensus): string {
+  const parts = census.sessions.map((session) => `s:${session.sessionId}:${session.label}:${String(session.revision ?? "")}:${session.active}`);
+  for (const client of census.clients) {
+    if (client.kind === "app") parts.push(`c:${client.clientId}:${client.state}:${client.sessionIds.join(",")}`);
+  }
+  return parts.join(";");
+}
+
+export interface RexEvent {
+  readonly type: string;
+  readonly session: string;
+  readonly sessionEvent: string;
+  readonly block: string;
+  readonly creator: string;
+  readonly blockEvent: string;
+  readonly clientId: string;
+  readonly clientKind: string;
+  readonly revision: number | null;
+  readonly record: RexStatusRecord | null;
+  readonly foreground: RexProcessEntry | null;
+}
+
+export function parseEvent(line: string): RexEvent | null {
+  const parsed = parseJson(line);
+  if (parsed === undefined) return null;
+  const top = asObject(parsed);
+  const type = str(top, "type");
+  if (type === "") return null;
+  const payload = asObject(top.payload);
+  const client = asObject(payload.client);
+  const inner = type === "session_event" ? asObject(payload.event) : {};
+  const innerPayload = asObject(inner.payload);
+  const isBlock = str(inner, "type") === "block_event";
+  const blockPayload = isBlock ? asObject(innerPayload.payload) : {};
+  const record = blockPayload.record === undefined ? null : decodeRecord(blockPayload.record);
+  const foreground = isBlock && str(innerPayload, "name") === "process_changed" ? decodeEntry(blockPayload.foreground) : null;
+  return {
+    type,
+    session: str(payload, "session_id"),
+    sessionEvent: str(inner, "type"),
+    block: isBlock ? str(innerPayload, "block_id") : "",
+    creator: isBlock ? str(innerPayload, "creator_name") : "",
+    blockEvent: isBlock ? str(innerPayload, "name") : "",
+    clientId: str(client, "client_id") || str(payload, "client_id") || str(innerPayload, "client_id"),
+    clientKind: str(asObject(client.info), "kind"),
+    revision: maybeNum(innerPayload, "revision"),
+    record,
+    foreground,
+  };
+}
diff --git a/bridge/mux/rex/refusal.ts b/bridge/mux/rex/refusal.ts
new file mode 100644
index 00000000..2f15494d
--- /dev/null
+++ b/bridge/mux/rex/refusal.ts
@@ -0,0 +1,34 @@
+import { muxGone, muxRefused, muxUnconfirmed, muxUnreachable, type MuxRefusalOutcome } from "../types.ts";
+import { NO_BINARY_CODE, TIMED_OUT_CODE } from "./exec.ts";
+import { errorCode } from "./protocol.ts";
+
+export const NO_SERVER_CODE = 4;
+export const TARGET_NOT_FOUND_CODE = 3;
+
+const TRANSPORT_WORDS = /no Rex server is running|connecting to Rex server|connection refused|operation not permitted|broken pipe|unexpected EOF|use of closed network connection|stream is closed/iu;
+
+export function saysUnreachable(code: number, stderr: string): boolean {
+  if (code === NO_BINARY_CODE || code === TIMED_OUT_CODE || code === NO_SERVER_CODE) return true;
+  return TRANSPORT_WORDS.test(stderr);
+}
+
+export function saysGone(text: string): boolean {
+  const code = errorCode(text);
+  if (code !== null) return code === "not_found" || code === "session_not_found";
+  return /target "[^"]*" not found/u.test(text);
+}
+
+export function refusalForRun(code: number, stderr: string, opts: { readonly write?: boolean } = {}): MuxRefusalOutcome {
+  const detail = stderr.trim() || `rex exited ${String(code)}`;
+  if (code === TIMED_OUT_CODE && opts.write === true) return muxUnconfirmed(detail);
+  if (saysUnreachable(code, stderr)) return muxUnreachable(detail);
+  if (code === TARGET_NOT_FOUND_CODE || saysGone(stderr)) return muxGone(detail);
+  return muxRefused(detail);
+}
+
+export function refusalForAnswer(error: string, opts: { readonly write?: boolean } = {}): MuxRefusalOutcome {
+  if (errorCode(error) === "timeout" && opts.write === true) return muxUnconfirmed(error);
+  if (saysGone(error)) return muxGone(error);
+  if (TRANSPORT_WORDS.test(error)) return muxUnreachable(error);
+  return muxRefused(error);
+}
diff --git a/bridge/mux/rex/watch.ts b/bridge/mux/rex/watch.ts
new file mode 100644
index 00000000..5783981c
--- /dev/null
+++ b/bridge/mux/rex/watch.ts
@@ -0,0 +1,227 @@
+import { agentForApp, agentStatus } from "../herdr-core/layout.ts";
+import type { MuxSubscription, MuxWatchOptions } from "../types.ts";
+import type { RexExec, RexStreamClient } from "./exec.ts";
+import { censusSignature, decodeCensus, parseAnswer, parseEvent, rexScript, TERMINAL_CREATOR, type RexEvent } from "./protocol.ts";
+import { TIMED_OUT_CODE } from "./exec.ts";
+import { saysUnreachable } from "./refusal.ts";
+
+export const RESYNC_MS = 5000;
+export const RESYNC_IDLE_MS = 60_000;
+
+export type WatchTimer = ReturnType<typeof setTimeout>;
+
+export interface WatchClock {
+  setInterval(fn: () => void, ms: number): WatchTimer;
+  clearInterval(handle: WatchTimer): void;
+}
+
+export const REAL_CLOCK: WatchClock = {
+  setInterval: (fn, ms) => {
+    const handle = setInterval(fn, ms);
+    handle.unref();
+    return handle;
+  },
+  clearInterval: (handle) => clearInterval(handle),
+};
+
+const TOPOLOGY_SERVER_EVENTS: ReadonlySet<string> = new Set(["session_created", "session_destroyed", "session_moved", "session_label_changed"]);
+
+const TOPOLOGY_SESSION_EVENTS: ReadonlySet<string> = new Set([
+  "window_created",
+  "window_closed",
+  "window_moved",
+  "window_label_changed",
+  "block_created",
+  "block_closed",
+  "block_moved",
+  "block_detached",
+  "block_label_changed",
+  "layer_created",
+  "layer_closed",
+  "active_window_changed",
+  "session_label_changed",
+  "creator_changed",
+]);
+
+const PANE_ONLY_BLOCK_EVENTS: ReadonlySet<string> = new Set(["bell", "desktop_notification"]);
+
+const SNAPSHOT_BLOCK_EVENTS: ReadonlySet<string> = new Set(["title_changed", "pwd_changed", "child_exited"]);
+
+function statusKey(event: RexEvent): string {
+  if (event.blockEvent === "program_status_removed" || event.record === null) return "removed";
+  const agent = agentForApp(event.record.app) ?? "";
+  return `${agent}|${agent === "" ? "" : agentStatus(event.record.state)}`;
+}
+
+function processKey(event: RexEvent): string {
+  const foreground = event.foreground;
+  return foreground === null ? "" : `${String(foreground.pid)}|${foreground.name}|${foreground.cwd}`;
+}
+
+export class RexWatch implements MuxSubscription {
+  private client: RexStreamClient | null = null;
+  private timer: WatchTimer | null = null;
+  private closed = false;
+  private up = false;
+  private syncing = false;
+  private lastCensus: string | null = null;
+  private idleTicks = 0;
+  private readonly watched: ReadonlySet<string>;
+  private readonly apps = new Set<string>();
+  private readonly statuses = new Map<string, string>();
+  private readonly processes = new Map<string, string>();
+  private readonly views = new Map<string, number>();
+
+  constructor(
+    private readonly exec: RexExec,
+    private readonly options: MuxWatchOptions,
+    private readonly clock: WatchClock = REAL_CLOCK,
+  ) {
+    this.watched = new Set(options.panes);
+    this.start();
+  }
+
+  private start(): void {
+    this.client = this.exec.events({
+      onLine: (line) => this.handleLine(line),
+      onExit: (reason) => this.end(reason),
+    });
+    if (this.closed) {
+      this.client.kill();
+      this.client = null;
+      return;
+    }
+    this.timer = this.clock.setInterval(() => this.tick(), RESYNC_MS);
+    void this.census();
+  }
+
+  private handleLine(line: string): void {
+    if (this.closed) return;
+    const event = parseEvent(line);
+    if (event !== null) this.route(event);
+  }
+
+  private route(event: RexEvent): void {
+    if (event.type === "client_joined") {
+      if (event.clientKind !== "app") return;
+      this.apps.add(event.clientId);
+      this.options.onTopologyChange();
+      return;
+    }
+    if (event.type === "client_left" || event.type === "client_changed") {
+      if (!this.apps.has(event.clientId)) return;
+      if (event.type === "client_left") this.apps.delete(event.clientId);
+      this.options.onTopologyChange();
+      return;
+    }
+    if (TOPOLOGY_SERVER_EVENTS.has(event.type)) {
+      this.options.onTopologyChange();
+      return;
+    }
+    if (event.type !== "session_event") return;
+    this.routeSession(event);
+  }
+
+  private routeSession(event: RexEvent): void {
+    const kind = event.sessionEvent;
+    if (kind === "client_connected" || kind === "client_disconnected") {
+      if (this.apps.has(event.clientId)) this.options.onTopologyChange();
+      return;
+    }
+    if (kind === "session_view_changed") {
+      const seen = this.views.get(event.session);
+      if (event.revision !== null && seen !== undefined && event.revision <= seen) return;
+      if (event.revision !== null) this.views.set(event.session, event.revision);
+      this.options.onTopologyChange();
+      return;
+    }
+    if (TOPOLOGY_SESSION_EVENTS.has(kind)) {
+      this.options.onTopologyChange();
+      return;
+    }
+    if (kind === "block_event" && event.creator === TERMINAL_CREATOR && event.block !== "") this.routeBlock(event);
+  }
+
+  private routeBlock(event: RexEvent): void {
+    const block = event.block;
+    const name = event.blockEvent;
+    if (PANE_ONLY_BLOCK_EVENTS.has(name)) {
+      this.pane(block);
+      return;
+    }
+    if (SNAPSHOT_BLOCK_EVENTS.has(name)) {
+      this.changed(block);
+      return;
+    }
+    if (name === "program_status_changed" || name === "program_status_removed") {
+      this.changedOnce(this.statuses, block, statusKey(event));
+      return;
+    }
+    if (name === "process_changed") this.changedOnce(this.processes, block, processKey(event));
+  }
+
+  private changedOnce(seen: Map<string, string>, block: string, key: string): void {
+    if (seen.get(block) === key) return;
+    seen.set(block, key);
+    this.changed(block);
+  }
+
+  private changed(block: string): void {
+    this.options.onTopologyChange();
+    this.pane(block);
+  }
+
+  private pane(block: string): void {
+    if (this.watched.has(block)) this.options.onPaneChange(block);
+  }
+
+  private tick(): void {
+    if (this.options.attention?.() !== "watched" && ++this.idleTicks * RESYNC_MS < RESYNC_IDLE_MS) return;
+    this.idleTicks = 0;
+    void this.census();
+  }
+
+  private async census(): Promise<void> {
+    if (this.closed || this.syncing) return;
+    this.syncing = true;
+    try {
+      const res = await this.exec.run(["do", "-"], rexScript({ op: "census" }));
+      if (this.closed) return;
+      const answer = res.code === 0 ? parseAnswer(res.stdout) : null;
+      if (answer === null || !answer.ok) {
+        const detail = answer !== null && !answer.ok ? answer.error : res.stderr.trim() || `rex exited ${String(res.code)}`;
+        const slow = this.up && res.code === TIMED_OUT_CODE;
+        if (!this.up || (!slow && saysUnreachable(res.code, res.stderr))) this.end(detail);
+        return;
+      }
+      const signature = censusSignature(decodeCensus(answer.value));
+      if (!this.up) {
+        this.up = true;
+        this.options.onUp();
+      }
+      if (this.lastCensus !== null && this.lastCensus !== signature) this.options.onTopologyChange();
+      this.lastCensus = signature;
+    } catch {
+      return;
+    } finally {
+      this.syncing = false;
+    }
+  }
+
+  private end(reason: string): void {
+    if (this.closed) return;
+    this.closed = true;
+    if (this.timer !== null) {
+      this.clock.clearInterval(this.timer);
+      this.timer = null;
+    }
+    const client = this.client;
+    this.client = null;
+    client?.kill();
+    this.options.onDown(reason);
+  }
+
+  close(): void {
+    this.end("closed");
+  }
+}
