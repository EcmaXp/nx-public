diff --git a/bridge/state-engine-unwatched.test.ts b/bridge/state-engine-unwatched.test.ts
new file mode 100644
index 00000000..23d45e97
--- /dev/null
+++ b/bridge/state-engine-unwatched.test.ts
@@ -0,0 +1,123 @@
+import { describe, expect, test } from "bun:test";
+
+import { ATTENTION_WINDOW_MS, StateEngine, UNWATCHED_POLL_MS } from "./state-engine.ts";
+import { muxOk, muxUnreachable } from "./mux/types.ts";
+import type { MuxAdapter, MuxPane } from "./mux/types.ts";
+import type { AgentStatus } from "./types.ts";
+
+const RELAXED = 12_000;
+const settle = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+function claudePane(paneId: string, status: AgentStatus): MuxPane {
+  return { paneId, spaceId: "$0", spaceLabel: "s", spaceNumber: 1, tabId: "@0", cwd: "/w", focused: false, alive: true, agent: "claude", status };
+}
+
+function harness(opts: { unwatched?: boolean } = {}) {
+  const reads: string[] = [];
+  const fake = { panes: [claudePane("%1", "working"), claudePane("%2", "working")], reads, up: true };
+  const stub: Partial<MuxAdapter> = {
+    reachable: () => Promise.resolve(fake.up),
+    snapshot: () => (fake.up ? Promise.resolve({ panes: fake.panes, spaces: [], tabs: [] }) : Promise.reject(muxUnreachable("down"))),
+    readGrid: (paneId: string) => {
+      fake.reads.push(paneId);
+      return Promise.resolve(muxOk({ paneId, text: "", truncated: false, revision: 0 }));
+    },
+  };
+  // SAFETY: a poll reaches only `reachable`, `snapshot` and `readGrid`, all present on the stub.
+  const engine = new StateEngine(stub as MuxAdapter, 1500, opts.unwatched === false ? {} : { unwatchedPollMs: UNWATCHED_POLL_MS });
+  engine["started"] = true;
+  const poll = () => engine["poll"]();
+  const cadence = () => engine["cadenceMs"];
+  const lookAway = () => engine.noteAttention(Date.now() - ATTENTION_WINDOW_MS - 1);
+  return { fake, engine, poll, cadence, lookAway };
+}
+
+describe("StateEngine: nobody watching", () => {
+  test("a connected engine nobody reads polls at the unwatched cadence, and a read brings the relaxed one back at once", async () => {
+    const { engine, poll, cadence } = harness();
+    await poll();
+    engine.setCadence(RELAXED);
+    expect(cadence()).toBe(UNWATCHED_POLL_MS);
+    let poked = 0;
+    engine["poll"] = () => {
+      poked++;
+      return Promise.resolve();
+    };
+    engine.noteAttention();
+    expect(cadence()).toBe(RELAXED);
+    expect(poked).toBe(1);
+    engine.noteAttention();
+    expect(poked).toBe(1);
+    engine.stop();
+  });
+
+  test("an event stream that drops while nobody reads stays at the unwatched cadence", async () => {
+    const { engine, poll, cadence } = harness();
+    await poll();
+    engine.setCadence(1500);
+    expect(cadence()).toBe(UNWATCHED_POLL_MS);
+    engine.stop();
+  });
+
+  test("an engine that has never connected keeps the fast retry even when nobody reads", async () => {
+    const { fake, engine, poll, cadence } = harness();
+    fake.up = false;
+    await poll();
+    expect(cadence()).toBe(1500);
+    engine.stop();
+  });
+
+  test("a poll that fails after the engine connected retries at the unwatched cadence while nobody reads", async () => {
+    const { fake, engine, poll, cadence } = harness();
+    await poll();
+    fake.up = false;
+    await poll();
+    expect(engine.current().bridge).not.toBe("connected");
+    expect(cadence()).toBe(UNWATCHED_POLL_MS);
+    engine.noteAttention();
+    await settle();
+    expect(cadence()).toBe(1500);
+    engine.stop();
+  });
+
+  test("attention lapsing relaxes the engine on its next poll", async () => {
+    const { engine, poll, cadence, lookAway } = harness();
+    await poll();
+    engine.noteAttention();
+    await settle();
+    engine.setCadence(RELAXED);
+    expect(cadence()).toBe(RELAXED);
+    lookAway();
+    await poll();
+    expect(cadence()).toBe(UNWATCHED_POLL_MS);
+    engine.stop();
+  });
+
+  test("nobody reading, only a pane whose status moved has its screen read", async () => {
+    const { fake, engine, poll } = harness();
+    await poll();
+    expect(fake.reads.toSorted()).toEqual(["%1", "%2"]);
+    fake.reads.length = 0;
+    await poll();
+    expect(fake.reads).toEqual([]);
+    fake.panes = [claudePane("%1", "blocked"), claudePane("%2", "working")];
+    await poll();
+    expect(fake.reads).toEqual(["%1"]);
+    fake.reads.length = 0;
+    engine.noteAttention();
+    await settle();
+    expect(fake.reads.toSorted()).toEqual(["%1", "%2"]);
+    engine.stop();
+  });
+
+  test("an engine built without an unwatched cadence ignores attention, as before", async () => {
+    const { fake, engine, poll, cadence } = harness({ unwatched: false });
+    await poll();
+    engine.setCadence(RELAXED);
+    expect(cadence()).toBe(RELAXED);
+    fake.reads.length = 0;
+    await poll();
+    expect(fake.reads.toSorted()).toEqual(["%1", "%2"]);
+    engine.stop();
+  });
+});
