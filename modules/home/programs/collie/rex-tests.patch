diff --git a/bridge/mux/rex/adapter.test.ts b/bridge/mux/rex/adapter.test.ts
new file mode 100644
index 00000000..76e44c2b
--- /dev/null
+++ b/bridge/mux/rex/adapter.test.ts
@@ -0,0 +1,191 @@
+import { describe, expect, test } from "bun:test";
+
+import { RexMux, rexMuxFactory, type RexSessionLookup } from "./adapter.ts";
+import type { RexExec, RexRunResult } from "./exec.ts";
+import { FAKE_CLAUDE_PID, FAKE_CLAUDE_SESSION, FakeRex, fakeClaudeSessions, parseRexScript } from "./fixture.ts";
+import { MAX_WRITE_JSON_BYTES, type RexOp } from "./protocol.ts";
+
+interface RecordedCall {
+  readonly args: readonly string[];
+  readonly stdin?: string;
+}
+
+interface Answering {
+  readonly exec: RexExec;
+  readonly calls: RecordedCall[];
+}
+
+function answering(result: RexRunResult): Answering {
+  const calls: RecordedCall[] = [];
+  return {
+    calls,
+    exec: {
+      run: (args, stdin) => {
+        calls.push({ args, stdin });
+        return Promise.resolve(result);
+      },
+      events: () => ({ kill: () => undefined }),
+    },
+  };
+}
+
+function spyingOps(fake: FakeRex, onOp: (op: RexOp) => void): RexExec {
+  return {
+    run: (args, stdin) => {
+      const op = stdin === undefined ? null : parseRexScript(stdin);
+      if (op !== null) onOp(op);
+      return fake.run(args, stdin);
+    },
+    events: (h) => fake.events(h),
+  };
+}
+
+async function firstPane(adapter: RexMux, agent = "claude"): Promise<string> {
+  const pane = (await adapter.snapshot()).panes.find((p) => p.agent === agent);
+  if (pane === undefined) throw new Error(`no ${agent} pane`);
+  return pane.paneId;
+}
+
+describe("typing", () => {
+  test("one line is typed, and a line break makes it a paste so nothing is submitted", async () => {
+    const fake = new FakeRex();
+    const adapter = new RexMux(fake);
+    const pane = await firstPane(adapter);
+    const ops: RexOp[] = [];
+    const spied = new RexMux(spyingOps(fake, (op) => ops.push(op)));
+    expect((await spied.typeText(pane, "hello")).ok).toBe(true);
+    expect((await spied.typeText(pane, "two\nlines")).ok).toBe(true);
+    expect(ops).toMatchObject([{ op: "write", paste: false }, { op: "write", paste: true }]);
+  });
+
+  test("a message past Rex's request limit is refused whole, never split", async () => {
+    const { exec, calls } = answering({ code: 0, stdout: "", stderr: "" });
+    const sent = await new RexMux(exec).typeText("block:x", "x".repeat(MAX_WRITE_JSON_BYTES));
+    expect(sent).toMatchObject({ ok: false, reason: "refused" });
+    expect(calls).toHaveLength(0);
+  });
+
+  test("a write that ran out of time may still land, so it is unconfirmed", async () => {
+    const { exec } = answering({ code: 143, stdout: "", stderr: "rex did not answer `do -` within 5000ms and was killed" });
+    expect(await new RexMux(exec).typeText("block:x", "hi")).toMatchObject({ ok: false, reason: "unconfirmed" });
+  });
+});
+
+describe("keys", () => {
+  test("translated keys go to send-key in one call, after --", async () => {
+    const { exec, calls } = answering({ code: 0, stdout: "", stderr: "" });
+    expect((await new RexMux(exec).writeKeys("block:x", ["ctrl+c", "A", "?", "Enter"])).ok).toBe(true);
+    expect(calls[0]?.args).toEqual(["send-key", "-b", "block:x", "--", "ctrl+c", "shift+a", "shift+/", "enter"]);
+  });
+
+  test("one key Rex cannot send refuses the batch before anything is sent", async () => {
+    const { exec, calls } = answering({ code: 0, stdout: "", stderr: "" });
+    expect(await new RexMux(exec).writeKeys("block:x", ["a", "meta+v"])).toMatchObject({ ok: false, reason: "refused" });
+    expect(calls).toHaveLength(0);
+  });
+});
+
+describe("refusals", () => {
+  test("a missing target is gone, a missing server unreachable", async () => {
+    expect(await new RexMux(answering({ code: 3, stdout: "", stderr: 'Error: block target "block:x" not found' }).exec).writeKeys("block:x", ["a"]))
+      .toMatchObject({ reason: "gone" });
+    expect(await new RexMux(answering({ code: 4, stdout: "", stderr: "Error: no Rex server is running at /s, and autostart is disabled" }).exec).closePane("block:x"))
+      .toMatchObject({ reason: "unreachable" });
+  });
+
+  test("a label longer than Rex takes is refused before it is sent", async () => {
+    const { exec, calls } = answering({ code: 0, stdout: "", stderr: "" });
+    expect(await new RexMux(exec).renameTab("window:x", "x".repeat(129))).toMatchObject({ reason: "refused" });
+    expect(calls).toHaveLength(0);
+  });
+});
+
+describe("structure", () => {
+  test("a new tab never moves the active window and opens where it was asked", async () => {
+    const fake = new FakeRex();
+    const adapter = new RexMux(fake);
+    const space = (await adapter.snapshot()).spaces[0];
+    if (space === undefined) throw new Error("no space");
+    const created = await adapter.createTab({ spaceId: space.spaceId, cwd: "/srv/x", label: "fresh" });
+    expect(created.ok).toBe(true);
+    expect(fake.calls.find((call) => call.startsWith("window new"))).toBe(`window new -s ${space.spaceId} --focus=false --json -c /srv/x`);
+    const after = await adapter.snapshot();
+    expect(after.spaces[0]?.activeTabId).toBe(space.activeTabId);
+    if (created.ok) expect(after.tabs.find((tab) => tab.tabId === created.value.tabId)?.label).toBe("fresh");
+  });
+
+  test("clearing a pane label restores Rex's default, which reads as no label", async () => {
+    const fake = new FakeRex();
+    const adapter = new RexMux(fake);
+    const pane = await firstPane(adapter);
+    await adapter.renamePane(pane, "mine");
+    expect((await adapter.snapshot()).panes.find((p) => p.paneId === pane)?.paneLabel).toBe("mine");
+    await adapter.renamePane(pane, null);
+    expect((await adapter.snapshot()).panes.find((p) => p.paneId === pane)?.paneLabel).toBeUndefined();
+  });
+});
+
+describe("reading the grid", () => {
+  test("the revision follows the screen, whatever styling or depth was asked for", async () => {
+    const fake = new FakeRex();
+    const adapter = new RexMux(fake);
+    const pane = await firstPane(adapter);
+    const a = await adapter.readGrid(pane, { scope: "viewport", lines: 24, styling: "preserve" });
+    const b = await adapter.readGrid(pane, { scope: "recent", lines: 200, styling: "strip" });
+    if (!a.ok || !b.ok) throw new Error("read failed");
+    expect(a.value.revision).toBe(b.value.revision);
+    await fake.changePane(pane);
+    const c = await adapter.readGrid(pane, { scope: "viewport", lines: 24, styling: "preserve" });
+    if (!c.ok) throw new Error("read failed");
+    expect(c.value.revision).toBe(a.value.revision + 1);
+  });
+
+  test("a strip read asks Rex for vt too, because Rex's text format drops a shell's blank screen rows", async () => {
+    const fake = new FakeRex();
+    const pane = await firstPane(new RexMux(fake));
+    const formats: string[] = [];
+    const spy = spyingOps(fake, (op) => {
+      if (op.op === "tail") formats.push(op.format);
+    });
+    const grid = await new RexMux(spy).readGrid(pane, { scope: "viewport", lines: 24, styling: "strip" });
+    expect(formats).toEqual(["vt"]);
+    expect(grid.ok && grid.value.text.includes("\u001b[")).toBe(false);
+  });
+});
+
+describe("sessions", () => {
+  test("the pid that reported Claude's status is looked up, and its session reaches the Claude pane only", async () => {
+    const asked: number[] = [];
+    const inner = fakeClaudeSessions();
+    const lookup: RexSessionLookup = {
+      sessionFor: (pid) => {
+        asked.push(pid);
+        return inner.sessionFor(pid);
+      },
+    };
+    const snapshot = await new RexMux(new FakeRex(), lookup).snapshot();
+    expect(asked).toEqual([FAKE_CLAUDE_PID]);
+    expect(snapshot.panes.filter((pane) => pane.agentSession !== undefined).map((pane) => [pane.agent, pane.agentSession?.value])).toEqual([
+      ["claude", FAKE_CLAUDE_SESSION],
+    ]);
+  });
+
+  test("a lookup that fails leaves the pane without a session and the snapshot still answers", async () => {
+    const failing: RexSessionLookup = { sessionFor: () => Promise.reject(new Error("unreadable")) };
+    const snapshot = await new RexMux(new FakeRex(), failing).snapshot();
+    expect(snapshot.panes.some((pane) => pane.agent === "claude")).toBe(true);
+    expect(snapshot.panes.every((pane) => pane.agentSession === undefined)).toBe(true);
+  });
+
+  test("without a lookup no pane carries a session", async () => {
+    const snapshot = await new RexMux(new FakeRex()).snapshot();
+    expect(snapshot.panes.every((pane) => pane.agentSession === undefined)).toBe(true);
+  });
+});
+
+describe("rexMuxFactory", () => {
+  test("names the socket it was given, or Rex's own default", () => {
+    expect(rexMuxFactory.describeTarget?.("")).toBe("its default socket");
+    expect(rexMuxFactory.describeTarget?.("/tmp/r.sock")).toBe("socket /tmp/r.sock");
+  });
+});
