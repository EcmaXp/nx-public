@@ -0,0 +1,188 @@
+import { describe, expect, test } from "bun:test";
+
+import type { AgentSessionRef } from "../../journal/types.ts";
+import type { JsonValue } from "../../json.ts";
+import {
+  isDefaultBlockLabel,
+  isDefaultWindowLabel,
+  normalizeGrid,
+  paneAgent,
+  reportedRecord,
+  sessionPid,
+  sessionPids,
+  toSnapshot,
+} from "./layout.ts";
+import { decodeSnapshot, type RexBlockInfo, type RexStatusRecord } from "./protocol.ts";
+
+const HOST = "host-a";
+const S1 = "session:01a19088-30a3-7261-abed-000000000001";
+const S2 = "session:01a19088-30a3-7261-abed-000000000002";
+const W1 = "window:01a19088-30a3-7261-abed-0000000000a1";
+const W2 = "window:01a19088-30a3-7261-abed-0000000000a2";
+const B1 = "block:01a19088-30a3-7261-abed-0000000000b1";
+const B2 = "block:01a19088-30a3-7261-abed-0000000000b2";
+const B3 = "block:01a19088-30a3-7261-abed-0000000000b3";
+const TERMINAL = "com.superlogical.terminal";
+
+function wireRecord(state: string, app = "claude-code", pid = 41) {
+  return { state, app, effective_app: app, updated_at: "2026-10-31T00:00:00Z", owner: { pid, name: "claude" } };
+}
+
+function record(state: string, id = "", updatedAt = "2026-10-31T00:00:00Z", app = "claude-code", ownerPid = 0): RexStatusRecord {
+  return { id, state, app, updatedAt, ownerPid };
+}
+
+function info(name: string, records: readonly RexStatusRecord[] = []): RexBlockInfo {
+  return { process: { foreground: { pid: 1, name, argv0: name, script: "", cwd: "/w" }, ancestors: [], exited: false }, title: "", records };
+}
+
+function world(clients: JsonValue) {
+  return decodeSnapshot({
+    host_id: HOST,
+    clients,
+    sessions: [
+      {
+        session_id: S1,
+        label: "one",
+        view: {
+          session_id: S1,
+          label: "one",
+          active_window_id: W1,
+          windows: [
+            {
+              window_id: W1,
+              label: `Window ${W1.slice(-8)}`,
+              focused_block_id: B1,
+              layers: [
+                {
+                  blocks: [
+                    { block_id: B1, creator_name: TERMINAL, host_id: HOST, label: "shell" },
+                    { block_id: B2, creator_name: TERMINAL, host_id: HOST, label: "mine" },
+                    { block_id: "block:x-onboarding", creator_name: "com.superlogical.onboarding", host_id: HOST },
+                    { block_id: "block:x-remote", creator_name: TERMINAL, host_id: "elsewhere" },
+                  ],
+                },
+              ],
+            },
+          ],
+        },
+        blocks: {
+          [B1]: { process: { foreground: { pid: 1, name: "claude", cwd: "/w" }, ancestors: {} }, program_status: { records: [wireRecord("working")] } },
+          [B2]: { process: { foreground: { pid: 2, name: "zsh", cwd: "/w" } }, program_status: { records: {} }, title: { title: "~/w" } },
+          "block:x-remote": { process: { foreground: { pid: 3, name: "claude", cwd: "/srv" } }, program_status: { records: [wireRecord("idle", "claude-code", 3)] } },
+        },
+      },
+      {
+        session_id: S2,
+        label: "two",
+        view: {
+          session_id: S2,
+          label: "two",
+          active_window_id: W2,
+          windows: [{ window_id: W2, label: "docs", focused_block_id: B3, layers: [{ blocks: [{ block_id: B3, creator_name: TERMINAL, host_id: HOST }] }] }],
+        },
+        blocks: { [B3]: { process: { foreground: null, last_exit: { exit_code: 0 } }, title: { title: "me@mac:~/w" } } },
+      },
+    ],
+  });
+}
+
+describe("agent and status", () => {
+  test("the root record wins, else the newest child", () => {
+    const child = record("working", "build", "2026-10-31T00:00:09Z");
+    const older = record("idle", "lint", "2026-10-31T00:00:01Z");
+    expect(reportedRecord([older, child])?.id).toBe("build");
+    expect(reportedRecord([child, record("blocked")])?.state).toBe("blocked");
+  });
+
+  test("a program that names an app Collie has no harness for is a shell, even running claude", () => {
+    expect(paneAgent(info("claude", [record("working", "", "2026-10-31T00:00:00Z", "cargo")]))).toEqual({ agent: "shell", status: "unknown" });
+  });
+
+  test("with no report, an exact foreground name is a provisional agent with no status", () => {
+    expect(paneAgent(info("codex"))).toEqual({ agent: "codex", status: "unknown" });
+    expect(paneAgent(info("codex-wrapper"))).toEqual({ agent: "shell", status: "unknown" });
+  });
+});
+
+describe("session pids", () => {
+  test("a Claude pane's pid is the one that reported its status, else its foreground process", () => {
+    expect(sessionPid(info("claude", [record("idle", "", "2026-10-31T00:00:00Z", "claude-code", 41)]))).toBe(41);
+    expect(sessionPid(info("claude"))).toBe(1);
+  });
+
+  test("only a Claude pane has a session pid", () => {
+    expect(sessionPid(info("codex"))).toBeNull();
+    expect(sessionPid(info("zsh"))).toBeNull();
+    expect(sessionPid(undefined)).toBeNull();
+  });
+
+  test("blocks of another host or creator are never looked up", () => {
+    expect([...sessionPids(world({}))]).toEqual([[B1, 41]]);
+  });
+});
+
+describe("labels", () => {
+  test("defaults made from the id are no one's name", () => {
+    expect(isDefaultWindowLabel(W1, `Window ${W1.slice(-8)}`)).toBe(true);
+    expect(isDefaultWindowLabel(W1, "Window 12345678")).toBe(false);
+    expect(isDefaultBlockLabel(B1, "shell")).toBe(true);
+    expect(isDefaultBlockLabel(B1, `Block ${B1.slice(-8)}`)).toBe(true);
+    expect(isDefaultBlockLabel(B1, "mine")).toBe(false);
+  });
+});
+
+describe("toSnapshot", () => {
+  test("a session ref lands on the pane it was looked up for, and nowhere else", () => {
+    const ref: AgentSessionRef = { kind: "id", value: "5f1d1c0e-8a3b-4c2d-9e7f-0a1b2c3d4e5f" };
+    const snapshot = toSnapshot(world({}), new Map([[B1, ref]]));
+    expect(snapshot.panes.find((pane) => pane.paneId === B1)?.agentSession).toEqual(ref);
+    expect(snapshot.panes.find((pane) => pane.paneId === B2)?.agentSession).toBeUndefined();
+    expect(toSnapshot(world({})).panes.every((pane) => pane.agentSession === undefined)).toBe(true);
+  });
+
+  test("drops other creators and other hosts, and counts what it publishes", () => {
+    const snapshot = toSnapshot(world({}));
+    expect(snapshot.panes.map((pane) => pane.paneId)).toEqual([B1, B2, B3]);
+    expect(snapshot.spaces[0]?.paneCount).toBe(2);
+    expect(snapshot.tabs[0]?.paneCount).toBe(2);
+  });
+
+  test("an app attached to exactly one session focuses its active window's focused block", () => {
+    const snapshot = toSnapshot(world([{ client_id: "client:a", info: { kind: "app" }, session_ids: [S1], connection_state: "connected" }]));
+    expect(snapshot.panes.filter((pane) => pane.focused).map((pane) => pane.paneId)).toEqual([B1]);
+    expect(snapshot.spaces.map((space) => space.focused)).toEqual([true, false]);
+  });
+
+  test("an app attached to several sessions says nothing about which it shows", () => {
+    const snapshot = toSnapshot(world([{ client_id: "client:a", info: { kind: "app" }, session_ids: [S1, S2] }]));
+    expect(snapshot.panes.some((pane) => pane.focused)).toBe(false);
+  });
+
+  test("CLI clients and lost apps never focus anything", () => {
+    const snapshot = toSnapshot(world([
+      { client_id: "client:c", info: { kind: "cli" }, session_ids: [S1] },
+      { client_id: "client:a", info: { kind: "app" }, session_ids: [S1], connection_state: "lost" },
+    ]));
+    expect(snapshot.panes.some((pane) => pane.focused)).toBe(false);
+  });
+
+  test("a block whose program exited is not alive, and an operator's label is its paneLabel", () => {
+    const snapshot = toSnapshot(world({}));
+    expect(snapshot.panes.find((pane) => pane.paneId === B3)?.alive).toBe(false);
+    expect(snapshot.panes.find((pane) => pane.paneId === B2)).toMatchObject({ paneLabel: "mine", terminalTitle: "~/w", foregroundCommand: "zsh" });
+    expect(snapshot.panes.find((pane) => pane.paneId === B1)?.paneLabel).toBeUndefined();
+    expect(snapshot.panes.find((pane) => pane.paneId === B1)).toMatchObject({ agent: "claude", status: "working" });
+  });
+
+  test("a title that only restates the shell's user, host and folder is no title", () => {
+    expect(toSnapshot(world({})).panes.find((pane) => pane.paneId === B3)?.terminalTitle).toBeUndefined();
+  });
+});
+
+describe("normalizeGrid", () => {
+  test("keeps SGR, expands ESC[nC, and drops every other escape", () => {
+    const raw = "\u001b[0m\u001b[1mhi\u001b[3Cthere\u001b[0m\r\n\u001b[?25l\u001b[2J\u001b]8;;http://x\u0007link\u001b]8;;\u0007\u001b[C!\r\n";
+    expect(normalizeGrid(raw)).toBe("\u001b[0m\u001b[1mhi   there\u001b[0m\nlink !\n");
+  });
+});
