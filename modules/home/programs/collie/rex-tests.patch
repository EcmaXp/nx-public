+        return { ok: true, value: {} };
+      }
+      case "close_window": {
+        const window = this.windows.get(op.window);
+        if (window === undefined) return this.notFound(op.window);
+        for (const id of window.blockIds) {
+          const block = this.blocks.get(id);
+          if (block) this.removeBlock(block);
+        }
+        return { ok: true, value: {} };
+      }
+    }
+  }
+
+  private removeBlock(block: FakeBlock): void {
+    this.blocks.delete(block.id);
+    const window = this.windows.get(block.windowId);
+    const session = this.sessions.get(block.sessionId);
+    this.emitSession(block.sessionId, "block_closed", { block_id: block.id });
+    if (window === undefined || session === undefined) return;
+    window.blockIds = window.blockIds.filter((id) => id !== block.id);
+    if (window.focusedBlock === block.id) window.focusedBlock = window.blockIds[0] ?? "";
+    if (window.blockIds.length === 0) {
+      this.windows.delete(window.id);
+      session.windowIds = session.windowIds.filter((id) => id !== window.id);
+      if (session.activeWindow === window.id) session.activeWindow = session.windowIds[0] ?? "";
+      this.emitSession(session.id, "window_closed", { window_id: window.id });
+    }
+    this.bump(session, true);
+  }
+
+  private process(block: FakeBlock) {
+    return {
+      foreground: block.foreground === null ? null : { ...block.foreground, user: "dev", user_id: 1000 },
+      ancestors: [],
+      home: "/home/dev",
+      last_exit: block.lastExit ?? undefined,
+    };
+  }
+
+  private rawSnapshot() {
+    return {
+      host_id: FAKE_HOST_ID,
+      clients: this.appClients(),
+      sessions: [...this.sessions.values()].map((session) => {
+        const blocks = new Map<string, JsonValue>();
+        const windows = session.windowIds.flatMap((windowId) => {
+          const window = this.windows.get(windowId);
+          if (window === undefined) return [];
+          const views = window.blockIds.flatMap((blockId) => {
+            const block = this.blocks.get(blockId);
+            if (block === undefined) return [];
+            if (block.creator === TERMINAL_CREATOR) {
+              blocks.set(block.id, {
+                process: this.process(block),
+                title: { title: block.title },
+                program_status: { records: block.records.map((record) => ({ ...record })) },
+              });
+            }
+            return [{ block_id: block.id, creator_name: block.creator, host_id: block.hostId, label: block.label }];
+          });
+          return [{ window_id: window.id, label: window.label, focused_block_id: window.focusedBlock, layers: [{ blocks: views }] }];
+        });
+        return {
+          session_id: session.id,
+          label: session.label,
+          view: { session_id: session.id, label: session.label, active_window_id: session.activeWindow, revision: session.revision, windows },
+          blocks: Object.fromEntries(blocks),
+        };
+      }),
+    };
+  }
+
+  private appClients() {
+    return this.clients
+      .filter((client) => client.kind === "app")
+      .map((client) => ({ client_id: client.id, info: { kind: client.kind }, session_ids: [...client.sessionIds], connection_state: "connected" }));
+  }
+
+  private census() {
+    return {
+      clients: this.appClients(),
+      sessions: [...this.sessions.values()].map((session) => ({
+        session_id: session.id,
+        label: session.label,
+        revision: session.revision,
+        active: session.activeWindow,
+      })),
+    };
+  }
+
+  private tail(blockId: string, format: "vt" | "text", bytes: number) {
+    const block = this.blocks.get(blockId);
+    if (block === undefined) return this.notFound(blockId);
+    const rendered = block.rows
+      .map((row, index) => (format === "vt" ? `\u001b[0m${index % 2 === 0 ? "\u001b[2C" : ""}\u001b[1m${row}\u001b[0m` : `${index % 2 === 0 ? "  " : ""}${row}`))
+      .join("\r\n");
+    const full = Buffer.from(`${rendered}\r\n`, "utf8");
+    const start = full.length > bytes ? full.length - bytes : 0;
+    return { ok: true, value: { content: new TextDecoder().decode(full.subarray(start)), total: full.length, start, rows: 24 } };
+  }
+
+  private sendKey(args: readonly string[]): RexRunResult {
+    const blockAt = args.indexOf("-b");
+    const blockId = blockAt >= 0 ? (args[blockAt + 1] ?? "") : "";
+    const keys = args.slice(args.indexOf("--") + 1);
+    const block = this.blocks.get(blockId);
+    if (block === undefined) return { code: 3, stdout: "", stderr: `Error: block target "${blockId}" not found\n` };
+    const bad = keys.find((key) => !validRexKey(key));
+    if (bad !== undefined) return { code: 1, stdout: "", stderr: `Error: invalid key "${bad}": unknown key "${bad}"\n` };
+    this.recorded.push({ paneId: block.id, kind: "keys", payload: [...keys] });
+    return { code: 0, stdout: "", stderr: "" };
+  }
+
+  private newWindow(args: readonly string[]): RexRunResult {
+    const sessionId = args[args.indexOf("-s") + 1] ?? "";
+    const session = this.sessions.get(sessionId);
+    if (session === undefined) return { code: 3, stdout: "", stderr: `Error: session target "${sessionId}" not found\n` };
+    const cwdAt = args.indexOf("-c");
+    const cwd = cwdAt >= 0 ? (args[cwdAt + 1] ?? "/home/dev") : "/home/dev";
+    const window = this.addWindow(session, "");
+    const block = this.addBlock(window, { foreground: { pid: 4000 + this.serial, name: "zsh", cwd }, title: "" });
+    if (!args.includes("--focus=false")) session.activeWindow = window.id;
+    this.emitSession(session.id, "window_created", { window_id: window.id, label: window.label });
+    this.emitSession(session.id, "block_created", { block_id: block.id });
+    this.bump(session, true);
+    return { code: 0, stdout: `${JSON.stringify({ window_id: window.id, block_ids: [block.id], revision: session.revision })}\n`, stderr: "" };
+  }
+
+  events(handlers: RexStreamHandlers): RexStreamClient {
+    const listener: FakeListener = { handlers, ended: false };
+    if (!this.connected) {
+      queueMicrotask(() => handlers.onExit(`no Rex server is running at ${FAKE_SOCKET}, and autostart is disabled`));
+      return { kill: () => undefined };
+    }
+    this.listeners.add(listener);
+    return {
+      kill: () => {
+        if (listener.ended) return;
+        listener.ended = true;
+        this.listeners.delete(listener);
+        handlers.onExit("closed");
+      },
+    };
+  }
+
+  reportStatus(paneId: string, state: string, app = "claude-code"): void {
+    const block = this.blocks.get(paneId);
+    if (block === undefined) return;
+    const owner = { pid: block.foreground?.pid ?? 0, name: block.foreground?.name ?? "" };
+    const record = { state, app, effective_app: app, updated_at: new Date().toISOString(), owner };
+    block.records = [record];
+    this.emitBlock(block, "program_status_changed", { id: "", record, reason: "report" });
+  }
+
+  async reconnect(): Promise<void> {
+    this.connected = false;
+    await Promise.resolve();
+    this.connected = true;
+  }
+
+  async restartMux(): Promise<void> {
+    this.sessions = new Map([...this.sessions].map(([id, s]) => [id, { ...s, windowIds: [...s.windowIds] }]));
+    this.windows = new Map([...this.windows].map(([id, w]) => [id, { ...w, blockIds: [...w.blockIds] }]));
+    this.blocks = new Map([...this.blocks].map(([id, b]) => [id, { ...b, records: b.records.map((r) => ({ ...r, owner: { ...r.owner } })), rows: [...b.rows] }]));
+    for (const listener of this.listeners) {
+      listener.ended = true;
+      this.listeners.delete(listener);
+      listener.handlers.onExit("the rex event stream ended");
+    }
+    await Promise.resolve();
+  }
+
+  async renameOutOfBand(paneId: string, label: string): Promise<void> {
+    const block = this.blocks.get(paneId);
+    if (block === undefined) return;
+    block.label = label;
+    const session = this.sessions.get(block.sessionId);
+    if (session) this.bump(session, true);
+    await Promise.resolve();
+  }
+
+  async setProgramTitle(paneId: string, title: string): Promise<void> {
+    const block = this.blocks.get(paneId);
+    if (block === undefined) return;
+    block.title = title;
+    this.emitBlock(block, "title_changed", { title, owner: block.foreground ? { pid: block.foreground.pid, name: block.foreground.name } : null });
+    await Promise.resolve();
+  }
+
+  async changePane(paneId: string): Promise<void> {
+    const block = this.blocks.get(paneId);
+    if (block) block.rows.push(`paint ${String(block.rows.length)}`);
+    await Promise.resolve();
+  }
+
+  async endPane(paneId: string): Promise<void> {
+    const block = this.blocks.get(paneId);
+    if (block === undefined) return;
+    this.emitBlock(block, "child_exited", { exit_code: 0 });
+    this.removeBlock(block);
+    await Promise.resolve();
+  }
+
+  async focusOutOfBand(paneId: string): Promise<void> {
+    const block = this.blocks.get(paneId);
+    if (block === undefined) return;
+    const window = this.windows.get(block.windowId);
+    const session = this.sessions.get(block.sessionId);
+    if (window === undefined || session === undefined) return;
+    window.focusedBlock = block.id;
+    session.activeWindow = window.id;
+    for (const client of this.clients) {
+      if (client.kind === "app" && !client.sessionIds.includes(session.id)) client.sessionIds.push(session.id);
+    }
+    this.bump(session, false);
+    await Promise.resolve();
+  }
+
+  async pokeTopologyOutOfBand(): Promise<void> {
+    const window = [...this.windows.values()].find((w) => w.label === "review") ?? [...this.windows.values()][0];
+    if (window === undefined) return;
+    window.label = `${window.label}-silent`;
+    const session = this.sessions.get(window.sessionId);
+    if (session) this.bump(session, false);
+    await Promise.resolve();
+  }
+
+  pokeTopology(): void {
+    const session = [...this.sessions.values()][0];
+    if (session) this.bump(session, true);
+  }
+
+  pokePane(paneId: string): void {
+    const block = this.blocks.get(paneId);
+    if (block) this.emitBlock(block, "bell", {});
+  }
+
+  shutdown(): void {
+    for (const listener of this.listeners) {
+      listener.ended = true;
+      this.listeners.delete(listener);
+    }
+  }
+}
+
+export function fakeClaudeSessions(sessions: ReadonlyMap<number, string> = new Map([[FAKE_CLAUDE_PID, FAKE_CLAUDE_SESSION]])): RexSessionLookup {
+  return {
+    sessionFor(pid: number): Promise<AgentSessionRef | null> {
+      const value = sessions.get(pid);
+      return Promise.resolve(value === undefined ? null : { kind: "id", value });
+    },
+  };
+}
+
+export function rexWorld(fake: FakeRex): MuxConformanceWorld {
+  return {
+    adapter: new RexMux(fake, fakeClaudeSessions()),
+    writes: () => fake.writes(),
+    reconnect: () => fake.reconnect(),
+    restartMux: () => fake.restartMux(),
+    renameOutOfBand: (paneId, label) => fake.renameOutOfBand(paneId, label),
+    setProgramTitle: (paneId, title) => fake.setProgramTitle(paneId, title),
+    changePane: (paneId) => fake.changePane(paneId),
+    endPane: (paneId) => fake.endPane(paneId),
+    focusOutOfBand: (paneId) => fake.focusOutOfBand(paneId),
+    pokeTopologyOutOfBand: () => fake.pokeTopologyOutOfBand(),
+    pokeTopology: () => fake.pokeTopology(),
+    pokePane: (paneId) => fake.pokePane(paneId),
+    close: () => {
+      fake.shutdown();
+      return Promise.resolve();
+    },
+  };
+}
+
+export const rexConformanceFixture: MuxConformanceFixture = {
+  mux: "rex",
+  create(): Promise<MuxConformanceWorld> {
+    return Promise.resolve(rexWorld(new FakeRex()));
+  },
+};
