+import { describe, expect, test } from "bun:test";
+
+import {
+  decodeCensus,
+  decodeCreatedWindow,
+  decodeProcess,
+  decodeSnapshot,
+  errorCode,
+  parseAnswer,
+  parseEvent,
+  REX_PROGRAM,
+  rexScript,
+} from "./protocol.ts";
+import { parseRexScript } from "./fixture.ts";
+
+describe("rexScript", () => {
+  test("carries its arguments through any text, closing brackets included", () => {
+    const text = "close ]] and ]=] and ]==] here\n\"quoted\"";
+    const script = rexScript({ op: "write", block: "block:x", text, paste: true });
+    expect(parseRexScript(script)).toEqual({ op: "write", block: "block:x", text, paste: true });
+  });
+
+  test("a script whose program was changed is not one of ours", () => {
+    const script = rexScript({ op: "snapshot" });
+    expect(parseRexScript(script)).toEqual({ op: "snapshot" });
+    expect(parseRexScript(script.replace("print(", "io.write("))).toBeNull();
+    expect(script.endsWith(REX_PROGRAM)).toBe(true);
+  });
+});
+
+describe("answers", () => {
+  test("the last line is the program's", () => {
+    expect(parseAnswer('noise\n{"ok":true,"value":{"a":1}}\n')).toEqual({ ok: true, value: { a: 1 } });
+    expect(parseAnswer('{"ok":false,"error":"x (status=409 code=conflict)"}')).toEqual({ ok: false, error: "x (status=409 code=conflict)" });
+    expect(parseAnswer("Error: stdin:1: boom")).toBeNull();
+  });
+
+  test("Rex's error code is read out of its error text", () => {
+    expect(errorCode('stream response "control-1" failed: block not found: block:x (status=404 code=not_found)')).toBe("not_found");
+    expect(errorCode("no code here")).toBeNull();
+  });
+});
+
+describe("decoders", () => {
+  test("Lua's empty table reads as an empty list wherever a list is expected", () => {
+    const snapshot = decodeSnapshot({ host_id: "h", clients: {}, sessions: {} });
+    expect(snapshot).toEqual({ hostId: "h", clients: [], sessions: [] });
+    expect(decodeCensus({ clients: {}, sessions: {} })).toEqual({ clients: [], sessions: [] });
+  });
+
+  test("a session whose view failed to read is left out rather than shown empty", () => {
+    const snapshot = decodeSnapshot({ host_id: "h", sessions: [{ session_id: "session:a", label: "a", error: "gone (status=404 code=session_not_found)", blocks: {} }] });
+    expect(snapshot.sessions).toEqual([]);
+  });
+
+  test("a program that exited is marked, and one still running is not", () => {
+    expect(decodeProcess({ foreground: null, last_exit: { exit_code: 1 } })?.exited).toBe(true);
+    expect(decodeProcess({ foreground: { pid: 3, name: "fish", cwd: "/" } })).toMatchObject({ exited: false, foreground: { pid: 3, name: "fish" } });
+  });
+
+  test("a new window names its window and blocks, or is null", () => {
+    expect(decodeCreatedWindow('{"window_id":"window:w","block_ids":["block:b"],"revision":2}\n')).toEqual({ windowId: "window:w", blockIds: ["block:b"] });
+    expect(decodeCreatedWindow("Error: nope")).toBeNull();
+  });
+});
+
+describe("parseEvent", () => {
+  test("unwraps a status report to its block, name and record", () => {
+    const line = JSON.stringify({
+      type: "session_event",
+      payload: {
+        session_id: "session:s",
+        event: {
+          type: "block_event",
+          payload: { block_id: "block:b", creator_name: "com.superlogical.terminal", name: "program_status_changed", payload: { id: "", record: { state: "blocked", app: "claude-code" } } },
+        },
+      },
+    });
+    expect(parseEvent(line)).toMatchObject({
+      type: "session_event",
+      session: "session:s",
+      sessionEvent: "block_event",
+      block: "block:b",
+      blockEvent: "program_status_changed",
+      record: { app: "claude-code", state: "blocked" },
+    });
+  });
+
+  test("a client event carries the client's id and kind", () => {
+    const joined = JSON.stringify({ type: "client_joined", payload: { client: { client_id: "client:c", info: { kind: "app" } } } });
+    const left = JSON.stringify({ type: "client_left", payload: { client_id: "client:c" } });
+    expect(parseEvent(joined)).toMatchObject({ clientId: "client:c", clientKind: "app" });
+    expect(parseEvent(left)).toMatchObject({ clientId: "client:c", clientKind: "" });
+  });
+
+  test("a line that is not an event is null", () => {
+    expect(parseEvent("Error: interrupted")).toBeNull();
+    expect(parseEvent('{"payload":{}}')).toBeNull();
+  });
+});
diff --git a/bridge/mux/rex/watch.test.ts b/bridge/mux/rex/watch.test.ts
new file mode 100644
index 00000000..49782e5b
--- /dev/null
+++ b/bridge/mux/rex/watch.test.ts
@@ -0,0 +1,234 @@
+import { describe, expect, test } from "bun:test";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+import type { JsonValue } from "../../json.ts";
+import type { MuxWatchOptions } from "../types.ts";
+import type { RexExec, RexRunResult, RexStreamHandlers } from "./exec.ts";
+import { FakeRex } from "./fixture.ts";
+import { parseEvent } from "./protocol.ts";
+import { RESYNC_IDLE_MS, RESYNC_MS, RexWatch, type WatchClock, type WatchTimer } from "./watch.ts";
+
+class ManualClock implements WatchClock {
+  tick: (() => void) | null = null;
+  cleared = false;
+  setInterval(fn: () => void): WatchTimer {
+    this.tick = fn;
+    return setTimeout(() => undefined, 0);
+  }
+  clearInterval(): void {
+    this.cleared = true;
+  }
+}
+
+interface Recorder {
+  readonly options: MuxWatchOptions;
+  readonly log: string[];
+}
+
+function recorder(panes: string[] = []): Recorder {
+  const log: string[] = [];
+  return {
+    log,
+    options: {
+      panes,
+      onTopologyChange: () => log.push("topology"),
+      onPaneChange: (id) => log.push(`pane:${id}`),
+      onUp: () => log.push("up"),
+      onDown: (reason) => log.push(`down:${reason}`),
+    },
+  };
+}
+
+const flush = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+function blockEvent(block: string, name: string, payload: JsonValue): string {
+  return JSON.stringify({
+    type: "session_event",
+    payload: { session_id: "session:s", event: { type: "block_event", payload: { block_id: block, creator_name: "com.superlogical.terminal", name, payload } } },
+  });
+}
+
+class StreamHolder {
+  handlers: RexStreamHandlers | null = null;
+}
+
+interface Scripted {
+  readonly exec: RexExec;
+  readonly stream: StreamHolder;
+}
+
+function scripted(census: RexRunResult): Scripted {
+  const stream = new StreamHolder();
+  return {
+    stream,
+    exec: {
+      run: () => Promise.resolve(census),
+      events: (handlers) => {
+        stream.handlers = handlers;
+        return { kill: () => handlers.onExit("closed") };
+      },
+    },
+  };
+}
+
+const CENSUS_OK: RexRunResult = { code: 0, stdout: '{"ok":true,"value":{"clients":{},"sessions":[{"session_id":"session:s","label":"a","revision":1}]}}\n', stderr: "" };
+
+describe("RexWatch", () => {
+  test("is up only after the first census answers, and down exactly once", async () => {
+    const { exec, stream } = scripted(CENSUS_OK);
+    const rec = recorder();
+    const clock = new ManualClock();
+    const watch = new RexWatch(exec, rec.options, clock);
+    expect(rec.log).toEqual([]);
+    await flush();
+    expect(rec.log).toEqual(["up"]);
+    stream.handlers?.onExit("the rex event stream ended");
+    stream.handlers?.onExit("again");
+    expect(rec.log).toEqual(["up", "down:the rex event stream ended"]);
+    expect(clock.cleared).toBe(true);
+    watch.close();
+  });
+
+  test("a server that is not running ends the watch before it is up", async () => {
+    const { exec } = scripted({ code: 4, stdout: "", stderr: "Error: no Rex server is running at /x, and autostart is disabled" });
+    const rec = recorder();
+    const watch = new RexWatch(exec, rec.options, new ManualClock());
+    await flush();
+    expect(rec.log).toEqual(["down:Error: no Rex server is running at /x, and autostart is disabled"]);
+    watch.close();
+  });
+
+  test("a status report that changes only its timestamp or message moves nothing", async () => {
+    const { exec, stream } = scripted(CENSUS_OK);
+    const rec = recorder(["block:b"]);
+    const watch = new RexWatch(exec, rec.options, new ManualClock());
+    await flush();
+    const report = (state: string, msg: string) => blockEvent("block:b", "program_status_changed", { id: "", reason: "report", record: { state, app: "claude-code", msg, updated_at: msg } });
+    stream.handlers?.onLine(report("working", "one"));
+    stream.handlers?.onLine(report("working", "two"));
+    stream.handlers?.onLine(report("blocked", "three"));
+    expect(rec.log).toEqual(["up", "topology", "pane:block:b", "topology", "pane:block:b"]);
+    watch.close();
+  });
+
+  test("a bell reaches only a watched pane, and never the topology", async () => {
+    const { exec, stream } = scripted(CENSUS_OK);
+    const rec = recorder(["block:w"]);
+    const watch = new RexWatch(exec, rec.options, new ManualClock());
+    await flush();
+    stream.handlers?.onLine(blockEvent("block:w", "bell", {}));
+    stream.handlers?.onLine(blockEvent("block:other", "bell", {}));
+    expect(rec.log).toEqual(["up", "pane:block:w"]);
+    watch.close();
+  });
+
+  test("a client connecting moves the topology only when it is an app", async () => {
+    const { exec, stream } = scripted(CENSUS_OK);
+    const rec = recorder();
+    const watch = new RexWatch(exec, rec.options, new ManualClock());
+    await flush();
+    stream.handlers?.onLine(JSON.stringify({ type: "client_joined", payload: { client: { client_id: "client:cli", info: { kind: "cli" } } } }));
+    stream.handlers?.onLine(JSON.stringify({ type: "client_left", payload: { client_id: "client:cli" } }));
+    expect(rec.log).toEqual(["up"]);
+    stream.handlers?.onLine(JSON.stringify({ type: "client_joined", payload: { client: { client_id: "client:app", info: { kind: "app" } } } }));
+    stream.handlers?.onLine(JSON.stringify({ type: "client_left", payload: { client_id: "client:app" } }));
+    expect(rec.log).toEqual(["up", "topology", "topology"]);
+    watch.close();
+  });
+
+  test("a census that sees a change nobody announced moves the topology", async () => {
+    const fake = new FakeRex();
+    const rec = recorder();
+    const clock = new ManualClock();
+    const watch = new RexWatch(fake, { ...rec.options, attention: () => "watched" }, clock);
+    await flush();
+    await fake.pokeTopologyOutOfBand();
+    clock.tick?.();
+    await flush();
+    expect(rec.log).toEqual(["up", "topology"]);
+    watch.close();
+  });
+
+  test("nobody watching runs the census once a minute, and attention brings the 5 s census back", async () => {
+    let runs = 0;
+    let attention: "watched" | "idle" = "idle";
+    const { stream } = scripted(CENSUS_OK);
+    const exec: RexExec = {
+      run: () => {
+        runs++;
+        return Promise.resolve(CENSUS_OK);
+      },
+      events: (handlers) => {
+        stream.handlers = handlers;
+        return { kill: () => handlers.onExit("closed") };
+      },
+    };
+    const clock = new ManualClock();
+    const watch = new RexWatch(exec, { ...recorder().options, attention: () => attention }, clock);
+    await flush();
+    expect(runs).toBe(1);
+    const idleTicks = RESYNC_IDLE_MS / RESYNC_MS;
+    for (let i = 1; i < idleTicks; i++) clock.tick?.();
+    await flush();
+    expect(runs).toBe(1);
+    clock.tick?.();
+    await flush();
+    expect(runs).toBe(2);
+    attention = "watched";
+    clock.tick?.();
+    await flush();
+    clock.tick?.();
+    await flush();
+    expect(runs).toBe(4);
+    watch.close();
+  });
+
+  test("a census killed at its deadline keeps a live stream up", async () => {
+    let census: RexRunResult = CENSUS_OK;
+    const { stream } = scripted(CENSUS_OK);
+    const exec: RexExec = {
+      run: () => Promise.resolve(census),
+      events: (handlers) => {
+        stream.handlers = handlers;
+        return { kill: () => handlers.onExit("closed") };
+      },
+    };
+    const rec = recorder();
+    const clock = new ManualClock();
+    const watch = new RexWatch(exec, { ...rec.options, attention: () => "watched" }, clock);
+    await flush();
+    census = { code: 143, stdout: "", stderr: "" };
+    clock.tick?.();
+    await flush();
+    expect(rec.log).toEqual(["up"]);
+    census = { code: 4, stdout: "", stderr: "Error: no Rex server is running at /x" };
+    clock.tick?.();
+    await flush();
+    expect(rec.log).toEqual(["up", "down:Error: no Rex server is running at /x"]);
+    watch.close();
+  });
+
+  test("recorded structural and status lines move the watch, CLI connections do not", () => {
+    const events = readFileSync(join(import.meta.dir, "captures", "events.ndjson"), "utf8").split("\n").filter((line) => line.trim() !== "");
+    const { exec, stream } = scripted({ code: 4, stdout: "", stderr: "no Rex server is running" });
+    const rec = recorder();
+    const watch = new RexWatch(exec, rec.options, new ManualClock());
+    const kinds = new Map<string, number>();
+    for (const line of events) {
+      const before = rec.log.length;
+      stream.handlers?.onLine(line);
+      const event = parseEvent(line);
+      const kind = [event?.type, event?.sessionEvent, event?.blockEvent].filter(Boolean).join("/");
+      kinds.set(kind, (kinds.get(kind) ?? 0) + rec.log.length - before);
+    }
+    watch.close();
+    expect(kinds.get("client_joined")).toBe(0);
+    expect(kinds.get("session_event/client_connected")).toBe(0);
+    expect(kinds.get("session_event/block_owner_changed")).toBe(0);
+    expect(kinds.get("session_created")).toBe(1);
+    expect(kinds.get("session_event/window_created")).toBe(1);
+    expect(kinds.get("session_event/block_event/program_status_changed")).toBe(4);
+    expect(kinds.get("session_event/block_event/program_status_removed")).toBe(1);
+  });
+});
