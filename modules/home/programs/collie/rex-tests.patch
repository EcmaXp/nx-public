new file mode 100644
index 00000000..aad4da3d
--- /dev/null
+++ b/bridge/journal/claude-pid.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, test } from "bun:test";
+
+import {
+  ClaudePidSessions,
+  claudePidRecordDirs,
+  normalizeProcessStart,
+  parseClaudePidRecord,
+  processStartUtc,
+  type ProcessStartOf,
+  type ReadText,
+} from "./claude-pid.ts";
+
+const SESSION = "4af98971-ee53-48f4-a493-cf8611b64b8b";
+const OTHER = "ca7d7e1b-a296-4a73-a098-b41a249c1bbf";
+const START = "Sat Oct 31 08:19:56 2026";
+
+function recordText(fields: Record<string, string | number>): string {
+  return JSON.stringify({ pid: 64356, sessionId: SESSION, procStart: START, kind: "interactive", ...fields });
+}
+
+function files(entries: Record<string, string> | ReadonlyMap<string, string>): ReadText {
+  const map = entries instanceof Map ? entries : new Map(Object.entries(entries));
+  return (path) => Promise.resolve(map.get(path) ?? null);
+}
+
+interface CountingStart {
+  readonly startOf: ProcessStartOf;
+  readonly asked: number[];
+}
+
+function counting(start: string | null): CountingStart {
+  const asked: number[] = [];
+  return {
+    asked,
+    startOf: (pid) => {
+      asked.push(pid);
+      return Promise.resolve(start);
+    },
+  };
+}
+
+describe("claudePidRecordDirs", () => {
+  test("each Claude projects root has its pid records beside it, once", () => {
+    expect(claudePidRecordDirs(["/h/.claude/projects", " /h/.claude-work/projects ", "", "/h/.claude/projects"], "/h")).toEqual([
+      "/h/.claude/sessions",
+      "/h/.claude-work/sessions",
+    ]);
+    expect(claudePidRecordDirs([""], "/h")).toEqual([]);
+  });
+
+  test("a root not named projects reads the home config dir, as Claude commands do", () => {
+    expect(claudePidRecordDirs(["/x/claude-logs"], "/h")).toEqual(["/h/.claude/sessions"]);
+  });
+});
+
+describe("parseClaudePidRecord", () => {
+  test("a record of this pid names its session and its process start", () => {
+    expect(parseClaudePidRecord(recordText({}), 64356)).toEqual({ sessionId: SESSION, procStart: START });
+  });
+
+  test("a record of another pid, a malformed id, or no start time names nothing", () => {
+    expect(parseClaudePidRecord(recordText({}), 64357)).toBeNull();
+    expect(parseClaudePidRecord(recordText({ sessionId: "../../etc/passwd" }), 64356)).toBeNull();
+    expect(parseClaudePidRecord(recordText({ procStart: " " }), 64356)).toBeNull();
+    expect(parseClaudePidRecord("not json", 64356)).toBeNull();
+  });
+
+  test("process start text compares with its spacing collapsed", () => {
+    expect(normalizeProcessStart("Sat Oct  3 08:19:56 2026    \n")).toBe("Sat Oct 3 08:19:56 2026");
+  });
+});
+
+describe("ClaudePidSessions", () => {
+  const dir = "/h/.claude/sessions";
+
+  test("a record whose process started when it says names the session", async () => {
+    const { startOf } = counting(START);
+    const sessions = new ClaudePidSessions([dir], startOf, files({ [`${dir}/64356.json`]: recordText({}) }));
+    expect(await sessions.sessionFor(64356)).toEqual({ kind: "id", value: SESSION });
+  });
+
+  test("a record left by an earlier process with the same pid names nothing", async () => {
+    const { startOf } = counting("Sat Oct 31 09:00:00 2026");
+    const sessions = new ClaudePidSessions([dir], startOf, files({ [`${dir}/64356.json`]: recordText({}) }));
+    expect(await sessions.sessionFor(64356)).toBeNull();
+  });
+
+  test("a process whose start cannot be read names nothing", async () => {
+    const { startOf } = counting(null);
+    const sessions = new ClaudePidSessions([dir], startOf, files({ [`${dir}/64356.json`]: recordText({}) }));
+    expect(await sessions.sessionFor(64356)).toBeNull();
+  });
+
+  test("a later config dir answers when the first holds no valid record for the pid", async () => {
+    const second = "/h/.claude-work/sessions";
+    const { startOf } = counting(START);
+    const read = files({ [`${dir}/64356.json`]: recordText({ pid: 1 }), [`${second}/64356.json`]: recordText({ sessionId: OTHER }) });
+    expect(await new ClaudePidSessions([dir, second], startOf, read).sessionFor(64356)).toEqual({ kind: "id", value: OTHER });
+  });
+
+  test("the process start is read once per process, and again for a new session in it only from the file", async () => {
+    const { startOf, asked } = counting(START);
+    const entries = new Map([[`${dir}/64356.json`, recordText({})]]);
+    const sessions = new ClaudePidSessions([dir], startOf, files(entries));
+    await sessions.sessionFor(64356);
+    entries.set(`${dir}/64356.json`, recordText({ sessionId: OTHER }));
+    expect(await sessions.sessionFor(64356)).toEqual({ kind: "id", value: OTHER });
+    expect(asked).toEqual([64356]);
+  });
+
+  test("a pid that is not a positive whole number is never read", async () => {
+    const { startOf, asked } = counting(START);
+    const sessions = new ClaudePidSessions([dir], startOf, files({}));
+    expect(await sessions.sessionFor(0)).toBeNull();
+    expect(await sessions.sessionFor(-3)).toBeNull();
+    expect(await sessions.sessionFor(1.5)).toBeNull();
+    expect(asked).toEqual([]);
+  });
+});
+
+describe("processStartUtc", () => {
+  test("this process has a start time, and no process zero does", async () => {
+    expect(await processStartUtc(process.pid)).toMatch(/^[A-Z][a-z]{2} [A-Z][a-z]{2} \d{1,2} \d{2}:\d{2}:\d{2} \d{4}$/u);
+    expect(await processStartUtc(0)).toBeNull();
+  });
+});
