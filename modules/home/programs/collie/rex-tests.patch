index 00000000..a3fa8f39
--- /dev/null
+++ b/bridge/mux/rex/captures.test.ts
@@ -0,0 +1,134 @@
+import { describe, expect, test } from "bun:test";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+import { asJsonNumber, asJsonObject, asJsonString, parseJson, type JsonObject } from "../../../web/src/lib/json.ts";
+import { normalizeProcessStart, parseClaudePidRecord } from "../../journal/claude-pid.ts";
+import { isValidMuxId } from "../types.ts";
+import { gridRows, sessionPids, toSnapshot } from "./layout.ts";
+import type { JsonValue } from "../../json.ts";
+import { censusSignature, decodeCensus, decodeSnapshot, decodeTail, parseAnswer, parseEvent } from "./protocol.ts";
+import { refusalForAnswer } from "./refusal.ts";
+
+const here = join(import.meta.dir, "captures");
+const read = (name: string): string => readFileSync(join(here, name), "utf8");
+
+function value(name: string): JsonValue {
+  const answer = parseAnswer(read(name));
+  if (answer === null || !answer.ok) throw new Error(`${name} is not a successful answer`);
+  return answer.value;
+}
+
+const EVENTS = read("events.ndjson").split("\n").filter((line) => line.trim() !== "");
+
+describe("a recorded snapshot", () => {
+  const snapshot = toSnapshot(decodeSnapshot(value("snapshot.json")));
+
+  test("maps sessions, windows and blocks to spaces, tabs and panes with exact ids", () => {
+    expect(snapshot.spaces.map((space) => space.label)).toEqual(["probe-a", "probe-b"]);
+    expect(snapshot.tabs.map((tab) => tab.label)).toEqual(["1", "review", "keys"]);
+    expect(snapshot.panes).toHaveLength(3);
+    for (const pane of snapshot.panes) expect(isValidMuxId(pane.paneId)).toBe(true);
+    expect(snapshot.panes.every((pane) => pane.paneId.startsWith("block:"))).toBe(true);
+  });
+
+  test("names Claude from its own report and Codex from its foreground process", () => {
+    const byAgent = new Map(snapshot.panes.map((pane) => [pane.agent, pane]));
+    expect(byAgent.get("claude")?.status).toBe("done");
+    expect(byAgent.get("codex")?.status).toBe("unknown");
+    expect(byAgent.get("shell")?.paneLabel).toBe("probe label");
+  });
+
+  test("an app-less server focuses nothing, and its empty client list arrives as {}", () => {
+    expect(read("snapshot.json")).toContain('"clients":{}');
+    expect(snapshot.panes.some((pane) => pane.focused)).toBe(false);
+    expect(snapshot.spaces.some((space) => space.focused)).toBe(false);
+  });
+
+  test("a default window label is a number, and only a chosen one names a pane's tab", () => {
+    const unnamed = snapshot.panes.find((pane) => pane.agent === "shell");
+    const named = snapshot.panes.find((pane) => pane.agent === "claude");
+    expect(unnamed?.tabNamed).toBeUndefined();
+    expect(named).toMatchObject({ tabLabel: "review", tabNamed: true });
+  });
+});
+
+describe("a recorded census", () => {
+  test("signs every session", () => {
+    const signature = censusSignature(decodeCensus(value("census.json")));
+    expect(signature.split(";").filter((part) => part.startsWith("s:"))).toHaveLength(2);
+  });
+});
+
+describe("recorded tails", () => {
+  test("a whole read keeps SGR, turns ESC[nC into spaces and carries no other escape", () => {
+    const tail = decodeTail(value("tail-claude-vt.json"));
+    expect(tail.content).toContain("\u001b[1C");
+    const { rows, cutAbove } = gridRows(tail.content, tail.start);
+    const text = rows.join("\n");
+    expect(cutAbove).toBe(false);
+    // eslint-disable-next-line no-control-regex
+    expect(text).not.toMatch(/\u001b\[[0-9;]*[^0-9;m]/u);
+    expect(text).toContain("\u001b[0m");
+    expect(text).toContain("run a command");
+    expect(text).not.toContain("\r");
+  });
+
+  test("a read cut mid-buffer drops its first, partial row", () => {
+    const whole = decodeTail(value("tail-claude-vt.json"));
+    const cut = decodeTail(value("tail-claude-cut.json"));
+    expect(cut.start).toBeGreaterThan(0);
+    expect(cut.total).toBe(whole.total);
+    const rows = gridRows(cut.content, cut.start);
+    expect(rows.cutAbove).toBe(true);
+    const wholeRows = gridRows(whole.content, whole.start).rows;
+    expect(wholeRows.slice(-rows.rows.length)).toEqual([...rows.rows]);
+  });
+
+  test("a missing block answers Rex's 404, which is gone", () => {
+    const answer = parseAnswer(read("missing-block.json"));
+    expect(answer?.ok).toBe(false);
+    if (answer === null || answer.ok) return;
+    expect(refusalForAnswer(answer.error).reason).toBe("gone");
+  });
+});
+
+describe("recorded events", () => {
+  test("every line parses", () => {
+    for (const line of EVENTS) expect(parseEvent(line)).not.toBeNull();
+  });
+});
+
+describe("a recorded Claude pid record", () => {
+  const capture = asJsonObject(parseJson(read("claude-pid-record.json"))) ?? {};
+  const part = (name: string): JsonObject => asJsonObject(capture[name]) ?? {};
+  const blockOf = (name: string): JsonObject => asJsonObject(part(name).block) ?? {};
+  const foregroundPid = (name: string): number => asJsonNumber((asJsonObject(blockOf(name).fg) ?? {}).pid) ?? 0;
+  const recordText = (name: string): string => JSON.stringify(part(name).record ?? null);
+
+  test("the snapshot's Claude pane is looked up by the pid that reported its status", () => {
+    const raw = decodeSnapshot(value("snapshot.json"));
+    expect([...sessionPids(raw).values()]).toEqual([30638]);
+  });
+
+  test("the reporting pid is the foreground pid, and its record names the session of the first turn's transcript", () => {
+    const pid = foregroundPid("started");
+    const status = asJsonObject(blockOf("started").status) ?? {};
+    const reported = status.records;
+    const owner = Array.isArray(reported) ? asJsonObject(asJsonObject(reported[0])?.owner) : undefined;
+    expect(asJsonNumber(owner?.pid)).toBe(pid);
+    const record = parseClaudePidRecord(recordText("started"), pid);
+    expect(`${record?.sessionId ?? ""}.jsonl`).toBe(asJsonString(capture.first_turn_transcript) ?? "");
+    expect(record?.procStart).toBe(normalizeProcessStart(asJsonString(part("started").ps_lstart_utc) ?? ""));
+  });
+
+  test("/clear rewrites the same pid's record with a new session, and exit removes it", () => {
+    const pid = foregroundPid("started");
+    const started = parseClaudePidRecord(recordText("started"), pid);
+    const cleared = parseClaudePidRecord(recordText("cleared"), pid);
+    expect(cleared?.procStart).toBe(started?.procStart ?? "");
+    expect(cleared?.sessionId).not.toBe(started?.sessionId ?? "");
+    expect(parseClaudePidRecord(recordText("started"), pid + 1)).toBeNull();
+    expect(part("exited").record).toBeNull();
+  });
+});
