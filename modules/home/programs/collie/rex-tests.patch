+import { describe, expect, test } from "bun:test";
+
+import { MUX_NAMED_KEYS } from "../keys.ts";
+import { toRexKey } from "./keys.ts";
+
+describe("toRexKey", () => {
+  test("every named key in the contract's alphabet has a Rex name", () => {
+    for (const key of MUX_NAMED_KEYS) expect(toRexKey(key).ok).toBe(true);
+    expect(toRexKey("PageDown")).toEqual({ ok: true, key: "pagedown" });
+  });
+
+  test("modifiers keep the canonical order", () => {
+    expect(toRexKey("ctrl+c")).toEqual({ ok: true, key: "ctrl+c" });
+    expect(toRexKey("ctrl+alt+Delete")).toEqual({ ok: true, key: "ctrl+alt+delete" });
+    expect(toRexKey("shift+Tab")).toEqual({ ok: true, key: "shift+tab" });
+  });
+
+  test("a capital letter is shift and its key, because a bare A arrives as a", () => {
+    expect(toRexKey("A")).toEqual({ ok: true, key: "shift+a" });
+    expect(toRexKey("alt+F")).toEqual({ ok: true, key: "alt+shift+f" });
+  });
+
+  test("shifted punctuation goes through its US-layout key, which send-key accepts", () => {
+    expect(toRexKey("?")).toEqual({ ok: true, key: "shift+/" });
+    expect(toRexKey("~")).toEqual({ ok: true, key: "shift+`" });
+    expect(toRexKey("+")).toEqual({ ok: true, key: "shift+=" });
+    expect(toRexKey("/")).toEqual({ ok: true, key: "/" });
+    expect(toRexKey(" ")).toEqual({ ok: true, key: "space" });
+  });
+
+  test("meta and characters with no US key are refused before anything is sent", () => {
+    expect(toRexKey("meta+c")).toEqual({ ok: false, reason: "meta" });
+    expect(toRexKey("한")).toEqual({ ok: false, reason: "character" });
+    expect(toRexKey("ctrl+")).toEqual({ ok: false, reason: "unparsed" });
+  });
+});
diff --git a/bridge/mux/rex/layout.test.ts b/bridge/mux/rex/layout.test.ts
