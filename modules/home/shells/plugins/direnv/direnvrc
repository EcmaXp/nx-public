# use op: replace 1Password op:// references with actual values
use_op() {
  local var tpl="" vars=()
  for var in $(env | grep 'op://' | cut -d= -f1); do
    tpl+="${var}={{ ${!var} }}"$'\n'
    vars+=("$var")
  done
  [[ -z "$tpl" ]] && return 0

  # key material: prefer the per-session random key (SessionStart hook,
  # erased at SessionEnd) over the session id, which is recoverable from
  # transcript filenames after the session ends
  local sid="${OP_CACHE_SESSION_KEY:-${CLAUDE_CODE_SESSION_ID:-}}" dir="${CLAUDE_CODE_TMPDIR:-${TMPDIR:-}}"
  local hash="" cache="" pass="" resolved=""
  if [[ -n "$sid" && -n "$dir" ]] && command -v openssl >/dev/null 2>&1; then
    hash="$(printf '%s' "$tpl" | openssl dgst -sha256 -r 2>/dev/null | cut -c1-16)" || hash=""
    if [[ -n "$hash" ]]; then
      cache="${dir}/op-inject-${hash}.enc"
      pass="${sid}:${hash}"
    fi
  fi

  local lockfd="" op_status=0
  if [[ -n "$cache" ]] && command -v flock >/dev/null 2>&1; then
    exec {lockfd}>"${cache}.lock" || return $?
    flock -w 300 "$lockfd" || {
      op_status=$?
      exec {lockfd}>&-
      printf 'direnv use op: lock acquisition failed (status=%s)\n' "$op_status" >&2
      return "$op_status"
    }
  fi

  # cache read: decrypt, then require every expected var at line start
  if [[ -n "$cache" && -f "$cache" ]] && ! find "$cache" -mmin +1440 2>/dev/null | grep -q .; then
    resolved="$(OP_CACHE_PASS="$pass" openssl enc -d -aes-256-cbc -pbkdf2 \
      -pass env:OP_CACHE_PASS -in "$cache" 2>/dev/null | tr -d '\0')" || resolved=""
    for var in "${vars[@]}"; do
      [[ $'\n'"$resolved" == *$'\n'"${var}="* ]] || { resolved=""; break; }
    done
  fi

  # cache miss: resolve via op, then store encrypted (best effort)
  if [[ -z "$resolved" ]]; then
    resolved="$(
      # The parent keeps the lock; op daemon must not inherit its descriptor.
      if [[ -n "$lockfd" ]]; then
        exec {lockfd}>&- || exit 1
      fi
      printf '%s' "$tpl" | op inject
    )" && op_status=0 || op_status=$?
    if [[ $op_status != 0 || -z "$resolved" ]]; then
      [[ -n "$lockfd" ]] && exec {lockfd}>&-
      [[ $op_status != 0 ]] || op_status=1
      printf 'direnv use op: secret resolution failed or empty (status=%s)\n' "$op_status" >&2
      return "$op_status"
    fi
    if [[ -n "$cache" ]]; then
      (
        umask 077
        printf '%s' "$resolved" | OP_CACHE_PASS="$pass" openssl enc -aes-256-cbc \
          -pbkdf2 -salt -pass env:OP_CACHE_PASS -out "${cache}.$$" &&
          mv -f "${cache}.$$" "$cache" || rm -f "${cache}.$$"
      ) >/dev/null 2>&1 || true
    fi
  fi
  [[ -n "$lockfd" ]] && exec {lockfd}>&-

  # split on the first = only: IFS='=' read drops a trailing =, which silently
  # truncates every base64 secret whose padding lands at the end of the value
  local line key value
  while IFS= read -r line; do
    if [[ -n "$line" ]]; then
      key="${line%%=*}"
      value="${line#*=}"
      export "$key"="$value"
    fi
  done <<<"$resolved"
}
