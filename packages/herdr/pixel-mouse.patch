+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn encode_left_press(terminal: &crate::ghostty::Terminal, column: u16, row: u16) -> Vec<u8> {
+        let position = crate::input::mouse::Position::Cell { column, row };
+        let (mut encoder, (x, y)) = ghostty_mouse_encoder_for_terminal(terminal, position).unwrap();
+        let mut event = ghostty_mouse_event_from_button_kind(
+            crossterm::event::MouseEventKind::Down(crossterm::event::MouseButton::Left),
+            0,
+            0,
+            crossterm::event::KeyModifiers::empty(),
+        )
+        .unwrap();
+        event.set_position(x, y);
+        encoder.encode(&event).unwrap()
+    }
+
+    #[test]
+    fn sgr_pixels_pane_receives_cell_centre_in_pixels() {
+        let mut terminal = crate::ghostty::Terminal::new(120, 40, 0).unwrap();
+        terminal.resize(120, 40, 14, 30).unwrap();
+        terminal.write(b"\x1b[?1000h\x1b[?1006h\x1b[?1016h");
+        assert!(terminal
+            .mode_get(crate::ghostty::MODE_MOUSE_SGR_PIXELS)
+            .unwrap());
+
+        assert_eq!(encode_left_press(&terminal, 40, 20), b"\x1b[<0;567;615M");
+        assert_eq!(encode_left_press(&terminal, 0, 0), b"\x1b[<0;7;15M");
+    }
+
+    #[test]
+    fn sgr_pixels_pane_without_pixel_size_falls_back_to_cells() {
+        let mut terminal = crate::ghostty::Terminal::new(120, 40, 0).unwrap();
+        terminal.write(b"\x1b[?1000h\x1b[?1006h\x1b[?1016h");
+
+        assert_eq!(encode_left_press(&terminal, 40, 20), b"\x1b[<0;41;21M");
+    }
+
+    #[test]
+    fn sgr_cell_pane_keeps_cell_coordinates() {
+        let mut terminal = crate::ghostty::Terminal::new(120, 40, 0).unwrap();
+        terminal.resize(120, 40, 14, 30).unwrap();
+        terminal.write(b"\x1b[?1000h\x1b[?1006h");
+
+        assert_eq!(encode_left_press(&terminal, 40, 20), b"\x1b[<0;41;21M");
+    }
+}
