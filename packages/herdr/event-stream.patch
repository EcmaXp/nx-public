+#[cfg(test)]
+mod tests {
+    use std::collections::HashMap;
+    use std::time::{Duration, Instant};
+
+    use super::*;
+    use crate::api::schema::{AgentStatus, EventData, EventEnvelope, EventKind};
+
+    fn event() -> EventEnvelope {
+        EventEnvelope {
+            event: EventKind::PaneAgentStatusChanged,
+            data: EventData::PaneAgentStatusChanged {
+                pane_id: "pane_1".into(),
+                workspace_id: "workspace_1".into(),
+                agent_status: AgentStatus::Working,
+                agent: None,
+                title: None,
+                display_agent: None,
+                state_labels: HashMap::new(),
+            },
+        }
+    }
+
+    #[test]
+    fn push_wakes_waiter_immediately() {
+        let hub = EventHub::default();
+        let waiting_hub = hub.clone();
+        let waiter = std::thread::spawn(move || {
+            let started = Instant::now();
+            let sequence = waiting_hub.wait_for_change(0, Duration::from_secs(1));
+            (sequence, started.elapsed())
+        });
+
+        std::thread::sleep(Duration::from_millis(10));
+        hub.push(event());
+        let (sequence, elapsed) = waiter.join().unwrap();
+
+        assert_eq!(sequence, 1);
+        assert!(elapsed < Duration::from_millis(100));
+    }
+
+    #[test]
+    fn wait_times_out_without_an_event() {
+        let hub = EventHub::default();
+        let started = Instant::now();
+
+        assert_eq!(hub.wait_for_change(0, Duration::from_millis(10)), 0);
+        assert!(started.elapsed() >= Duration::from_millis(5));
+    }
 }
