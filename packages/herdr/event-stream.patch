+    pub fn wait_for_change(&self, sequence: u64, timeout: Duration) -> u64 {
+        let Ok(state) = self.inner.state.lock() else {
+            return sequence;
+        };
+        if state.next_sequence > sequence {
+            return state.next_sequence;
+        }
+
+        let Ok((state, _)) = self
+            .inner
+            .changed
+            .wait_timeout_while(state, timeout, |state| state.next_sequence <= sequence)
+        else {
+            return sequence;
+        };
+        state.next_sequence
+    }
