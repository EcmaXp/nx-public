diff --git c/src/app/global_pane.rs w/src/app/global_pane.rs
new file mode 100644
index 0000000..1d1a315
--- /dev/null
+++ w/src/app/global_pane.rs
@@ -0,0 +1,400 @@
+use crate::app::state::AppState;
+use crate::app::{App, Mode};
+use crate::layout::PaneId;
+use crate::terminal::TerminalId;
+use crate::workspace::Workspace;
+
+const INTERNAL_WORKSPACE_NAME: &str = "global";
+
+// ponytail: dock visibility, focus and width are server-global; per-client
+#[derive(Debug, Clone, Default)]
+pub(crate) struct GlobalPane {
+    pub visible: bool,
+    pub focus_global: bool,
+    pub workspace_id: Option<String>,
+    pub config: crate::config::GlobalPaneConfig,
+    pub width: Option<u16>,
+}
+
+impl AppState {
+    pub(crate) fn is_internal_ws(&self, ws: &Workspace) -> bool {
+        self.global_pane.workspace_id.as_deref() == Some(ws.id.as_str())
+    }
+
+    pub(crate) fn is_internal_idx(&self, idx: usize) -> bool {
+        self.workspaces
+            .get(idx)
+            .is_some_and(|ws| self.is_internal_ws(ws))
+    }
+
+    pub(crate) fn internal_workspace_idx(&self) -> Option<usize> {
+        let id = self.global_pane.workspace_id.as_deref()?;
+        self.workspaces.iter().position(|ws| ws.id == id)
+    }
+
+    pub(crate) fn first_visible_workspace_idx(&self) -> Option<usize> {
+        (0..self.workspaces.len()).find(|&idx| !self.is_internal_idx(idx))
+    }
+
+    pub(crate) fn global_pane_visible(&self) -> bool {
+        self.global_pane.visible && self.internal_workspace_idx().is_some()
+    }
+
+    pub(crate) fn global_focus_active(&self) -> bool {
+        self.global_pane.visible
+            && self.global_pane.focus_global
+            && self.internal_workspace_idx().is_some()
+    }
+
+    pub(crate) fn global_pane_target(&self) -> Option<(usize, PaneId, TerminalId)> {
+        let ws_idx = self.internal_workspace_idx()?;
+        let ws = self.workspaces.get(ws_idx)?;
+        let pane_id = ws.focused_pane_id()?;
+        let terminal_id = ws.terminal_id(pane_id)?.clone();
+        Some((ws_idx, pane_id, terminal_id))
+    }
+
+    pub(crate) fn global_pane_claims_pane(&self, pane_id: PaneId) -> Option<bool> {
+        let ws = self.workspaces.get(self.internal_workspace_idx()?)?;
+        if !ws.tabs.iter().any(|tab| tab.panes.contains_key(&pane_id)) {
+            return None;
+        }
+        Some(
+            self.global_pane_visible()
+                && self.global_pane_target().map(|(_, id, _)| id) == Some(pane_id),
+        )
+    }
+}
+
+pub(crate) fn sanitize_restored_selection(
+    workspaces: &[Workspace],
+    internal_id: Option<&str>,
+    active: Option<usize>,
+    selected: usize,
+) -> (Option<usize>, usize) {
+    let is_internal = |idx: usize| {
+        workspaces
+            .get(idx)
+            .is_some_and(|ws| Some(ws.id.as_str()) == internal_id)
+    };
+    let first_visible = workspaces
+        .iter()
+        .position(|ws| Some(ws.id.as_str()) != internal_id);
+    let sanitized_active = active
+        .filter(|&idx| idx < workspaces.len() && !is_internal(idx))
+        .or_else(|| active.and(first_visible));
+    let selected = selected.min(workspaces.len().saturating_sub(1));
+    let selected = if is_internal(selected) {
+        first_visible.unwrap_or(0)
+    } else {
+        selected
+    };
+    (sanitized_active, selected)
+}
+
+pub(crate) fn snapshot_internal_id(
+    snapshot: &crate::persist::SessionSnapshot,
+    workspaces: &[Workspace],
+) -> Option<String> {
+    let id = snapshot
+        .global_pane
+        .as_ref()
+        .map(|gp| gp.workspace_id.clone())
+        .or_else(|| {
+            workspaces
+                .iter()
+                .find(|ws| ws.custom_name.as_deref() == Some(INTERNAL_WORKSPACE_NAME))
+                .map(|ws| ws.id.clone())
+        })?;
+    workspaces.iter().any(|ws| ws.id == id).then_some(id)
+}
+
+pub(crate) fn restore_session_fields(
+    state: &mut AppState,
+    snapshot: &crate::persist::SessionSnapshot,
+) {
+    state.global_pane.workspace_id = snapshot_internal_id(snapshot, &state.workspaces);
+    if let Some(width) = snapshot.global_pane.as_ref().and_then(|gp| gp.width) {
+        state.global_pane.width = Some(width);
+    }
+    let (active, selected) = sanitize_restored_selection(
+        &state.workspaces,
+        state.global_pane.workspace_id.as_deref(),
+        snapshot.active,
+        snapshot.selected,
+    );
+    state.active = active;
+    state.selected = selected;
+}
+
+impl crate::persist::SessionSnapshot {
+    pub(crate) fn with_global_pane(mut self, state: &AppState) -> Self {
+        self.global_pane =
+            state
+                .internal_workspace_idx()
+                .map(|idx| crate::persist::GlobalPaneSnapshot {
+                    workspace_id: state.workspaces[idx].id.clone(),
+                    width: state.global_pane.width,
+                });
+        self
+    }
+}
+
+impl App {
+    pub(crate) fn toggle_global_pane(&mut self) {
+        if self.state.global_pane_visible() {
+            self.state.global_pane.visible = false;
+            self.state.mode = if self.state.active.is_some() {
+                Mode::Terminal
+            } else {
+                Mode::Navigate
+            };
+        } else {
+            if self.state.internal_workspace_idx().is_none() {
+                if let Err(err) = self.create_internal_workspace() {
+                    tracing::warn!("failed to create global pane workspace: {err}");
+                    return;
+                }
+            }
+            self.state.global_pane.visible = true;
+            self.state.global_pane.focus_global = true;
+            self.state.mode = Mode::Terminal;
+        }
+        self.render_dirty.request_generic();
+        self.render_notify.notify_one();
+    }
+
+    pub(crate) fn focus_global_pane(&mut self) {
+        if !self.state.global_pane_visible() {
+            self.toggle_global_pane();
+            return;
+        }
+        if self.state.global_focus_active() && self.state.active.is_none() {
+            return;
+        }
+        self.state.global_pane.focus_global = !self.state.global_pane.focus_global;
+        self.state.mode = Mode::Terminal;
+        self.render_dirty.request_generic();
+        self.render_notify.notify_one();
+    }
+
+    pub(crate) fn resize_global_pane(&mut self, width: u16) {
+        if self.state.global_pane.width == Some(width) {
+            return;
+        }
+        self.state.global_pane.width = Some(width);
+        self.state.mark_session_dirty();
+        self.render_dirty.request_generic();
+        self.render_notify.notify_one();
+    }
+
+    pub(crate) fn set_global_focus_for_pane(&mut self, pane_id: PaneId) -> Option<bool> {
+        if !self.state.global_pane_visible() {
+            return None;
+        }
+        let docked = self.state.global_pane_claims_pane(pane_id) == Some(true);
+        if self.state.global_pane.focus_global == docked {
+            return Some(docked);
+        }
+        self.state.global_pane.focus_global = docked;
+        self.state.mode = Mode::Terminal;
+        self.render_dirty.request_generic();
+        self.render_notify.notify_one();
+        Some(docked)
+    }
+
+    fn create_internal_workspace(&mut self) -> std::io::Result<()> {
+        let config = self.state.global_pane.config.clone();
+        let cwd = if config.cwd.is_empty() {
+            std::env::current_dir().unwrap_or_else(|_| "/".into())
+        } else {
+            crate::worktree::expand_tilde_absolute_path(&config.cwd)
+        };
+        let previous_active = self.state.active;
+        let previous_selected = self.state.selected;
+        let ws_idx = self.create_workspace_with_options(cwd, false)?;
+        if let Some(ws) = self.state.workspaces.get_mut(ws_idx) {
+            ws.custom_name = Some(INTERNAL_WORKSPACE_NAME.to_string());
+            self.state.global_pane.workspace_id = Some(ws.id.clone());
+        }
+        if previous_active.is_none() {
+            self.state.active = None;
+            self.state.selected = previous_selected;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn test_app() -> App {
+        let (_api_tx, api_rx) = tokio::sync::mpsc::unbounded_channel();
+        App::new(
+            &crate::config::Config::default(),
+            crate::app::AppPolicy::TEST,
+            None,
+            api_rx,
+            crate::api::EventHub::default(),
+        )
+    }
+
+    fn push_workspace(app: &mut App, name: &str) -> String {
+        let ws = crate::workspace::Workspace::test_new(name);
+        let id = ws.id.clone();
+        app.state.workspaces.push(ws);
+        id
+    }
+
+    fn push_internal_workspace(app: &mut App, name: &str) -> String {
+        let id = push_workspace(app, name);
+        app.state.global_pane.workspace_id = Some(id.clone());
+        id
+    }
+
+    #[test]
+    fn toggle_adopts_existing_internal_workspace() {
+        let mut app = test_app();
+        push_workspace(&mut app, "user");
+        push_internal_workspace(&mut app, "global");
+        app.state.active = Some(0);
+        app.state.selected = 0;
+
+        app.toggle_global_pane();
+        assert_eq!(app.state.workspaces.len(), 2);
+        assert!(app.state.global_pane_visible());
+        assert!(app.state.global_focus_active());
+
+        app.toggle_global_pane();
+        assert!(!app.state.global_pane_visible());
+        assert_eq!(app.state.active, Some(0));
+        assert_eq!(app.state.workspaces.len(), 2);
+    }
+
+    #[test]
+    fn focus_global_pane_flips_between_halves() {
+        let mut app = test_app();
+        push_workspace(&mut app, "user");
+        push_internal_workspace(&mut app, "global");
+        app.state.active = Some(0);
+        app.state.selected = 0;
+
+        app.focus_global_pane();
+        assert!(app.state.global_focus_active());
+        app.focus_global_pane();
+        assert!(app.state.global_pane_visible());
+        assert!(!app.state.global_focus_active());
+    }
+
+    #[test]
+    fn pane_focus_moves_between_dock_and_workspace() {
+        let mut app = test_app();
+        push_workspace(&mut app, "user");
+        push_internal_workspace(&mut app, "global");
+        app.state.active = Some(0);
+        app.state.selected = 0;
+        let user_pane = app.state.workspaces[0].tabs[0].root_pane;
+        let dock_pane = app.state.workspaces[1].tabs[0].root_pane;
+
+        assert_eq!(app.set_global_focus_for_pane(dock_pane), None);
+        app.toggle_global_pane();
+        assert_eq!(app.set_global_focus_for_pane(user_pane), Some(false));
+        assert!(!app.state.global_focus_active());
+        assert_eq!(app.set_global_focus_for_pane(dock_pane), Some(true));
+        assert!(app.state.global_focus_active());
+    }
+
+    #[test]
+    fn resize_sets_width_and_marks_session_dirty() {
+        let mut app = test_app();
+        push_workspace(&mut app, "user");
+        push_internal_workspace(&mut app, "global");
+        app.state.session_dirty = false;
+
+        app.resize_global_pane(44);
+        assert_eq!(app.state.global_pane.width, Some(44));
+        assert!(app.state.session_dirty);
+    }
+
+    #[test]
+    fn internal_workspace_is_never_switched_to() {
+        let mut app = test_app();
+        push_workspace(&mut app, "user");
+        push_internal_workspace(&mut app, "global");
+        app.state.active = Some(0);
+        app.state.selected = 0;
+
+        app.state.switch_workspace(1);
+        assert_eq!(app.state.active, Some(0));
+        assert!(!app.state.switch_workspace_tab(1, 0));
+    }
+
+    #[test]
+    fn sanitize_restored_selection_avoids_internal_workspace() {
+        let user = crate::workspace::Workspace::test_new("user");
+        let global = crate::workspace::Workspace::test_new("global");
+        let internal_id = global.id.clone();
+        let workspaces = [global, user];
+
+        let (active, selected) =
+            sanitize_restored_selection(&workspaces, Some(&internal_id), Some(0), 0);
+        assert_eq!(active, Some(1));
+        assert_eq!(selected, 1);
+
+        let (active, selected) = sanitize_restored_selection(&workspaces, None, Some(5), 9);
+        assert_eq!(active, Some(0));
+        assert_eq!(selected, 1);
+    }
+
+    #[test]
+    fn snapshot_round_trip_and_legacy_adoption() {
+        let mut app = test_app();
+        push_workspace(&mut app, "user");
+        let internal_id = push_internal_workspace(&mut app, "global");
+        app.state.global_pane.width = Some(44);
+
+        let snapshot = crate::persist::capture(
+            &app.state.workspaces,
+            &app.state.terminals,
+            &app.terminal_runtimes,
+            Some(0),
+            0,
+        )
+        .with_global_pane(&app.state);
+        let gp = snapshot
+            .global_pane
+            .as_ref()
+            .expect("global pane persisted");
+        assert_eq!(gp.workspace_id, internal_id);
+        assert_eq!(gp.width, Some(44));
+
+        let mut restored = test_app();
+        push_workspace(&mut restored, "user");
+        let mut global = crate::workspace::Workspace::test_new("restored-global");
+        global.id = internal_id.clone();
+        global.custom_name = Some("global".to_string());
+        restored.state.workspaces.push(global);
+        restore_session_fields(&mut restored.state, &snapshot);
+        assert_eq!(
+            restored.state.global_pane.workspace_id.as_deref(),
+            Some(internal_id.as_str())
+        );
+        assert_eq!(restored.state.global_pane.width, Some(44));
+        assert_eq!(restored.state.active, Some(0));
+
+        let mut legacy = snapshot;
+        legacy.global_pane = None;
+        let mut adopted = test_app();
+        push_workspace(&mut adopted, "user");
+        let mut global = crate::workspace::Workspace::test_new("old-global");
+        global.custom_name = Some("global".to_string());
+        let adopted_id = global.id.clone();
+        adopted.state.workspaces.push(global);
+        restore_session_fields(&mut adopted.state, &legacy);
+        assert_eq!(
+            adopted.state.global_pane.workspace_id.as_deref(),
+            Some(adopted_id.as_str())
+        );
+    }
+}
