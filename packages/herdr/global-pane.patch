+//! Layout for the session-global pane dock.
+
+use ratatui::layout::Rect;
+
+use crate::app::AppState;
+use crate::config::GlobalPanePosition;
+use crate::terminal::TerminalRuntimeRegistry;
+
+pub(crate) const MIN_WIDTH: u16 = 20;
+pub(crate) const MIN_MAIN_WIDTH: u16 = 40;
+
+/// Frame-level dock into the sidebar's slot: (global rect, remaining area).
+/// `None` when the frame is too narrow to share.
+pub(crate) fn layout(app: &AppState, area: Rect) -> Option<(Rect, Rect)> {
+    if area.width < MIN_WIDTH + MIN_MAIN_WIDTH {
+        return None;
+    }
+    let width = app
+        .global_pane
+        .width
+        .or_else(|| {
+            app.global_pane
+                .config
+                .size
+                .map(|size| size.resolve(area.width))
+        })
+        .unwrap_or(area.width / 3)
+        .clamp(MIN_WIDTH, area.width - MIN_MAIN_WIDTH);
+    let rest = area.width - width;
+    Some(match app.global_pane.config.position {
+        GlobalPanePosition::Left => (
+            Rect::new(area.x, area.y, width, area.height),
+            Rect::new(area.x + width, area.y, rest, area.height),
+        ),
+        GlobalPanePosition::Right => (
+            Rect::new(area.x + rest, area.y, width, area.height),
+            Rect::new(area.x, area.y, rest, area.height),
+        ),
+    })
+}
+
+/// Terminal cells inside the dock: the inner-edge column is the separator.
+pub(crate) fn inner(app: &AppState, outer: Rect) -> Option<Rect> {
+    if outer.width < 2 || outer.height == 0 {
+        return None;
+    }
+    Some(match app.global_pane.config.position {
+        GlobalPanePosition::Left => Rect::new(outer.x, outer.y, outer.width - 1, outer.height),
+        GlobalPanePosition::Right => Rect::new(outer.x + 1, outer.y, outer.width - 1, outer.height),
+    })
+}
+
+pub(crate) fn separator_x(app: &AppState, outer: Rect) -> u16 {
+    match app.global_pane.config.position {
+        GlobalPanePosition::Left => outer.x + outer.width.saturating_sub(1),
+        GlobalPanePosition::Right => outer.x,
+    }
+}
+
+/// Sized even while hidden so toggling on needs no reflow.
+pub(crate) fn resize(
+    app: &AppState,
+    terminal_runtimes: &TerminalRuntimeRegistry,
+    area: Rect,
+    cell_size: crate::kitty_graphics::HostCellSize,
+) {
+    let Some((ws_idx, pane_id, terminal_id)) = app.global_pane_target() else {
+        return;
+    };
+    let Some((outer, _rest)) = layout(app, area) else {
+        return;
+    };
+    let Some(inner) = inner(app, outer) else {
+        return;
+    };
+    if app.direct_attach_resize_locks.contains(&terminal_id) {
+        return;
+    }
+    if let Some(rt) = app.runtime_for_pane_in_workspace(terminal_runtimes, ws_idx, pane_id) {
+        rt.resize(
+            inner.height,
+            inner.width,
+            cell_size.width_px,
+            cell_size.height_px,
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn layout_docks_left_by_default() {
+        let app = AppState::test_new();
+        let area = Rect::new(0, 0, 120, 40);
+        let (global, rest) = layout(&app, area).expect("layout");
+        assert_eq!(global, Rect::new(0, 0, 40, 40));
+        assert_eq!(rest, Rect::new(40, 0, 80, 40));
+        let inner = inner(&app, global).expect("inner");
+        assert_eq!(inner, Rect::new(0, 0, 39, 40));
+        assert_eq!(separator_x(&app, global), 39);
+    }
+
+    #[test]
+    fn layout_docks_right_with_dragged_width() {
+        let mut app = AppState::test_new();
+        app.global_pane.config.position = GlobalPanePosition::Right;
+        app.global_pane.width = Some(25);
+        let area = Rect::new(0, 0, 120, 40);
+        let (global, rest) = layout(&app, area).expect("layout");
+        assert_eq!(global, Rect::new(95, 0, 25, 40));
+        assert_eq!(rest, Rect::new(0, 0, 95, 40));
+        let inner = inner(&app, global).expect("inner");
+        assert_eq!(inner, Rect::new(96, 0, 24, 40));
+        assert_eq!(separator_x(&app, global), 95);
+    }
+
+    #[test]
+    fn layout_clamps_and_bails_when_narrow() {
+        let mut app = AppState::test_new();
+        app.global_pane.width = Some(500);
+        let area = Rect::new(0, 0, 100, 40);
+        let (global, _) = layout(&app, area).expect("layout");
+        assert_eq!(global.width, 100 - MIN_MAIN_WIDTH);
+
+        app.global_pane.width = Some(1);
+        let (global, _) = layout(&app, area).expect("layout");
+        assert_eq!(global.width, MIN_WIDTH);
+
+        let narrow = Rect::new(0, 0, MIN_WIDTH + MIN_MAIN_WIDTH - 1, 40);
+        assert!(layout(&app, narrow).is_none());
+    }
+}
