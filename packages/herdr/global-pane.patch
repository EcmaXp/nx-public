+pub(crate) struct DockGeometry {
+    pub(crate) workspace_index: usize,
+    pub(crate) pane_id: crate::layout::PaneId,
+    pub(crate) terminal_id: crate::terminal::TerminalId,
+    pub(crate) outer: Rect,
+    pub(crate) inner: Rect,
+    pub(crate) separator_x: u16,
+    pub(crate) tab_area: Rect,
+}
+
+pub(crate) fn dock_geometry(app: &app::App, area: Rect) -> Option<DockGeometry> {
+    if !app.state.global_pane_visible() {
+        return None;
+    }
+    let (workspace_index, pane_id, terminal_id) = app.state.global_pane_target()?;
+    let (outer, tab_area) = crate::ui::global_pane::layout(&app.state, area)?;
+    let inner = crate::ui::global_pane::inner(&app.state, outer)?;
+    Some(DockGeometry {
+        workspace_index,
+        pane_id,
+        terminal_id,
+        outer,
+        inner,
+        separator_x: crate::ui::global_pane::separator_x(&app.state, outer),
+        tab_area,
+    })
+}
